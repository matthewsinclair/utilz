#!/usr/bin/env bash
#
# post-cut -- everything after a Utilz cut, in order, stopping at the first
# failure: the Menuz.app the cut's macos leg signed and notarised at the
# release commit attached at the tag, then the formula published to the tap,
# then this machine's clone of the tap pulled (ST0030, ST0031/04;
# docs/releasing.md).
#
#   tools/post-cut [<tag>]   <tag> defaults to the top-level VERSION at HEAD
#
# It is the release core's one `after:` line (bin/.devbin/config.yaml), so
# `bin/devbin release --patch --yes` runs from cut to tap with nobody at the
# terminal. ONE LINE, NOT SEVERAL: the core runs every after: line even when one
# before it failed, and a formula pushed before Menuz.app.zip is attached gives
# every new install a `menuz install` that fails until the asset arrives.
#
# A RE-RUN STARTS FROM THE TOP AND SKIPS WHAT IS DONE. The core's after step has
# no postcondition, so a resumed cut runs this again. A release whose
# Menuz.app.zip and SHA256SUMS are both uploaded skips the publish here, since
# `macos publish` would only find the asset there (issue 0118: one with the
# same bytes counts as attached, one with other bytes is refused), and
# `tools/formula publish` leaves a tap that already carries the release as it
# is.
#
# NOTHING IS BUILT OR SIGNED HERE. The cut's macos leg signs and notarises the
# app at the release commit, in this checkout's stage, and `macos publish`
# attaches that copy from the primary. It reads the tag's commit, never HEAD,
# and refuses a staged copy signed at any other commit, or one whose
# MenuzCommit is not the tag's (issue 0103), so a node's board commit that
# moves the primary past the tag cannot make it ship another build. It attaches
# to the release this tree's version names, so that must be the tag. A stage
# that is gone, or another commit's, gets publish's own remedy: sign again in a
# tree at the tag and publish from there, since the stage is one per checkout,
# then run this again, which finds the asset uploaded and skips the publish.
#
# It lives in tools/, not bin/, because bin/ is published.
#
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
REPO="matthewsinclair/utilz"
ASSET="Menuz.app.zip"
TAP="matthewsinclair/utilz"

die() {
  printf 'post-cut: %s\n' "$*" >&2
  exit 1
}

say() {
  printf 'post-cut: %s\n' "$*"
}

usage() {
  cat <<EOF
usage: tools/post-cut [<tag>]

  Attach the Menuz.app the cut signed at <tag>, then publish the formula to
  the tap and pull this machine's clone of it, stopping at the first failure.
  <tag> defaults to the top-level VERSION at HEAD, and must be the newest
  release. A re-run skips what is done.
EOF
}

case "${1:-}" in
  -h | --help)
    usage
    exit 0
    ;;
esac
[[ $# -le 1 ]] || { usage >&2; exit 2; }
[[ "$(uname -s)" == "Darwin" ]] || {
  printf 'post-cut: Menuz.app is published from the stage the cut signed, on macOS only; this is %s\n' "$(uname -s)" >&2
  exit 2
}

cd "$root"
tag="${1:-$(git show HEAD:VERSION)}" || die "cannot read VERSION at HEAD"
tag="${tag%$'\n'}"
[[ "$(git cat-file -t "refs/tags/$tag" 2>/dev/null)" == "tag" ]] ||
  die "'$tag' is not an annotated tag in $root, so it is not a release"
commit="$(git rev-parse --verify "$tag^{commit}")" || die "cannot read the commit '$tag' names"
# tools/formula publish publishes the newest release, whatever it is asked, so
# an older tag here would attach one release's app, publish another's formula.
newest="$(git tag --list | grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' | sort -t. -k1,1n -k2,2n -k3,3n | tail -1)" ||
  die "cannot read which tags in $root name a release"
[[ "$tag" == "$newest" ]] ||
  die "'$tag' is not the newest release ($newest), and the formula step publishes the newest"

# The asset names GitHub lists in the state uploaded, the state devbin reads
# (release_object_assets in bin/.devbin/lib/release.steps). devbin's attach
# writes SHA256SUMS last, so an attach that stopped part way leaves Menuz.app.zip
# or SHA256SUMS absent or not uploaded, and the publish is not skipped. That
# holds while this attach is the first to write SHA256SUMS on the release: a
# declared macos.binaries has the cut's bin-publish write one earlier, so read
# this check again then. Whether SHA256SUMS names the zip at its digest is not
# read here.
assets="$(gh release view "$tag" -R "$REPO" --json assets --jq '.assets[] | select(.state == "uploaded") | .name')" ||
  die "GitHub has no release object for $tag, or it cannot be read; nothing was done"

say "utilz $tag at ${commit:0:12}"
if printf '%s\n' "$assets" | grep -qxF "$ASSET" && printf '%s\n' "$assets" | grep -qxF SHA256SUMS; then
  say "the release already carries $ASSET and SHA256SUMS, uploaded, so the publish is skipped"
else
  # The copy the cut's macos leg signed at the release commit, in this
  # checkout's stage: publish refuses one signed at any other commit. It
  # attaches to the release this tree's version names, which devbin's own
  # reader prints (bin/devbin version show), so that must be $tag.
  version="$(bin/devbin version show)" || die "bin/devbin version show could not read this tree's version; nothing was published"
  [[ "$version" == "$tag" ]] ||
    die "this tree's version is $version, and macos publish attaches to the release it names, not $tag; run this from a tree whose version is $tag"
  say "macos publish"
  bin/devbin macos publish ||
    die "macos publish failed at $tag, so the formula is not published. Fix what it names (a copy it has you sign again in a tree at the tag is published from that tree), then run tools/post-cut $tag"
fi

say "formula publish"
tools/formula publish ||
  die "formula publish failed; $ASSET is attached. Fix the cause and run tools/post-cut $tag"

# THIS MACHINE'S CLONE OF THE TAP, pulled so `brew upgrade utilz` sees the
# release: brew's own auto-update refreshes its API data and can leave a
# third-party tap behind, as it left 2.14.4 after 2.14.5's publish. The
# upgrade itself is hv's.
if ! command -v brew >/dev/null 2>&1; then
  say "no brew on PATH, so no tap clone to pull"
else
  tapdir="$(brew --repository)/Library/Taps/${TAP%%/*}/homebrew-${TAP#*/}" ||
    die "cannot read brew's repository; $ASSET is attached and the tap published"
  if [[ ! -d "$tapdir/.git" ]]; then
    say "no clone of the tap at $tapdir, so nothing to pull"
  else
    git -C "$tapdir" pull -q --ff-only ||
      die "cannot pull $tapdir; $ASSET is attached and the tap published. Pull it by hand before brew upgrade"
    say "this machine's tap: $(git -C "$tapdir" log -1 --format=%s)"
  fi
fi
say "utilz $tag: $ASSET attached and the tap published"

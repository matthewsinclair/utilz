#!/usr/bin/env bash
#
# test-estate [<utility>...] -- every suite, run under the bash macOS ships
# (issue 0051). It is the release core's `test estate` gate:
# commands.test.options.estate.run in bin/.devbin/config.yaml names it.
#
# WHY IT EXISTS. Utilz targets bash 3.2 because that is what macOS ships, and
# CI's macOS legs were the only thing that ran the suite under it. hv's fleet
# CI ruling of 2026-09-21, confirmed here on 2026-09-22, moves those legs to
# release tags and manual runs, so without this the last gate before a tag runs
# every test under Homebrew's bash 5, and a 3.2 regression is first seen by the
# tag's own CI -- after the core has pushed the tag the Homebrew formula names.
#
# WHY A WRAPPER RATHER THAN A PREFIX IN THE CONFIG. devbin splits a declared
# `run:` into words and execs it without a shell (its lib/helpers, run_words),
# so `PATH=... bin/utilz test` there would be read as a command named `PATH=...`.
# And the prefix cannot go on the cut as a whole: devbin's own floor is bash 5
# and it refuses 3.2, so the narrowest place that works is this one command.
#
# WHY PATH RATHER THAN /bin/bash. `bin/utilz` is not the only thing that must
# be 3.2: bats is `#!/usr/bin/env bash` and so is every suite it runs, so
# `/bin/bash bin/utilz test` is 3.2 for the dispatcher ALONE (intent/restart.md,
# the traps). Putting /bin first makes every `env bash` in the tree resolve to
# 3.2.57, and Homebrew stays behind it on the path, so git, yq and gh still
# resolve.
#
# IT LIVES IN tools/, NOT bin/, BECAUSE bin/ IS PUBLISHED, the same reason
# ci-state does: a release tool under bin/ would ship to every install.
#
set -euo pipefail

UTILZ_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# THE PATH IS A MEANS; THE VERSION IS THE POINT (issue 0058). Putting /bin
# first only runs the suite under 3.2 on a machine where /bin/bash IS 3.2.
# Everywhere else -- a Linux box, or a Mac where someone has replaced it --
# this wrapper forced a PATH and proved nothing, and the gate reported green
# having tested the same bash the plain run tests. A gate that cannot fail
# for the reason it exists is the silent-pass shape the estate suite is full
# of refusals about; so the version is READ, and a bash that is not 3.2 is
# refused BY NAME rather than run anyway.
#
# Refuse rather than warn: the caller is the release core's `test estate`
# gate, whose whole job is to be the last thing that can stop a tag.
_estate_bash="/bin/bash"
if [ ! -x "$_estate_bash" ]; then
  printf 'test-estate: %s is not executable, so the suite cannot be run under the bash macOS ships\n' "$_estate_bash" >&2
  exit 2
fi
# THE SINGLE QUOTES ARE THE POINT, so the disable is scoped to this line and
# carries its reason. BASH_VERSINFO must be expanded by the CHILD -- the
# /bin/bash being interrogated -- and not by the shell running this script.
# Double quotes would expand it HERE, so the check would report the version of
# whatever bash ran test-estate and pass on every machine: the exact defect
# this guard was added to close (issue 0058), rebuilt one line lower down.
# shellcheck disable=SC2016
_estate_version="$("$_estate_bash" -c 'printf %s "${BASH_VERSINFO[0]}.${BASH_VERSINFO[1]}"' 2>/dev/null)" || _estate_version=""
if [ -z "$_estate_version" ]; then
  printf 'test-estate: could not read a version from %s, so this gate cannot say what it tested\n' "$_estate_bash" >&2
  exit 2
fi
if [ "$_estate_version" != "3.2" ]; then
  printf 'test-estate: %s is bash %s, not 3.2 -- this gate exists to run the suite under the bash macOS ships,\n' "$_estate_bash" "$_estate_version" >&2
  printf '             and on this machine it would prove nothing. Run the suite on a macOS host, or fix %s.\n' "$_estate_bash" >&2
  exit 2
fi

exec env PATH="/bin:$PATH" "$UTILZ_HOME/bin/utilz" test "$@"

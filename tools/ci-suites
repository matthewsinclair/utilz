#!/usr/bin/env bash
#
# ci-suites: every utility's suite, as CI's two test jobs run them
# (ST0031/02): `utilz test` for the dispatcher, then for each utility the tree
# installs, with prez's BATS suite alone, stopping at the first that fails.
#
# ONE ROSTER, AND IT IS each_utility'S. test-linux carried its own list of
# utilities, which every new utility had to be added to by hand or go untested
# on that leg with nothing reporting the gap, while test-macos derived its
# roster from `utilz list`, a listing written for people. Both jobs now run
# this, which iterates each_utility (opt/utilz/lib/common.sh), the one walker
# of bin/ that `utilz test` itself iterates, so a utility is covered on both
# legs the day it lands, and the roster has one home.
#
# prez'S BATS SUITE RUNS HERE, AND ITS CRATE'S SUITES IN THE rust JOB (issue
# Ibf2b53b). `utilz test prez` drives the release build, cargo test, BATS and
# the crate's black-box suites, which always pass --strict. Those suites need
# what only the rust job installs: node 26, ffmpeg, poppler and, on Linux, a
# display. So the rust job builds the crate and runs its tests and suites.
# opt/prez/test/prez.bats builds nothing, and needs yq, bats and a green
# doctor, which these two jobs have. It runs here through _run_bats_suite, the
# one function that runs a utility's BATS. No binary is built here, so its one
# arm that reads the compiled version skips.
#
# The tree's own dispatcher and lib, never PATH's: on a desk a plain `utilz`
# can be a Homebrew install.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
utilz="$root/bin/utilz"
# shellcheck source=opt/utilz/lib/common.sh
. "$root/opt/utilz/lib/common.sh"

# Read whole first, with its own status, so a walk that fails stops the run
# here, and one that names nothing is refused by name rather than run as a
# roster of the dispatcher alone.
names="$(each_utility "$root")"
if [ -z "$names" ]; then
  echo "ci-suites: $root/bin holds no utility, so there is nothing to test" >&2
  exit 1
fi
utilities=(utilz)
while IFS= read -r name; do
  utilities+=("$name")
done <<<"$names"

for utility in "${utilities[@]}"; do
  if [ "$utility" = prez ]; then
    echo "== prez: its BATS suite alone; the rust job runs its crate, as the header says =="
    _run_bats_suite prez "$root/opt/prez/test"
    continue
  fi
  echo "== $utility =="
  "$utilz" test "$utility"
done

#!/usr/bin/env bash
#
# devbin: summary = menuz's macOS app: rasterise its icon; sign, notarise and publish Menuz.app with the Developer ID
# devbin: args = <subcommand>
# bin/devbin macos <subcommand>  -- run `bin/devbin macos` with no arguments for the list.
#
# Utilz's own command, not devbin's: cmd/ belongs to the project, so nothing
# here is in the vendored manifest. PORTED FROM INTENT'S
# `bin/.devbin/cmd/macos`: its cmd_app_icons and the toolchain lines of its
# cmd_app_doctor (ST0027 WP-06, AC-06.3), so menuz's icon comes from the same
# rasteriser as Intent's; and its app half, store-creds, app-sign,
# app-notarize and app-verify, with a publish of menuz's own (WP-05, D12), so
# Menuz.app is signed and notarised on the maintainer's machine as Intent.app
# is, and attached to the release the release core made.
#
# CREDENTIALS LIVE IN THE LOGIN KEYCHAIN AND NOWHERE ELSE: no key material in
# this repository, in CI config, or in any file this writes, and nothing here
# prints a value. They are read only by the subcommands that need them, never
# at load, so app-icons touches no keychain. doctor reports each as PRESENT or
# MISSING, and the signing identity by count and team, never whole.
#
# Two sources, where Intent has one: menuz.svg is the app icon (the mark on
# macOS's rounded square), and menuz-mark.svg is its silhouette, black on
# transparent, for the menu bar's template image. The PNGs and Contents.json
# files are tracked, so a build and CI need no rsvg-convert; this is run when
# a source changes.
#
set -euo pipefail
: "${DEVBIN_LIB:?run me through the devbin dispatcher}"
# shellcheck source=SCRIPTDIR/../lib/helpers
. "$DEVBIN_LIB/helpers"

ROOT="${PROJECT_ROOT:?}"
APP_DIR="$ROOT/native/macos/Menuz"
APP_ASSETS="$APP_DIR/Menuz/Assets.xcassets"
ICON_SVG="$APP_DIR/design/menuz.svg"
MARK_SVG="$APP_DIR/design/menuz-mark.svg"

# The signing half's places. The build is `utilz menuz build --release`'s, under
# XDG state (D6); the subject of signing is a staged copy in APP_DIST_DIR, never
# the build product, which any build on this machine can replace mid-
# notarisation.
KC_PREFIX="utilz.apple"
APP_BUNDLE_ID="com.matthewsinclair.utilz.menuz"
APP_ENTITLEMENTS="$APP_DIR/Menuz/Menuz.entitlements"
APP_STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/menuz/build/macos"
APP_DIST_DIR="$APP_STATE_DIR/dist"
APP_ASSET="Menuz.app.zip"

# One PNG of <svg> at <px> square. A non-zero rsvg-convert, or one that wrote
# nothing, stops the run naming the size and the source.
app_png() { # $1 svg, $2 px, $3 out
  rsvg-convert -w "$2" -h "$2" "$1" -o "$3" || die "rsvg-convert failed at ${2}px for ${1#"$ROOT"/}"
  [ -s "$3" ] || die "rsvg-convert wrote nothing at ${2}px for ${1#"$ROOT"/}"
}

app_appicon_contents() {
  cat <<'JSON'
{
  "images" : [
    { "idiom" : "mac", "scale" : "1x", "size" : "16x16", "filename" : "icon_16.png" },
    { "idiom" : "mac", "scale" : "2x", "size" : "16x16", "filename" : "icon_32.png" },
    { "idiom" : "mac", "scale" : "1x", "size" : "32x32", "filename" : "icon_32.png" },
    { "idiom" : "mac", "scale" : "2x", "size" : "32x32", "filename" : "icon_64.png" },
    { "idiom" : "mac", "scale" : "1x", "size" : "128x128", "filename" : "icon_128.png" },
    { "idiom" : "mac", "scale" : "2x", "size" : "128x128", "filename" : "icon_256.png" },
    { "idiom" : "mac", "scale" : "1x", "size" : "256x256", "filename" : "icon_256.png" },
    { "idiom" : "mac", "scale" : "2x", "size" : "256x256", "filename" : "icon_512.png" },
    { "idiom" : "mac", "scale" : "1x", "size" : "512x512", "filename" : "icon_512.png" },
    { "idiom" : "mac", "scale" : "2x", "size" : "512x512", "filename" : "icon_1024.png" }
  ],
  "info" : { "author" : "xcode", "version" : 1 }
}

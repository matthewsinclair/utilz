}

app_menubar_contents() {
  cat <<'JSON'
{
  "images" : [
    { "idiom" : "universal", "scale" : "1x", "filename" : "menubar_18.png" },
    { "idiom" : "universal", "scale" : "2x", "filename" : "menubar_36.png" },
    { "idiom" : "universal", "scale" : "3x", "filename" : "menubar_54.png" }
  ],
  "info" : { "author" : "xcode", "version" : 1 },
  "properties" : { "template-rendering-intent" : "template" }
}
JSON
}

# Every precondition is checked before anything is written, so a refusal
# leaves the catalogue as it was.
cmd_app_icons() {
  command -v rsvg-convert >/dev/null 2>&1 || die "rsvg-convert not found (brew install librsvg)"
  local svg
  for svg in "$ICON_SVG" "$MARK_SVG"; do
    [ -f "$svg" ] || die "no SVG at ${svg#"$ROOT"/}"
  done
  local appset="$APP_ASSETS/AppIcon.appiconset" barset="$APP_ASSETS/MenuBarIcon.imageset" px
  printf -- '-> rasterising %s and %s\n' "${ICON_SVG#"$ROOT"/}" "${MARK_SVG#"$ROOT"/}"
  mkdir -p "$appset" "$barset"
  printf '{\n  "info" : { "author" : "xcode", "version" : 1 }\n}\n' >"$APP_ASSETS/Contents.json"
  for px in 16 32 64 128 256 512 1024; do app_png "$ICON_SVG" "$px" "$appset/icon_$px.png"; done
  app_appicon_contents >"$appset/Contents.json"
  for px in 18 36 54; do app_png "$MARK_SVG" "$px" "$barset/menubar_$px.png"; done
  app_menubar_contents >"$barset/Contents.json"
  printf 'wrote AppIcon (7 sizes) + MenuBarIcon (template, 3 scales) to %s\n' "${APP_ASSETS#"$ROOT"/}"
}

# What app-icons and the signing half need, and whether the catalogue is
# there. Exit 1 when the toolchain, a source, the identity or a credential is
# missing, or the identity cannot sign; an absent catalogue is reported with
# the command that makes it.
cmd_doctor() {
  local ok=1 svg
  printf 'app project: %s\n' "${APP_DIR#"$ROOT"/}"
  printf '\ntoolchain:\n'
  if command -v rsvg-convert >/dev/null 2>&1; then
    printf '  %-14s %s\n' rsvg-convert "$(command -v rsvg-convert)"
  else
    printf '  %-14s MISSING (brew install librsvg)\n' rsvg-convert
    ok=0
  fi
  printf '\nsources:\n'
  for svg in "$ICON_SVG" "$MARK_SVG"; do
    if [ -f "$svg" ]; then
      printf '  %-14s present\n' "$(basename "$svg")"
    else
      printf '  %-14s MISSING (%s)\n' "$(basename "$svg")" "${svg#"$ROOT"/}"
      ok=0
    fi
  done
  printf '\nassets:\n'
  local set
  for set in AppIcon.appiconset MenuBarIcon.imageset; do
    if [ -f "$APP_ASSETS/$set/Contents.json" ]; then
      printf '  %-21s present\n' "$set"
    else
      printf '  %-21s absent (run: %s macos app-icons)\n' "$set" "$DEVBIN_INVOKE"
    fi
  done
  load_creds
  printf '\nsigning:\n'
  if [ -n "$IDENTITY" ]; then
    printf '  %-21s %s found, team %s\n' "Developer ID" "$IDENTITY_COUNT" "$(identity_team)"
    # A real test-sign: an identity can be listed and still not sign (expired,
    # revoked, its private key gone), and a release is too late to learn it.
    local tmp
    tmp="$(mktemp -d)"
    cp /bin/echo "$tmp/probe" 2>/dev/null || true
    if [ -f "$tmp/probe" ] &&
      codesign --force --options runtime --timestamp --sign "$IDENTITY" "$tmp/probe" >/dev/null 2>&1 &&
      codesign --verify --strict "$tmp/probe" >/dev/null 2>&1; then
      printf '  %-21s signs and verifies\n' "test-sign"
    else
      printf '  %-21s FAILED (the identity is listed and cannot make a valid signature)\n' "test-sign"
      ok=0
    fi
    rm -rf "$tmp"
  else
    printf '  %-21s MISSING (no "Developer ID Application" identity in the login keychain)\n' "Developer ID"
    ok=0
  fi
  printf '\nnotary credentials (values are never printed):\n'
  local k v
  for k in APPLE_ID APPLE_APP_PASSWORD APPLE_TEAM_ID; do
    v="${!k}"
    if [ -n "$v" ]; then
      printf '  %-21s PRESENT\n' "$k"
    else
      printf '  %-21s MISSING (run: %s macos store-creds)\n' "$k" "$DEVBIN_INVOKE"
      ok=0
    fi
  done
  [ "$ok" = 1 ] || die "incomplete -- see MISSING above"
}

# --- the signing half (WP-05, D12) ---------------------------------------------

# Read from the login keychain, never from the environment or a file. Silent
# on a miss; the callers report presence. `|| true` so a host with no
# `security` (Linux) reads every one as missing rather than dying unreported.
kc_get() { security find-generic-password -a "${USER:-$(id -un)}" -s "$KC_PREFIX.$1" -w 2>/dev/null || true; }

# The credentials and the identity, read once, by the subcommands that need
# them. The identity is FOUND in the keychain, never composed: the
# "Developer ID Application" identity whose team is the stored team id, else
# the first one when no team id is stored yet (signing needs no notary
# credentials). IDENTITY_COUNT is how many Developer ID Application identities
# the keychain lists.
load_creds() {
  APPLE_ID="$(kc_get APPLE_ID)"
  APPLE_APP_PASSWORD="$(kc_get APPLE_APP_PASSWORD)"
  APPLE_TEAM_ID="$(kc_get APPLE_TEAM_ID)"
  local listed
  listed="$({ security find-identity -v -p codesigning 2>/dev/null || true; } |
    sed -n 's/.*"\(Developer ID Application: [^"]*\)".*/\1/p' | sort -u)"
  IDENTITY_COUNT="$(printf '%s' "$listed" | grep -c . || true)"
  if [ -n "$APPLE_TEAM_ID" ]; then
    IDENTITY="$(printf '%s\n' "$listed" | grep -F "($APPLE_TEAM_ID)" | head -1 || true)"
  else
    IDENTITY="$(printf '%s\n' "$listed" | head -1)"
  fi
}

# The team the identity names, from its trailing "(TEAMID)".
identity_team() {
  local t="${IDENTITY##*(}"
  printf '%s' "${t%)}"
}

require_identity() {
  [ -n "$IDENTITY" ] || die "no Developer ID Application identity in the login keychain${APPLE_TEAM_ID:+ for team $APPLE_TEAM_ID} -- run: $DEVBIN_INVOKE macos doctor"
}

require_creds() {
  # if/then, not `A && B || C`: CI's shellcheck reads that as SC2015.
  if [ -z "$APPLE_ID" ] || [ -z "$APPLE_APP_PASSWORD" ] || [ -z "$APPLE_TEAM_ID" ]; then
    die "notary credentials missing -- run: $DEVBIN_INVOKE macos store-creds (see: $DEVBIN_INVOKE macos doctor)"
  fi
}

app_product() { printf '%s' "$APP_STATE_DIR/Build/Products/$1/Menuz.app"; }
app_dist() { printf '%s' "$APP_DIST_DIR/Menuz.app"; }

# One key of a bundle's Info.plist, or empty when it cannot be read.
plist_get() { # $1 bundle, $2 key
  plutil -extract "$2" raw -o - "$1/Contents/Info.plist" 2>/dev/null || true
}

app_executable() { # $1 bundle
  local name
  name="$(plist_get "$1" CFBundleExecutable)"
  printf '%s' "$1/Contents/MacOS/${name:-$(basename "$1" .app)}"
}

# app_sign_nested <bundle> -- every Mach-O inside the bundle except its main
# executable, deepest path first, so a container is signed after what it
# holds; the main executable is sealed by the bundle signature, last. Menuz.app
# holds no nested code today, so this signs nothing and says so; it is here so
# the first framework or helper added is signed on the way through rather than
# found by notarisation refusing the bundle. Intent's walk, unchanged.
app_sign_nested() {
  local bundle="$1" main list f ftype signed=0
  local -a files=()
  main="$(app_executable "$bundle")"
  list="$(mktemp)"
  find "$bundle" -type f >"$list" || { rm -f "$list"; die "find failed enumerating $bundle"; }
  while IFS= read -r f; do files+=("$f"); done < <(awk -F/ '{ print NF "\t" $0 }' "$list" | sort -t "$(printf '\t')" -k1,1nr | cut -f2-)
  rm -f "$list"
  [ "${#files[@]}" -gt 0 ] || die "no files under $bundle -- refusing to sign an empty bundle"
  for f in "${files[@]}"; do
    [ "$f" = "$main" ] && continue
    # A classification error fails; it is never read as "not Mach-O" and
    # skipped, which would let unsigned code into a notarised bundle.
    ftype="$(file -b "$f")" || die "file(1) could not classify $f"
    case "$ftype" in
      *Mach-O*executable*)
        codesign --force --options runtime --timestamp --entitlements "$APP_ENTITLEMENTS" --sign "$IDENTITY" "$f"
        signed=$((signed + 1)) ;;
      *Mach-O*)
        codesign --force --options runtime --timestamp --sign "$IDENTITY" "$f"
        signed=$((signed + 1)) ;;
      *)
        if [ "$(dirname "$f")" = "$bundle/Contents/MacOS" ] && [ -x "$f" ]; then
          codesign --force --timestamp --sign "$IDENTITY" "$f"
          signed=$((signed + 1))
        fi ;;
    esac
  done
  printf '  %-21s %s\n' "nested code signed" "$signed"
}

# The build stamps a bundle carries, as menuz stamped them: its version and
# build, the commit it was built from, and its kind, release or dev.
app_stamps_readback() { # $1 bundle
  local version build commit kind
  version="$(plist_get "$1" CFBundleShortVersionString)"
  build="$(plist_get "$1" CFBundleVersion)"
  commit="$(plist_get "$1" MenuzCommit)"
  kind="$(plist_get "$1" MenuzKind)"
  printf '  %-21s %s (build %s)\n' "version" "${version:-<unreadable>}" "${build:-<unreadable>}"
  printf '  %-21s %s\n' "commit" "${commit:-<unreadable>}"
  printf '  %-21s %s\n' "kind" "${kind:-<unreadable>}"
}

# app_signature_readback <bundle> -- what the bytes say, not what was asked
# for: the identifier, the team and the hardened runtime read off the
# signature, and the build stamps off the Info.plist, so each step shows which
# build it has (issue 0103). A bundle still carrying the build's signature
# names itself otherwise, and is refused here.
app_signature_readback() {
  local bundle="$1" desc flags team ident want_team
  codesign --verify --strict --deep "$bundle" >/dev/null 2>&1 ||
    die "$bundle does not verify -- its signature is broken or incomplete"
  desc="$(codesign -d --verbose=2 "$bundle" 2>&1)" || true
  flags="$(printf '%s\n' "$desc" | sed -n 's/.*flags=\([^ ]*\).*/\1/p' | head -1)"
  team="$(printf '%s\n' "$desc" | sed -n 's/^TeamIdentifier=//p')"
  ident="$(printf '%s\n' "$desc" | sed -n 's/^Identifier=//p')"
  want_team="$(identity_team)"
  printf '  %-21s %s\n' "identifier" "${ident:-<unreadable>}"
  printf '  %-21s %s\n' "team" "${team:-<none>}"
  printf '  %-21s %s\n' "flags" "${flags:-<unreadable>}"
  app_stamps_readback "$bundle"
  [ "$ident" = "$APP_BUNDLE_ID" ] ||
    die "the bundle is signed as '${ident:-<none>}', not $APP_BUNDLE_ID -- it still carries the build's signature, not a Developer ID one"
  [ "$team" = "$want_team" ] ||
    die "the bundle's team is '${team:-<none>}', not $want_team -- it is not signed with the Developer ID identity"
  case "$flags" in
    *runtime*) ;;
    *) die "the hardened runtime is not set on the bundle (flags=${flags:-<unreadable>}) -- notarisation would refuse it" ;;
  esac
}

# app_verify_notarised <bundle> -- the ticket, checked the way a download
# meets it: a quarantined copy, the quarantine asserted before any verdict is
# read, and spctl's source. The app is not launched. 0 when it passes.
app_verify_notarised() {
  local bundle="$1" t verdict rc=0
  if xcrun stapler validate "$bundle" >/dev/null 2>&1; then
    printf '  %-21s %s\n' "stapled ticket" "present, validates"
  else
    printf '  %-21s %s\n' "stapled ticket" "NONE (run: $DEVBIN_INVOKE macos app-notarize)"
    rc=1
  fi
  t="$(mktemp -d)"
  ditto "$bundle" "$t/Menuz.app" || { rm -rf "$t"; die "could not copy $bundle to check it"; }
  xattr -w com.apple.quarantine "0083;0;utilz-verify;" "$t/Menuz.app" || true
  if ! xattr -p com.apple.quarantine "$t/Menuz.app" >/dev/null 2>&1; then
    printf '  %-21s SKIPPED (could not set the quarantine attribute; no verdict)\n' "Gatekeeper"
    rm -rf "$t"
    return 1
  fi
  # spctl exits non-zero on a rejection, which is the verdict being read.
  verdict="$(spctl -a -t exec -vv "$t/Menuz.app" 2>&1 | sed -n 's/^source=//p')" || true
  if [ "$verdict" = "Notarized Developer ID" ]; then
    printf '  %-21s quarantined copy accepted, source=%s\n' "Gatekeeper" "$verdict"
  else
    printf '  %-21s FAILED, source=%s (expected: Notarized Developer ID)\n' "Gatekeeper" "${verdict:-<none>}"
    rc=1
  fi
  rm -rf "$t"
  return $rc
}

# The release tag the tree's root VERSION names: bare, 2.14.0, as the release
# core tags it. That is this project's declaration in bin/.devbin/config.yaml
# (release.tag "{version}", version_from the default VERSION), not the core's
# own default, v{version}; macos.bats pins the declaration, for menuz's
# build_kind as well, so the readings cannot drift apart unseen (issue 0103).
app_release_tag() { tr -d '[:space:]' <"$ROOT/VERSION"; }

# The full commit release tag $1 names in this tree, peeled through the
# annotated tag the release core makes; non-zero, printing nothing, when the
# tree has no such tag.
app_tag_commit() { # $1 tag
  git -C "$ROOT" rev-parse --verify --quiet "refs/tags/$1^{commit}"
}

# The bundle against what release $2 ships, one reason per line; empty means
# it may ship. Its id and version, then the stamps that make it the tag's own
# build (issue 0103): MenuzKind release, which menuz stamps only at the tag
# from a clean tree, and a MenuzCommit the tag's commit begins with. A commit
# stamp that is not 8 to 40 lowercase hex characters is refused before any
# comparison, so a missing or garbled one never matches by prefix.
app_ship_blockers() { # $1 bundle, $2 the release tag
  local id version want kind commit tagged formed=no
  want="$(tr -d '[:space:]' <"$ROOT/opt/menuz/VERSION")"
  id="$(plist_get "$1" CFBundleIdentifier)"
  version="$(plist_get "$1" CFBundleShortVersionString)"
  kind="$(plist_get "$1" MenuzKind)"
  commit="$(plist_get "$1" MenuzCommit)"
  [ "$id" = "$APP_BUNDLE_ID" ] || printf 'the bundle id is %s, not %s\n' "${id:-<unreadable>}" "$APP_BUNDLE_ID"
  [ "$version" = "$want" ] ||
    printf 'the bundle is version %s and opt/menuz/VERSION is %s -- it was built from another tree; run app-sign and app-notarize at the tag\n' "${version:-<unreadable>}" "$want"
  [ "$kind" = release ] ||
    printf "the bundle's MenuzKind is %s, not release -- it was built off the tag %s or from a dirty tree; run app-sign and app-notarize in a tree at the tag\n" "${kind:-<unreadable>}" "$2"
  if [[ "$commit" =~ ^[0-9a-f]{8,40}$ ]]; then
    formed=yes
  else
    printf "the bundle's MenuzCommit is %s, not a commit of 8 to 40 lowercase hex characters, so it cannot be checked against the tag %s\n" "${commit:-<unreadable>}" "$2"
  fi
  if ! tagged="$(app_tag_commit "$2")"; then
    printf "the tag %s that VERSION names is not in this tree, so the bundle's commit cannot be checked against it\n" "$2"
  elif [ "$formed" = yes ] && [[ "$tagged" != "$commit"* ]]; then
    printf "the bundle's MenuzCommit is %s and the tag %s names %s -- it was built off the tag; run app-sign and app-notarize in a tree at the tag\n" "$commit" "$2" "${tagged:0:8}"
  fi
  return 0
}

# app-sign signs the release's build alone (issue 0103). Before any build it
# asks menuz what the build would carry (`utilz menuz stamps`), and refuses
# unless the kind is release, which menuz's build_kind, the one place that
# decides it, gives only at the root VERSION's tag from a clean tree. The
# refusal names the route: the three steps in a worktree at the tag.
app_require_release_build() {
  local stamps kind commit tag tagged where
  stamps="$("$ROOT/bin/utilz" menuz stamps)" ||
    die "utilz menuz stamps failed, so app-sign cannot tell whether the build would be the release's -- nothing built or signed"
  kind="$(printf '%s\n' "$stamps" | sed -n 's/^MENUZ_KIND=//p')"
  commit="$(printf '%s\n' "$stamps" | sed -n 's/^MENUZ_COMMIT=//p')"
  if [ "$kind" = release ]; then
    printf '  %-21s %s at %s\n' "next build" "$kind" "${commit:-<unreadable>}"
    return 0
  fi
  tag="$(app_release_tag)"
  if tagged="$(app_tag_commit "$tag")"; then
    where="which names ${tagged:0:8}"
  else
    where="which is not in this tree"
  fi
  die "the build here would be MENUZ_KIND=${kind:-<unreadable>} at MENUZ_COMMIT=${commit:-<unreadable>}, and app-sign signs only the release's build: HEAD at the tag $tag, $where, from a clean tree -- nothing built or signed. Run the three steps in a worktree at the tag:
       git worktree add --detach <dir> $tag
       cd <dir>, then bin/devbin macos app-sign, app-notarize and publish
       git worktree remove <dir>, once publish has run"
}

cmd_store_creds() {
  [ -t 0 ] || die "store-creds is interactive and reads the terminal; stdin is not one -- run it yourself in a terminal"
  printf 'Storing Apple notary credentials in the login keychain under "%s.*".\n' "$KC_PREFIX"
  printf 'Nothing is written to this repository. Values are not echoed.\n\n'
  local a_id a_pw a_team pair k v
  printf 'APPLE_ID (Apple account email): '
  read -r a_id
  printf 'APPLE_APP_PASSWORD (app-specific password, not the account password): '
  read -rs a_pw
  printf '\nAPPLE_TEAM_ID (eg 76BQL8L47U): '
  read -r a_team
  printf '\n'
  for pair in "APPLE_ID:$a_id" "APPLE_APP_PASSWORD:$a_pw" "APPLE_TEAM_ID:$a_team"; do
    k="${pair%%:*}"
    v="${pair#*:}"
    [ -n "$v" ] || die "$k was empty -- nothing more stored"
  done
  for pair in "APPLE_ID:$a_id" "APPLE_APP_PASSWORD:$a_pw" "APPLE_TEAM_ID:$a_team"; do
    k="${pair%%:*}"
    v="${pair#*:}"
    security add-generic-password -U -a "${USER:-$(id -un)}" -s "$KC_PREFIX.$k" -w "$v" ||
      die "could not write $k to the keychain"
  done
  printf 'Stored. Check with: %s macos doctor\n' "$DEVBIN_INVOKE"
}

# app-sign: refused unless menuz says the build would be the release's; then
# `utilz menuz build --release`, the one build path; a copy staged out of the
# products, refused with nothing signed unless it is the release's build, as
# publish asks; signed inside-out with the Developer ID identity and the
# hardened runtime; the identifier, team, runtime and build stamps read back.
cmd_app_sign() {
  load_creds
  require_identity
  [ -f "$APP_ENTITLEMENTS" ] || die "no release entitlements at ${APP_ENTITLEMENTS#"$ROOT"/}"
  step "checking the build would be the release's, through utilz menuz stamps"
  app_require_release_build
  step "building Release through utilz menuz build --release"
  local out rc=0
  out="$(mktemp)"
  "$ROOT/bin/utilz" menuz build --release 2>&1 | tee "$out" || rc=$?
  if grep -q "unknown verb: 'build'" "$out"; then
    rm -f "$out"
    die "utilz menuz has no build verb yet (WP-05's shim), and app-sign builds only through it"
  fi
  rm -f "$out"
  [ "$rc" -eq 0 ] || die "utilz menuz build --release failed (exit $rc) -- nothing signed"
  local src dist tag blockers
  src="$(app_product Release)"
  dist="$(app_dist)"
  [ -d "$src" ] || die "the build left no bundle at $src"
  step "staging a copy out of the build products"
  rm -rf "$APP_DIST_DIR"
  mkdir -p "$APP_DIST_DIR"
  ditto "$src" "$dist" || die "could not stage $src -> $dist"
  # codesign refuses "resource fork, Finder information, or similar detritus".
  xattr -cr "$dist" || true
  printf '  %s\n' "$dist"
  # The products are shared by every tree, so another build can replace the
  # one just made before it is staged: the staged copy is asked publish's own
  # question before anything is signed or a notary submission spent.
  step "checking the staged copy is the release's build, as publish will"
  tag="$(app_release_tag)"
  blockers="$(app_ship_blockers "$dist" "$tag")"
  if [ -n "$blockers" ]; then
    rm -rf "$APP_DIST_DIR"
    die "the staged Menuz.app cannot ship with release $tag -- nothing signed:
$(printf '%s\n' "$blockers" | sed 's/^/       /')"
  fi
  step "signing Menuz.app inside-out (nested code, then the bundle), team $(identity_team)"
  app_sign_nested "$dist"
  codesign --force --options runtime --timestamp --entitlements "$APP_ENTITLEMENTS" --sign "$IDENTITY" "$dist" ||
    die "codesign could not sign $dist"
  step "reading the signature back off the bundle"
  app_signature_readback "$dist"
  printf '\nsigned: %s\nnext: %s macos app-notarize\n' "$dist" "$DEVBIN_INVOKE"
}

# app-notarize: the signed copy submitted with notarytool --wait; anything but
# Accepted prints Apple's log and stops with nothing stapled; then the ticket
# stapled and the bundle checked as a download meets it.
cmd_app_notarize() {
  load_creds
  require_identity
  require_creds
  local dist staging zip out status id
  dist="$(app_dist)"
  [ -d "$dist" ] || die "no signed bundle at $dist -- run: $DEVBIN_INVOKE macos app-sign"
  step "checking the bundle is the signed one"
  app_signature_readback "$dist"
  staging="$(mktemp -d)"
  zip="$staging/Menuz.zip"
  ditto -c -k --keepParent --sequesterRsrc "$dist" "$zip" ||
    { rm -rf "$staging"; die "could not build the submission archive"; }
  step "submitting to Apple (notarytool waits; usually minutes)"
  out="$(xcrun notarytool submit "$zip" \
    --apple-id "$APPLE_ID" --password "$APPLE_APP_PASSWORD" --team-id "$APPLE_TEAM_ID" \
    --wait 2>&1)" || true
  printf '%s\n' "$out"
  rm -rf "$staging"
  status="$(printf '%s\n' "$out" | awk '/^  status: / { print $2 }' | tail -1)"
  id="$(printf '%s\n' "$out" | awk '/id: [0-9a-f-]+/ { print $2; exit }')"
  [ -n "$id" ] || die "could not read a submission id from notarytool's output -- nothing stapled"
  if [ "$status" != "Accepted" ]; then
    xcrun notarytool log "$id" \
      --apple-id "$APPLE_ID" --password "$APPLE_APP_PASSWORD" --team-id "$APPLE_TEAM_ID" 2>&1 | head -40 || true
    die "notarisation was not Accepted (status: ${status:-unknown}) -- nothing stapled"
  fi
  step "stapling the ticket to the bundle"
  xcrun stapler staple "$dist" || die "stapler could not staple the ticket to $dist"
  step "checking the stapled bundle as a download meets it"
  app_verify_notarised "$dist" || die "the bundle was Accepted and stapled, and does not pass the check above"
  printf '\nnotarised and stapled: %s\nnext: %s macos publish\n' "$dist" "$DEVBIN_INVOKE"
}

# app-verify [debug|release|dist]: read-only. A build product's executable,
# LSUIElement and build stamps; for dist (the default) also its signature and
# its ticket. Exit 1 on any failure.
cmd_app_verify() {
  local config bundle exe
  case "${1:-dist}" in
    debug | Debug) config="Debug" ;;
    release | Release) config="Release" ;;
    dist) config="dist" ;;
    *) die "app-verify: unknown config '$1' (debug|release|dist)" ;;
  esac
  if [ "$config" = dist ]; then
    bundle="$(app_dist)"
    [ -d "$bundle" ] || die "no signed bundle at $bundle -- run: $DEVBIN_INVOKE macos app-sign"
  else
    bundle="$(app_product "$config")"
    local flag=""
    [ "$config" = Release ] && flag=" --release"
    [ -d "$bundle" ] || die "no $config bundle at $bundle -- run: utilz menuz build$flag"
  fi
  exe="$(app_executable "$bundle")"
  printf '  %-21s %s\n' "bundle" "$bundle"
  [ -x "$exe" ] || die "no executable at $exe"
  [ "$(plist_get "$bundle" LSUIElement)" = true ] || die "LSUIElement is not true in $bundle -- the app would take a Dock slot"
  printf '  %-21s %s\n' "LSUIElement" "true"
  # dist's stamps come with its signature's readback, below.
  if [ "$config" != dist ]; then
    app_stamps_readback "$bundle"
    return 0
  fi
  load_creds
  require_identity
  app_signature_readback "$bundle"
  app_verify_notarised "$bundle" || die "the signed bundle is not notarised and stapled"
}

# publish: Menuz.app.zip attached to the release object the release core made
# for the tree's VERSION. Refused, with nothing uploaded, if the bundle is not
# opt/menuz/VERSION's or not the tag's own build, if the release object does
# not exist, or if it already holds the asset. The zip is proven by unpacking
# it as a user does and checking the bundle inside, before the upload.
cmd_publish() {
  local dist tag blockers assets staging zip
  dist="$(app_dist)"
  [ -d "$dist" ] || die "no signed bundle at $dist -- run: $DEVBIN_INVOKE macos app-sign, then app-notarize"
  tag="$(app_release_tag)"
  blockers="$(app_ship_blockers "$dist" "$tag")"
  [ -z "$blockers" ] || die "Menuz.app cannot ship with release $tag:
$(printf '%s\n' "$blockers" | sed 's/^/       /')"
  command -v gh >/dev/null 2>&1 || die "gh not found -- publish attaches the asset with gh release upload"
  assets="$(gh release view "$tag" --json assets --jq '.assets[].name' 2>/dev/null)" ||
    die "there is no release object for $tag -- the release core makes it (bin/devbin release); publish attaches to it"
  if printf '%s\n' "$assets" | grep -qxF "$APP_ASSET"; then
    die "release $tag already holds $APP_ASSET -- nothing uploaded"
  fi
  staging="$(mktemp -d)"
  zip="$staging/$APP_ASSET"
  step "zipping the stapled bundle"
  ditto -c -k --keepParent "$dist" "$zip" || { rm -rf "$staging"; die "could not zip $dist"; }
  step "proving the zip as a download meets it"
  mkdir "$staging/unpacked"
  if ! ditto -x -k "$zip" "$staging/unpacked" || [ ! -d "$staging/unpacked/Menuz.app" ]; then
    rm -rf "$staging"
    die "$APP_ASSET does not unpack to Menuz.app -- nothing uploaded"
  fi
  blockers="$(app_ship_blockers "$staging/unpacked/Menuz.app" "$tag")"
  [ -z "$blockers" ] || { rm -rf "$staging"; die "the bundle inside $APP_ASSET cannot ship: $blockers"; }
  app_verify_notarised "$staging/unpacked/Menuz.app" ||
    { rm -rf "$staging"; die "the bundle inside $APP_ASSET is not notarised and stapled -- nothing uploaded"; }
  step "uploading $APP_ASSET to release $tag"
  gh release upload "$tag" "$zip" || { rm -rf "$staging"; die "gh release upload failed"; }
  rm -rf "$staging"
  printf '\npublished: %s on release %s\n' "$APP_ASSET" "$tag"
}

SUBCOMMANDS="app-icons doctor store-creds app-sign app-notarize app-verify publish"

usage() {
  cat <<'USAGE'
bin/devbin macos <subcommand>

  app-icons    Rasterise native/macos/Menuz/design/menuz.svg (the app icon)
               and menuz-mark.svg (the menu bar template) with rsvg-convert
               into the tracked Menuz/Assets.xcassets: AppIcon at the seven
               macOS sizes, MenuBarIcon as a template at 1x, 2x and 3x.
               Refuses, writing nothing, without rsvg-convert or either SVG.
  doctor       Report rsvg-convert, the two SVGs, the asset catalogue, the
               Developer ID identity (counted, with a test-sign) and the notary
               credentials (PRESENT or MISSING, never a value). Exit 1 when
               anything is missing or the identity cannot sign.

  The release asset, on the maintainer's machine, after the release core has
  made the release object (D12), in a tree whose HEAD is the tag: once main has
  moved past it, a worktree (git worktree add --detach <dir> <tag>). In order:

  app-sign     utilz menuz build --release, a copy staged under XDG state, signed
               inside-out with the Developer ID identity and the hardened
               runtime, its identifier, team, runtime and build stamps read
               back. Refuses, building nothing, unless utilz menuz stamps says
               the build would be the release's: HEAD at the tag, clean;
               refuses, signing nothing, a staged copy publish would refuse
  app-notarize Submit the signed copy to Apple and wait; staple the ticket only
               when Accepted; check a quarantined copy with spctl
  publish      Zip the stapled bundle as Menuz.app.zip, prove the zip, and
               attach it to the release for VERSION with gh. Refuses a bundle
               that is not opt/menuz/VERSION's, one whose MenuzKind is not
               release or whose MenuzCommit is not the tag's commit, a missing
               release, and one that already holds the asset

  app-verify [debug|release|dist]
               Read-only: a bundle's executable, LSUIElement and build stamps,
               and for dist (the default) its signature and ticket
  store-creds  Store the notary credentials in the login keychain under
               utilz.apple.*; interactive, in a terminal only
USAGE
}

no_args() { # $1 the subcommand as typed, then whatever followed it
  local sub="$1"
  shift
  [ $# -eq 0 ] || die "macos $sub takes no arguments, got: $* (try: bin/devbin macos --help)"
}

at_most_one() { # $1 the subcommand as typed, then whatever followed it
  local sub="$1"
  shift
  [ $# -le 1 ] || die "macos $sub takes at most one argument, got: $* (try: bin/devbin macos --help)"
}

case "${1:-}" in
  "" | -h | --help) usage; exit 0 ;;
  app-icons) no_args "$@"; cmd_app_icons ;;
  doctor) no_args "$@"; cmd_doctor ;;
  store-creds) no_args "$@"; cmd_store_creds ;;
  app-sign) no_args "$@"; cmd_app_sign ;;
  app-notarize | app-notarise) no_args "$@"; cmd_app_notarize ;;
  app-verify) at_most_one "$@"; shift; cmd_app_verify "${1:-}" ;;
  publish) no_args "$@"; cmd_publish ;;
  *) die "unknown macos subcommand: $1 (try: $SUBCOMMANDS)" ;;
esac

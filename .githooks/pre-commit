#!/usr/bin/env bash
set -euo pipefail

# Tracked at .githooks/ and run through `git config core.hooksPath .githooks`,
# once per clone (docs/developer-guide.md, issue 0064). Until 2026-09-22 this
# lived only in .git/hooks/, which git never tracks, so it guarded one checkout
# and shipped to nobody.

# intent-chain-block:start (generated by intent claude upgrade)
_intent_chain="$(git rev-parse --git-path hooks 2>/dev/null || :)/pre-commit.intent"
if [ -x "$_intent_chain" ]; then
  "$_intent_chain" "$@" || exit $?
elif [ -e "$_intent_chain" ]; then
  echo "pre-commit: GATE NOT EXECUTABLE -- the Intent gate did NOT run: no guard, no critic, no doctor." >&2
  echo "pre-commit:   the carrier has no execute bit: $_intent_chain" >&2
  echo "pre-commit:   remedy: intent claude upgrade --apply" >&2
  exit 1
else
  echo "pre-commit: GATE ABSENT -- the Intent gate did NOT run: no guard, no critic, no doctor." >&2
  echo "pre-commit:   this hook declares a gate it cannot find: $_intent_chain" >&2
  echo "pre-commit:   the carrier is gitignored, so no clone or worktree receives it." >&2
  echo "pre-commit:   remedy: intent claude upgrade --apply" >&2
  exit 1
fi
# intent-chain-block:end

# THE FORMATTERS CHECK AND REFUSE. THEY NEVER WRITE. (hv's ruling, 2026-09-21,
# carried by intent-vc; the contract of Intent's own .githooks/pre-commit since
# 2026-08-30, 14dff1927.) This stanza used to run the formatter in write mode over
# the WORKTREE and then `git add` the result, so a commit carried bytes nobody
# staged: a partly staged file went in whole, and in a checkout shared by several
# sessions another session's unfinished edits went in with it (Intent issue 0498).
# It now judges exactly the bytes being committed and refuses with the fix;
# nothing is rewritten. A file whose worktree still matches its staged blob is
# checked on disk, all of them in ONE formatter call (the same bytes, and a
# fraction of the cost of one call per file); a partly staged file is checked
# from its staged blob. A formatter that exits non-zero without naming a file
# could not check, and that refuses too, with its output.
# The files come as arguments, one each, so a path with a space in it is still
# one path: they used to travel as one space-joined string split on the way out.
formatter_refused() {
  _lang="$1" _fix="$2"
  shift 2
  echo "pre-commit: $_lang is not formatted -- REFUSED, and NOTHING WAS REWRITTEN." >&2
  echo "pre-commit:   your staged bytes are exactly as you staged them." >&2
  echo "pre-commit:   files:" >&2
  printf 'pre-commit:     %s\n' "$@" >&2
  echo "pre-commit:   fix:   $_fix" >&2
  echo "pre-commit:   then:  git add those files, and commit again" >&2
  exit 1
}
formatter_unmeasured() {
  echo "pre-commit: $1 could not check the staged files -- REFUSED, and NOTHING WAS REWRITTEN." >&2
  printf '%s\n' "$2" >&2
  exit 1
}

# Markdown. prettier resolves .prettierrc and .prettierignore for a path on disk
# and, through `--stdin-filepath`, for a staged blob as though it were there.
# ARRAYS, filled a line at a time: `mapfile` is not in the /bin/bash 3.2 macOS
# ships, and an array is expanded only once it is known to be non-empty, which
# `set -u` requires there.
MD_FILES=()
while IFS= read -r f; do
  [ -n "$f" ] && MD_FILES+=("$f")
done < <(git diff --cached --name-only --diff-filter=ACM -- '*.md' ${DROP_EXCLUDE:+"$DROP_EXCLUDE"} || true)
if [ "${#MD_FILES[@]}" -gt 0 ]; then
  MD_SPLIT=$(git diff --name-only -- "${MD_FILES[@]}" 2>/dev/null || true)
  MD_WHOLE=() MD_BAD=()
  for f in "${MD_FILES[@]}"; do
    case "
$MD_SPLIT
" in
      *"
$f
"*)
        git show ":$f" 2>/dev/null | prettier --stdin-filepath "$f" --check >/dev/null 2>&1 \
          || MD_BAD+=("$f") ;;
      *) MD_WHOLE+=("$f") ;;
    esac
  done
  if [ "${#MD_WHOLE[@]}" -gt 0 ]; then
    MD_OUT=$(prettier --list-different "${MD_WHOLE[@]}" 2>&1) && MD_RC=0 || MD_RC=$?
    if [ "$MD_RC" != 0 ]; then
      # An `[error]` is prettier failing to read a file, not a formatting verdict.
      case "$MD_OUT" in *"[error]"*) formatter_unmeasured prettier "$MD_OUT" ;; esac
      MD_NAMED=""
      for f in "${MD_WHOLE[@]}"; do
        case "
$MD_OUT
" in *"
$f
"*) MD_BAD+=("$f"); MD_NAMED=1 ;; esac
      done
      [ -n "$MD_NAMED" ] || formatter_unmeasured prettier "$MD_OUT"
    fi
  fi
  [ "${#MD_BAD[@]}" -eq 0 ] || formatter_refused markdown "prettier --write <the files listed above>" "${MD_BAD[@]}"
fi

# Rust (issue 0060). This project declares `rust` beside `shell` in
# intent/.config/config.json, rustfmt was adopted for the prez crate on hv's
# ruling (issue 0036), and `bin/devbin check format` and CI's clippy job both
# enforce it. The commit path was the ONE layer that did not, on the strength
# of a comment below that said this repo was bash-only. Measured cost of the
# gap: the crate sat unformatted across four commits and CI was the first
# thing to say so, one push later (issue 0059).
#
# --config-path, ALWAYS. rustfmt finds rustfmt.toml by walking up from the
# file it is given, so a blob checked from anywhere else is checked at
# rustfmt's OWN defaults -- 4 spaces -- which refuses every correctly
# formatted file in this repo. The walk below finds the config the file
# actually lives under, and a file no config governs is UNMEASURED rather
# than assumed fine.
#
# A FILE, NEVER STDIN, and this is measured rather than assumed: `rustfmt
# --check` reading stdin exits 0 whatever it is handed, including with no
# config at all and input formatted the other way. A stdin check is the
# empty-output-is-not-a-pass shape -- it reads clean because it says nothing.
# So a partly staged file's blob is written to a temp file OUTSIDE the tree
# (untracked dirt inside it is what step 4 of a cut refuses) and checked
# there, which --config-path is what makes possible.
rs_config_for() {
  _d=$(dirname "$1")
  while [ "$_d" != "." ] && [ "$_d" != "/" ]; do
    if [ -f "$_d/rustfmt.toml" ]; then printf '%s\n' "$_d/rustfmt.toml"; return 0; fi
    _d=$(dirname "$_d")
  done
  [ -f rustfmt.toml ] && printf '%s\n' rustfmt.toml
  return 0
}

RS_FILES=()
while IFS= read -r f; do
  [ -n "$f" ] && RS_FILES+=("$f")
done < <(git diff --cached --name-only --diff-filter=ACM -- '*.rs' ${DROP_EXCLUDE:+"$DROP_EXCLUDE"} || true)
if [ "${#RS_FILES[@]}" -gt 0 ]; then
  command -v rustfmt >/dev/null 2>&1 \
    || formatter_unmeasured rustfmt "rustfmt is not on PATH, so the staged Rust could not be checked"
  RS_SPLIT=$(git diff --name-only -- "${RS_FILES[@]}" 2>/dev/null || true)
  RS_TMP=$(mktemp -d "${TMPDIR:-/tmp}/utilz-precommit-rs.XXXXXX") || \
    formatter_unmeasured rustfmt "could not make a scratch directory to check the staged bytes in"
  trap 'rm -rf "$RS_TMP"' EXIT
  RS_BAD=()
  for f in "${RS_FILES[@]}"; do
    RS_CFG=$(rs_config_for "$f")
    [ -n "$RS_CFG" ] || formatter_unmeasured rustfmt "no rustfmt.toml governs $f, so a check would run at rustfmt's defaults and refuse correct files"
    case "
$RS_SPLIT
" in
      *"
$f
"*)
        # Partly staged: judge the STAGED bytes, never the worktree's.
        RS_PROBE="$RS_TMP/staged.rs"
        git show ":$f" > "$RS_PROBE" 2>/dev/null \
          || formatter_unmeasured rustfmt "could not read the staged $f"
        ;;
      *)
        # Worktree matches the staged blob, so the file on disk IS those bytes.
        RS_PROBE="$f"
        ;;
    esac
    rustfmt --check --edition 2021 --config-path "$RS_CFG" "$RS_PROBE" >/dev/null 2>&1 \
      || RS_BAD+=("$f")
  done
  rm -rf "$RS_TMP"
  trap - EXIT
  [ "${#RS_BAD[@]}" -eq 0 ] || formatter_refused rustfmt "bin/devbin fmt rust" "${RS_BAD[@]}"
fi

# The mix format block that used to sit here is gone: this repo has no mix.exs
# and dropped `elixir` from config.json languages on 2026-07-29. It was a
# permanent no-op whose only effect was to imply this repo had Elixir in it.
# (If you need it back, it is one block; git history has it.)
#
# THAT COMMENT USED TO READ "Utilz is bash-only", AND THAT IS WHAT COST US:
# it stopped being true when the prez crate landed, nobody re-read it, and
# the Rust stanza above went unwritten for as long as the sentence stood
# (issue 0060). A comment asserting what a repo CONTAINS goes stale silently.

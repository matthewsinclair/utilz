#!/usr/bin/env bash
#
# arngz - Named window arrangements (desks) across displays and spaces
#
# ST0026. This file is the CLI half: it parses, reads and validates desks, and
# renders. The engine half is a Lua module Hammerspoon loads (WP-03); nothing
# here calls Hammerspoon or the hs tool yet. The verbs that need the engine
# exist from the start and say which work package builds them, so the CLI's
# surface is complete and a caller learns what is missing by name.
#

set -euo pipefail

# Source common functions if not already loaded (from dispatcher)
if [[ "$(type -t info 2>/dev/null)" != "function" ]]; then
  SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  UTILZ_HOME="${UTILZ_HOME:-$(cd "$SCRIPT_DIR/../.." && pwd)}"

  if [[ -f "$UTILZ_HOME/opt/utilz/lib/common.sh" ]]; then
    source "$UTILZ_HOME/opt/utilz/lib/common.sh"
  else
    echo "ERROR: Cannot find common.sh library" >&2
    exit 1
  fi
fi

# Every verb. A desk may not take one of these names (design.md, the
# validator's seventh condition; AC-05.7), because `arngz <desk>` is apply and
# a desk called `list` could never be applied that way.
ARNGZ_VERBS="apply discover diff list show delete init doctor"

# ============================================================================
# USAGE
# ============================================================================

usage() {
  cat <<EOF
Usage: arngz <desk>
       arngz <verb> [ARGS]

Named window arrangements (desks) across displays and spaces.

VERBS:
  <desk>                     the same as apply <desk>
  apply <desk> [--dry-run] [--no-launch] [--no-create] [--bind] [--map <name>=<uuid>]
                             arrange this machine's windows as the desk says
  discover [--grid WxH] [--save <desk>] [--force]
                             print the arrangement on screen now as a desk
  diff <desk>                print what apply would do, and change nothing
  list                       the desks in the catalogue, with display and app counts
  show <desk>                the desk, validated, as stored
  delete <desk>              remove a desk from the catalogue
  init [--yes]               create the catalogue, and report what Hammerspoon needs
  doctor                     every precondition, each with its state

The catalogue is \${XDG_CONFIG_HOME:-\$HOME/.config}/arngz/desks/<desk>.yaml.

For detailed help, run: utilz help arngz
EOF
}

# ============================================================================
# THE CATALOGUE
# ============================================================================

catalogue_dir() {
  printf '%s/arngz/desks\n' "${XDG_CONFIG_HOME:-$HOME/.config}"
}

desk_file() {
  printf '%s/%s.yaml\n' "$(catalogue_dir)" "$1"
}

# A refusal, in the one shape every one of them takes: what refused, and exit 2
# because nothing has changed.
refuse() {
  error "arngz: $*"
  exit 2
}

# The one place a desk NAME is judged. A verb name is the design's seventh
# condition. A name that is not a plain file name is refused too, because it
# is joined onto the catalogue path and `show ../x` must not read outside it.
desk_name_refusal() {
  local name="$1" verb
  for verb in $ARNGZ_VERBS; do
    if [[ "$name" == "$verb" ]]; then
      printf "desk name = '%s': a desk may not be named like a verb (%s)" "$name" "${ARNGZ_VERBS// /, }"
      return 0
    fi
  done
  if [[ ! "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
    printf "desk name = '%s': a desk name is letters, digits, '.', '_' and '-', starting with a letter or digit" "$name"
    return 0
  fi
  return 1
}

# ============================================================================
# THE VALIDATOR
# ============================================================================

# Flatten a desk into one line per fact, from ONE yq pass:
#   K <tab> map-path <tab> key     every key of every mapping
#   V <tab> path <tab> value       every scalar, newlines escaped
#   T <tab> path <tab> tag         every mapping and sequence
# Paths are yq's, dot-joined with numeric indexes ("displays.0.name"). The
# validator and the counts both read this, so there is one parse of a desk.
desk_facts() {
  # shellcheck disable=SC2016 # a yq program: its $p is yq's variable, not the shell's
  yq -r '
    (.. | select(tag == "!!map") | path as $p | keys[] | "K\t" + ($p | map(tostring) | join(".")) + "\t" + .),
    (.. | select(tag != "!!map" and tag != "!!seq") | "V\t" + (path | map(tostring) | join(".")) + "\t" + (. | tostring | sub("\n"; "\\n"))),
    (.. | select(tag == "!!map" or tag == "!!seq") | "T\t" + (path | map(tostring) | join(".")) + "\t" + tag)
  ' "$1"
}

# The desk schema's rules, over desk_facts. PURE: it reads facts on stdin and
# prints one refusal per line, "path US value US reason" (US is the ASCII unit
# separator, 0x1f, which `read` never merges the way it merges empty tab
# fields), in the order
# found; no output means the desk is valid. Every condition in design.md's
# "The config" is here, plus the shape checks they rest on (a list where a list
# belongs, an app entry that names its app, a layout that is present).
# shellcheck disable=SC2016 # an awk program: its $1, $2 and $3 are awk's fields
DESK_RULES='
function human(p,   out) {
  out = p
  while (match(out, /\.[0-9]+/)) {
    out = substr(out, 1, RSTART - 1) "[" substr(out, RSTART + 1, RLENGTH - 1) "]" substr(out, RSTART + RLENGTH)
  }
  return out
}
function shape(p) { gsub(/\.[0-9]+/, "[]", p); return p }
function refuse(p, v, why) { printf "%s\037%s\037%s\n", (p == "" ? "(top)" : human(p)), v, why }
BEGIN {
  FS = "\t"
  allowed["|desk"] = allowed["|grid"] = allowed["|displays"] = 1
  allowed["displays[]|name"] = allowed["displays[]|match"] = allowed["displays[]|spaces"] = 1
  allowed["displays[].match|uuid"] = allowed["displays[].match|name"] = 1
  allowed["displays[].match|size"] = allowed["displays[].match|position"] = 1
  allowed["displays[].spaces[]|name"] = allowed["displays[].spaces[]|apps"] = 1
  allowed["displays[].spaces[].apps[]|app"] = allowed["displays[].spaces[].apps[]|window"] = 1
  allowed["displays[].spaces[].apps[]|layout"] = 1
  # How far discover found a window from its cells (ST0026 WP-04); the
  # planner ignores it.
  allowed["displays[].spaces[].apps[]|misfit"] = 1
  want[""] = "!!map"; want["displays"] = "!!seq"; want["displays[]"] = "!!map"
  want["displays[].match"] = "!!map"; want["displays[].spaces"] = "!!seq"
  want["displays[].spaces[]"] = "!!map"; want["displays[].spaces[].apps"] = "!!seq"
  want["displays[].spaces[].apps[]"] = "!!map"
}
$1 == "K" {
  if (!((shape($2) "|" $3) in allowed)) unknown[++nu] = ($2 == "" ? $3 : $2 "." $3)
  next
}
$1 == "T" {
  tags[$2] = $3; norder[++n] = $2
  next
}
$1 == "V" {
  val[$2] = $3
  if (shape($2) in want) refuse($2, $3, "expected " (want[shape($2)] == "!!seq" ? "a list" : "a mapping"))
  next
}
END {
  if (!("" in tags)) { refuse("", "", "a desk is a mapping with desk, grid and displays"); exit }
  for (i = 1; i <= nu; i++) {
    u = unknown[i]
    refuse(u, (u in val ? val[u] : (u in tags ? tags[u] : "")), "unknown key")
  }
  for (i = 1; i <= n; i++) {
    p = norder[i]
    if ((shape(p) in want) && tags[p] != want[shape(p)])
      refuse(p, tags[p], "expected " (want[shape(p)] == "!!seq" ? "a list" : "a mapping"))
  }

  gw = 0; gh = 0
  if (!("grid" in val)) refuse("grid", "(absent)", "a desk declares its grid as WxH, eg 12x8")
  else if (val["grid"] !~ /^[1-9][0-9]*x[1-9][0-9]*$/) refuse("grid", val["grid"], "a grid is WxH, eg 12x8")
  else { split(val["grid"], g, "x"); gw = g[1] + 0; gh = g[2] + 0 }

  for (i = 1; i <= n; i++) {
    p = norder[i]
    if (shape(p) == "displays[]" && tags[p] == "!!map") {
      if ((p ".name") in val) {
        nm = val[p ".name"]
        if (nm in display_named) refuse(p ".name", nm, "two displays named " nm ": " human(display_named[nm]) " already has that name")
        else display_named[nm] = p
      }
      m = p ".match"
      if (!((m ".uuid") in val) && !((m ".name") in val)) {
        keys = ""
        for (k in val) if (index(k, m ".") == 1) keys = keys (keys == "" ? "" : ", ") substr(k, length(m) + 2)
        refuse(m, (keys == "" ? "(absent)" : keys), "a display must match by uuid or name")
      }
    }
    if (shape(p) == "displays[].spaces[].apps[]" && tags[p] == "!!map" && ((p ".misfit") in val) && val[p ".misfit"] !~ /^[0-9]+px$/)
      refuse(p ".misfit", val[p ".misfit"], "a misfit is a whole number of points, eg 3px")
    if (shape(p) == "displays[].spaces[].apps[]" && tags[p] == "!!map") {
      split(p, parts, ".")
      disp = parts[1] "." parts[2]
      if (!((p ".app") in val)) refuse(p ".app", "(absent)", "an app entry names its bundle id")
      else {
        a = val[p ".app"]
        key = disp SUBSEP a
        count[key]++
        if (count[key] == 1) first[key] = p
        if (!((p ".window") in val)) bare[key] = 1
        if (count[key] == 2) second[key] = p
      }
      if (!((p ".layout") in val)) refuse(p ".layout", "(absent)", "a layout is x,y wxh in the grid, or fullscreen")
      else {
        l = val[p ".layout"]
        if (l == "fullscreen") { }
        else if (l !~ /^[0-9]+,[0-9]+ [1-9][0-9]*x[1-9][0-9]*$/) refuse(p ".layout", l, "a layout is x,y wxh in the grid, or fullscreen")
        else if (gw > 0) {
          split(l, lp, /[, x]/)
          if (lp[1] + lp[3] > gw || lp[2] + lp[4] > gh) refuse(p ".layout", l, "outside the " gw "x" gh " grid")
        }
      }
    }
  }
  for (key in count) {
    if (count[key] > 1 && (key in bare)) {
      split(key, ka, SUBSEP)
      refuse(second[key] ".app", ka[2], "also at " human(first[key]) "; the same app twice on one display needs a window pattern on every entry")
    }
  }
}
'

# THE validator: every verb that reads a desk calls this before anything else
# (design.md, "The config"). Prints every refusal, each naming the desk, its
# file, the path and the value, and returns 2; returns 0 for a valid desk.
validate_desk() {
  local desk="$1" file reason
  file="$(desk_file "$desk")"

  if reason="$(desk_name_refusal "$desk")"; then
    error "arngz: desk '$desk' ($file): $reason"
    return 2
  fi
  if [[ ! -f "$file" ]]; then
    error "arngz: desk '$desk' does not exist: no $file (arngz list names the desks there are)"
    return 2
  fi
  validate_desk_file "$desk" "$file"
}

# The schema half of the validator, for a desk file anywhere: discover checks
# what it is about to save before the file reaches the catalogue.
validate_desk_file() {
  local desk="$1" file="$2" facts refusals path value why
  if ! facts="$(desk_facts "$file" 2>&1)"; then
    error "arngz: desk '$desk' ($file) is not YAML yq can read: $facts"
    return 2
  fi
  refusals="$(printf '%s\n' "$facts" | awk "$DESK_RULES")"
  if [[ -z "$refusals" ]]; then
    return 0
  fi
  while IFS=$'\037' read -r path value why; do
    if [[ -n "$value" ]]; then
      error "arngz: desk '$desk' ($file): $path = '$value': $why"
    else
      error "arngz: desk '$desk' ($file): $path: $why"
    fi
  done <<<"$refusals"
  return 2
}

# "N display(s)  M app(s)" for a desk already validated.
desk_counts() {
  local facts displays apps
  facts="$(desk_facts "$1")"
  displays=$(printf '%s\n' "$facts" | awk -F'\t' '$1 == "T" && $2 ~ /^displays\.[0-9]+$/ { c++ } END { print c + 0 }')
  apps=$(printf '%s\n' "$facts" | awk -F'\t' '$1 == "T" && $2 ~ /^displays\.[0-9]+\.spaces\.[0-9]+\.apps\.[0-9]+$/ { c++ } END { print c + 0 }')
  printf '%d display%s  %d app%s\n' "$displays" "$([[ $displays -eq 1 ]] || echo s)" "$apps" "$([[ $apps -eq 1 ]] || echo s)"
}

# ============================================================================
# THE ENGINE CONTRACT (design.md "The engine", D17)
# ============================================================================

# The Lua module Hammerspoon loads, beside this script.
engine_module() {
  printf '%s/opt/arngz/lib/arngz.lua\n' "$UTILZ_HOME"
}

# How long one engine call may take, in seconds. ARNGZ_HS_TIMEOUT overrides it,
# which is how the suite makes a call that never answers fail in one second
# rather than sixty.
engine_timeout() {
  local t="${ARNGZ_HS_TIMEOUT:-60}"
  if [[ ! "$t" =~ ^[1-9][0-9]*$ ]]; then
    refuse "ARNGZ_HS_TIMEOUT = '$t': a whole number of seconds"
  fi
  printf '%s\n' "$t"
}

# Ask the engine one thing. Writes {verb, desk, options} to a request file in
# a fresh temp dir, runs `hs -c 'return dofile(<module>).run(<request>)'`, and
# leaves the response's path in ENGINE_RESPONSE. Everything the CLI then shows
# comes out of that file; nothing is recomputed here.
#
# THE RESPONSE FILE IS THE ANSWER, NOT hs's EXIT. Measured 16 Oct 2026 on this
# machine: hs -c sometimes never returned after the module had finished and
# written its response, -t notwithstanding. The cause was stdin (below); the
# file is still the answer, because the next hang will have another cause. So the wait ends at whichever comes
# first -- the response appearing (the module renames it into place whole), hs
# exiting, or the deadline -- and an hs still running once the response is
# there is stopped. Refuses, exit 2, when hs is absent, when it exits without a
# response, when it does not answer in time, or when the engine reports an
# error.
#
# Usage: engine_call <verb> [<desk file>] [<options JSON file>]
ENGINE_RESPONSE=""
engine_call() {
  local verb="$1" desk_file="${2:-}" options_file="${3:-}" hs module timeout dir request response out rc deadline
  hs="$(command -v hs)" || refuse "the hs tool is not on PATH: arngz reaches Hammerspoon through it (utilz doctor reports it; arngz init --yes installs it)"
  module="$(engine_module)"
  timeout="$(engine_timeout)"
  dir="$(mktemp -d "${TMPDIR:-/tmp}/arngz.XXXXXX")"
  request="$dir/request.json"
  response="$dir/response.json"
  out="$dir/hs.out"
  # The paths go into a Lua string literal, so a quote or backslash in one
  # would end the literal early. Refuse rather than escape.
  case "$module$request" in
    *'"'* | *\\*) refuse "a path holds a quote or backslash, which cannot go into the hs call: $module, $request" ;;
  esac

  if [[ -z "$options_file" ]]; then
    options_file="$dir/options.json"
    printf '{}\n' >"$options_file"
  fi
  if [[ -n "$desk_file" ]]; then
    V="$verb" D="$desk_file" O="$options_file" yq -n -o json \
      '.verb = strenv(V) | .desk = load(strenv(D)) | .options = load(strenv(O))' >"$request"
  else
    V="$verb" O="$options_file" yq -n -o json '.verb = strenv(V) | .desk = null | .options = load(strenv(O))' >"$request"
  fi

  # STDIN FROM /dev/null, ALWAYS: hs reads Lua from stdin when stdin is not a
  # terminal, so under any caller whose stdin stays open it waits for input
  # that never comes. Measured 16 Oct 2026: 3 of 3 hung with stdin an open
  # pipe, 3 of 3 returned at once from /dev/null (the cause vc and dc found).
  # The response-file wait below stays as the defence against the next hang.
  "$hs" -a -t "$timeout" -c "return dofile(\"$module\").run(\"$request\")" </dev/null >"$out" 2>&1 &
  local pid=$!
  deadline=$((SECONDS + timeout))
  while [[ ! -f "$response" ]] && kill -0 "$pid" 2>/dev/null && [[ $SECONDS -lt $deadline ]]; do
    sleep 0.1
  done

  if [[ -f "$response" ]]; then
    if kill -0 "$pid" 2>/dev/null; then
      kill "$pid" 2>/dev/null || true
    fi
    wait "$pid" 2>/dev/null || true
  elif kill -0 "$pid" 2>/dev/null; then
    kill "$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
    refuse "hs did not answer within ${timeout}s and wrote no response (request kept at $request)"
  else
    rc=0
    wait "$pid" || rc=$?
    case "$rc" in
      69) refuse "hs could not reach Hammerspoon (exit 69): it is not running, or hs.ipc is not loaded in ~/.hammerspoon/init.lua" ;;
      75) refuse "Hammerspoon is not running (hs exit 75)" ;;
      65) refuse "the engine raised a Lua error (hs exit 65): $(tr '\n' ' ' <"$out")" ;;
      *) refuse "hs exited $rc and wrote no response: $(tr '\n' ' ' <"$out") (request kept at $request)" ;;
    esac
  fi

  local status
  status="$(yq -r '.status' "$response" 2>/dev/null)" || refuse "the engine's response is not JSON: $response"
  if [[ "$status" != "ok" ]]; then
    refuse "the engine refused $verb: $(yq -r '.error' "$response")"
  fi
  ENGINE_RESPONSE="$response"
}

# The engine's report, line for line, as the engine wrote it.
render_report() {
  yq -r '.report[]' "$1"
}

# The engine's desk as YAML, in the desk's own key order. The order is set
# here, by naming every key, because the engine's JSON comes from Lua tables,
# which have none: the same world must print the same bytes (AC-04.1). Keys a
# desk does not carry are left out rather than printed as null. No -P: it
# would override the flow style `match` takes, as in the design's example.
render_desk() {
  yq -o yaml '.desk | {
    "desk": .desk,
    "grid": .grid,
    "displays": [(.displays // [])[] | {
      "name": .name,
      "match": ({"uuid": .match.uuid, "name": .match.name, "size": .match.size, "position": .match.position}
        | with_entries(select(.value != null))),
      "spaces": [(.spaces // [])[] | {
        "apps": [(.apps // [])[] | ({"app": .app, "window": .window, "layout": .layout, "misfit": .misfit}
          | with_entries(select(.value != null)))]
      }]
    }]
  } | .displays[].match style="flow"' "$1"
}

# ============================================================================
# VERBS
# ============================================================================

# One desk argument and no options, for the verbs that take exactly that.
one_desk() {
  local verb="$1"
  shift
  if [[ $# -ne 1 || "$1" == -* ]]; then
    refuse "$verb takes one desk name: arngz $verb <desk>"
  fi
  printf '%s\n' "$1"
}

cmd_list() {
  if [[ $# -gt 0 ]]; then
    refuse "list takes no arguments: '$1'"
  fi
  local dir name file width=0 status=0
  dir="$(catalogue_dir)"
  if [[ ! -d "$dir" ]]; then
    info "no catalogue at $dir (arngz init creates it)"
    return 0
  fi
  local names=()
  for file in "$dir"/*.yaml; do
    if [[ -f "$file" ]]; then
      name="$(basename "$file" .yaml)"
      names+=("$name")
      if [[ ${#name} -gt $width ]]; then width=${#name}; fi
    fi
  done
  if [[ ${#names[@]} -eq 0 ]]; then
    info "no desks in $dir (arngz discover --save <desk> records one)"
    return 0
  fi
  for name in "${names[@]}"; do
    if validate_desk "$name" 2>/dev/null; then
      printf "%-${width}s  %s\n" "$name" "$(desk_counts "$(desk_file "$name")")"
    else
      printf "%-${width}s  invalid: arngz show %s names why\n" "$name" "$name"
      status=1
    fi
  done
  return "$status"
}

cmd_show() {
  local desk
  desk="$(one_desk show "$@")"
  validate_desk "$desk" || exit 2
  cat "$(desk_file "$desk")"
}

# Delete judges the NAME and that the file exists, and deliberately not its
# content: a desk that no longer validates is exactly the one you want to be
# able to remove.
cmd_delete() {
  local desk file reason
  desk="$(one_desk delete "$@")"
  file="$(desk_file "$desk")"
  if reason="$(desk_name_refusal "$desk")"; then
    refuse "desk '$desk' ($file): $reason"
  fi
  if [[ ! -f "$file" ]]; then
    refuse "desk '$desk' does not exist: no $file"
  fi
  rm -- "$file"
  printf 'deleted %s\n' "$file"
}

cmd_init() {
  local dir
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --yes) shift ;;
      *) refuse "unknown option for init: '$1'" ;;
    esac
  done
  dir="$(catalogue_dir)"
  if [[ -d "$dir" ]]; then
    printf 'catalogue: %s (exists)\n' "$dir"
  else
    mkdir -p "$dir"
    printf 'catalogue: %s (created)\n' "$dir"
  fi
  printf 'Hammerspoon setup: not yet: WP-06\n'
}

cmd_apply() {
  local desk=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run | --no-launch | --no-create | --bind) shift ;;
      --map)
        if [[ $# -lt 2 ]]; then refuse "--map takes <name>=<uuid>"; fi
        shift 2
        ;;
      --map=*) shift ;;
      -*) refuse "unknown option for apply: '$1'" ;;
      *)
        if [[ -n "$desk" ]]; then refuse "apply takes one desk, not '$desk' and '$1'"; fi
        desk="$1"
        shift
        ;;
    esac
  done
  if [[ -z "$desk" ]]; then refuse "apply takes a desk: arngz apply <desk>"; fi
  validate_desk "$desk" || exit 2
  refuse "apply: not yet: WP-05"
}

# diff: what apply would do, one line per op with its reason, and nothing done.
# The engine plans and never executes on this path. Exit 1 when apply would
# change anything, 0 when it would not.
cmd_diff() {
  local desk ops
  desk="$(one_desk diff "$@")"
  validate_desk "$desk" || exit 2
  engine_call plan "$(desk_file "$desk")"
  render_report "$ENGINE_RESPONSE"
  ops="$(yq '.ops | length' "$ENGINE_RESPONSE")"
  rm -rf "$(dirname "$ENGINE_RESPONSE")"
  if [[ "$ops" -gt 0 ]]; then
    exit 1
  fi
}

# discover: the arrangement on screen now, as a desk (WP-04). The engine
# observes and builds the desk; this prints it as YAML, or saves it after the
# validator has accepted it. Everything the engine did not record is said on
# stderr, so stdout is the desk alone.
cmd_discover() {
  local save="" force=0 grid="8x4" dir options yaml target reason
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force) force=1; shift ;;
      --save)
        if [[ $# -lt 2 ]]; then refuse "--save takes a desk name"; fi
        save="$2"
        shift 2
        ;;
      --save=*) save="${1#--save=}"; shift ;;
      --grid)
        if [[ $# -lt 2 ]]; then refuse "--grid takes WxH, eg 8x4"; fi
        grid="$2"
        shift 2
        ;;
      --grid=*) grid="${1#--grid=}"; shift ;;
      *) refuse "unknown option for discover: '$1'" ;;
    esac
  done
  if [[ ! "$grid" =~ ^[1-9][0-9]*x[1-9][0-9]*$ ]]; then
    refuse "--grid = '$grid': a grid is WxH, eg 8x4"
  fi
  if [[ $force -eq 1 && -z "$save" ]]; then
    refuse "--force only means something with --save <desk>"
  fi
  if [[ -n "$save" ]]; then
    target="$(desk_file "$save")"
    if reason="$(desk_name_refusal "$save")"; then
      refuse "desk '$save' ($target): $reason"
    fi
    if [[ -e "$target" && $force -eq 0 ]]; then
      refuse "desk '$save' exists: $target (--force overwrites it)"
    fi
  fi

  dir="$(mktemp -d "${TMPDIR:-/tmp}/arngz-discover.XXXXXX")"
  options="$dir/options.json"
  G="$grid" N="${save:-discovered}" yq -n -o json '.grid = strenv(G) | .name = strenv(N)' >"$options"
  engine_call discover "" "$options"
  yaml="$dir/desk.yaml"
  render_desk "$ENGINE_RESPONSE" >"$yaml"
  render_report "$ENGINE_RESPONSE" >&2
  # What discover writes, the validator must accept: a refusal here is a bug in
  # discover, and it is said rather than saved.
  validate_desk_file "${save:-discovered}" "$yaml" || refuse "discover built a desk the validator refuses (kept at $yaml)"
  rm -rf "$(dirname "$ENGINE_RESPONSE")"

  if [[ -z "$save" ]]; then
    cat "$yaml"
  else
    mkdir -p "$(catalogue_dir)"
    mv -- "$yaml" "$target"
    info "saved $target"
  fi
  rm -rf "$dir"
}

cmd_doctor() {
  refuse "doctor: not yet: WP-06"
}

# ============================================================================
# MAIN
# ============================================================================

main() {
  if [[ $# -eq 0 ]]; then
    usage >&2
    exit 2
  fi
  local verb="$1"
  shift
  case "$verb" in
    -h | --help)
      usage
      ;;
    list) cmd_list "$@" ;;
    show) cmd_show "$@" ;;
    delete) cmd_delete "$@" ;;
    init) cmd_init "$@" ;;
    apply) cmd_apply "$@" ;;
    diff) cmd_diff "$@" ;;
    discover) cmd_discover "$@" ;;
    doctor) cmd_doctor "$@" ;;
    -*) refuse "unknown option: '$verb' (arngz --help names the verbs)" ;;
    *) cmd_apply "$verb" "$@" ;;
  esac
}

require_yq || exit 2
main "$@"

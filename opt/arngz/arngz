#!/usr/bin/env bash
#
# arngz - Named window arrangements (desks) across displays and spaces
#
# ST0026. This file is the CLI half: it parses, reads and validates desks,
# asks the engine through the hs tool, and renders. The engine half is a Lua
# module Hammerspoon loads (lib/arngz.lua). doctor and init also read the
# machine itself, so they work with no Hammerspoon at all. A verb not built yet
# exists anyway and says which work package builds it, so the CLI's surface is
# complete and a caller learns what is missing by name.
#

set -euo pipefail

# Source common functions if not already loaded (from dispatcher)
if [[ "$(type -t info 2>/dev/null)" != "function" ]]; then
  SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  UTILZ_HOME="${UTILZ_HOME:-$(cd "$SCRIPT_DIR/../.." && pwd)}"

  if [[ -f "$UTILZ_HOME/opt/utilz/lib/common.sh" ]]; then
    source "$UTILZ_HOME/opt/utilz/lib/common.sh"
  else
    echo "ERROR: Cannot find common.sh library" >&2
    exit 1
  fi
fi

# Every verb. A desk may not take one of these names (design.md, the
# validator's seventh condition; AC-05.7), because `arngz <desk>` is apply and
# a desk called `list` could never be applied that way.
ARNGZ_VERBS="apply discover diff list show delete init doctor"

# ============================================================================
# USAGE
# ============================================================================

usage() {
  cat <<EOF
Usage: arngz <desk>
       arngz <verb> [ARGS]

Named window arrangements (desks) across displays and spaces.

VERBS:
  <desk>                     the same as apply <desk>
  apply <desk> [--dry-run] [--no-launch] [--no-create] [--bind] [--map <name>=<uuid>]
                             arrange this machine's windows as the desk says
  discover [--grid WxH] [--save <desk>] [--force]
                             print the arrangement on screen now as a desk
  diff <desk>                print what apply would do, and change nothing
  list                       the desks in the catalogue, with display and app counts
  show <desk>                the desk, validated, as stored
  delete <desk>              remove a desk from the catalogue
  init [--yes]               create the catalogue, and report what Hammerspoon needs
  doctor                     every precondition, each with its state

The catalogue is \${XDG_CONFIG_HOME:-\$HOME/.config}/arngz/desks/<desk>.yaml.

For detailed help, run: utilz help arngz
EOF
}

# ============================================================================
# THE CATALOGUE
# ============================================================================

catalogue_dir() {
  printf '%s/arngz/desks\n' "${XDG_CONFIG_HOME:-$HOME/.config}"
}

desk_file() {
  printf '%s/%s.yaml\n' "$(catalogue_dir)" "$1"
}

# A refusal, in the one shape every one of them takes: what refused, and exit 2
# because nothing has changed.
refuse() {
  error "arngz: $*"
  exit 2
}

# The one place a desk NAME is judged. A verb name is the design's seventh
# condition. A name that is not a plain file name is refused too, because it
# is joined onto the catalogue path and `show ../x` must not read outside it.
desk_name_refusal() {
  local name="$1" verb
  for verb in $ARNGZ_VERBS; do
    if [[ "$name" == "$verb" ]]; then
      printf "desk name = '%s': a desk may not be named like a verb (%s)" "$name" "${ARNGZ_VERBS// /, }"
      return 0
    fi
  done
  if [[ ! "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
    printf "desk name = '%s': a desk name is letters, digits, '.', '_' and '-', starting with a letter or digit" "$name"
    return 0
  fi
  return 1
}

# ============================================================================
# THE VALIDATOR
# ============================================================================

# Flatten a desk into one line per fact, from ONE yq pass:
#   K <tab> map-path <tab> key     every key of every mapping
#   V <tab> path <tab> value       every scalar, newlines escaped
#   T <tab> path <tab> tag         every mapping and sequence
# Paths are yq's, dot-joined with numeric indexes ("displays.0.name"). The
# validator and the counts both read this, so there is one parse of a desk.
desk_facts() {
  # shellcheck disable=SC2016 # a yq program: its $p is yq's variable, not the shell's
  yq -r '
    (.. | select(tag == "!!map") | path as $p | keys[] | "K\t" + ($p | map(tostring) | join(".")) + "\t" + .),
    (.. | select(tag != "!!map" and tag != "!!seq") | "V\t" + (path | map(tostring) | join(".")) + "\t" + (. | tostring | sub("\n"; "\\n"))),
    (.. | select(tag == "!!map" or tag == "!!seq") | "T\t" + (path | map(tostring) | join(".")) + "\t" + tag)
  ' "$1"
}

# The desk schema's rules, over desk_facts. PURE: it reads facts on stdin and
# prints one refusal per line, "path US value US reason" (US is the ASCII unit
# separator, 0x1f, which `read` never merges the way it merges empty tab
# fields), in the order
# found; no output means the desk is valid. Every condition in design.md's
# "The config" is here, plus the shape checks they rest on (a list where a list
# belongs, an app entry that names its app, a layout that is present).
# shellcheck disable=SC2016 # an awk program: its $1, $2 and $3 are awk's fields
DESK_RULES='
function human(p,   out) {
  out = p
  while (match(out, /\.[0-9]+/)) {
    out = substr(out, 1, RSTART - 1) "[" substr(out, RSTART + 1, RLENGTH - 1) "]" substr(out, RSTART + RLENGTH)
  }
  return out
}
function shape(p) { gsub(/\.[0-9]+/, "[]", p); return p }
function refuse(p, v, why) { printf "%s\037%s\037%s\n", (p == "" ? "(top)" : human(p)), v, why }
BEGIN {
  FS = "\t"
  allowed["|desk"] = allowed["|grid"] = allowed["|displays"] = 1
  allowed["displays[]|name"] = allowed["displays[]|match"] = allowed["displays[]|spaces"] = 1
  allowed["displays[].match|uuid"] = allowed["displays[].match|name"] = 1
  allowed["displays[].match|size"] = allowed["displays[].match|position"] = 1
  allowed["displays[].spaces[]|name"] = allowed["displays[].spaces[]|apps"] = 1
  allowed["displays[].spaces[].apps[]|app"] = allowed["displays[].spaces[].apps[]|window"] = 1
  allowed["displays[].spaces[].apps[]|layout"] = 1
  # How far discover found a window from its cells (ST0026 WP-04); the
  # planner ignores it.
  allowed["displays[].spaces[].apps[]|misfit"] = 1
  want[""] = "!!map"; want["displays"] = "!!seq"; want["displays[]"] = "!!map"
  want["displays[].match"] = "!!map"; want["displays[].spaces"] = "!!seq"
  want["displays[].spaces[]"] = "!!map"; want["displays[].spaces[].apps"] = "!!seq"
  want["displays[].spaces[].apps[]"] = "!!map"
}
$1 == "K" {
  if (!((shape($2) "|" $3) in allowed)) unknown[++nu] = ($2 == "" ? $3 : $2 "." $3)
  next
}
$1 == "T" {
  tags[$2] = $3; norder[++n] = $2
  next
}
$1 == "V" {
  val[$2] = $3
  if (shape($2) in want) refuse($2, $3, "expected " (want[shape($2)] == "!!seq" ? "a list" : "a mapping"))
  next
}
END {
  if (!("" in tags)) { refuse("", "", "a desk is a mapping with desk, grid and displays"); exit }
  for (i = 1; i <= nu; i++) {
    u = unknown[i]
    refuse(u, (u in val ? val[u] : (u in tags ? tags[u] : "")), "unknown key")
  }
  for (i = 1; i <= n; i++) {
    p = norder[i]
    if ((shape(p) in want) && tags[p] != want[shape(p)])
      refuse(p, tags[p], "expected " (want[shape(p)] == "!!seq" ? "a list" : "a mapping"))
  }

  gw = 0; gh = 0
  if (!("grid" in val)) refuse("grid", "(absent)", "a desk declares its grid as WxH, eg 12x8")
  else if (val["grid"] !~ /^[1-9][0-9]*x[1-9][0-9]*$/) refuse("grid", val["grid"], "a grid is WxH, eg 12x8")
  else { split(val["grid"], g, "x"); gw = g[1] + 0; gh = g[2] + 0 }

  for (i = 1; i <= n; i++) {
    p = norder[i]
    if (shape(p) == "displays[]" && tags[p] == "!!map") {
      if ((p ".name") in val) {
        nm = val[p ".name"]
        if (nm in display_named) refuse(p ".name", nm, "two displays named " nm ": " human(display_named[nm]) " already has that name")
        else display_named[nm] = p
      }
      m = p ".match"
      if (!((m ".uuid") in val) && !((m ".name") in val)) {
        keys = ""
        for (k in val) if (index(k, m ".") == 1) keys = keys (keys == "" ? "" : ", ") substr(k, length(m) + 2)
        refuse(m, (keys == "" ? "(absent)" : keys), "a display must match by uuid or name")
      }
    }
    if (shape(p) == "displays[].spaces[].apps[]" && tags[p] == "!!map" && ((p ".misfit") in val) && val[p ".misfit"] !~ /^[0-9]+px$/)
      refuse(p ".misfit", val[p ".misfit"], "a misfit is a whole number of points, eg 3px")
    if (shape(p) == "displays[].spaces[].apps[]" && tags[p] == "!!map") {
      split(p, parts, ".")
      disp = parts[1] "." parts[2]
      if (!((p ".app") in val)) refuse(p ".app", "(absent)", "an app entry names its bundle id")
      else {
        a = val[p ".app"]
        key = disp SUBSEP a
        count[key]++
        if (count[key] == 1) first[key] = p
        if (!((p ".window") in val)) bare[key] = 1
        if (count[key] == 2) second[key] = p
      }
      if (!((p ".layout") in val)) refuse(p ".layout", "(absent)", "a layout is x,y wxh in the grid, or fullscreen")
      else {
        l = val[p ".layout"]
        if (l == "fullscreen") { }
        else if (l !~ /^[0-9]+,[0-9]+ [1-9][0-9]*x[1-9][0-9]*$/) refuse(p ".layout", l, "a layout is x,y wxh in the grid, or fullscreen")
        else if (gw > 0) {
          split(l, lp, /[, x]/)
          if (lp[1] + lp[3] > gw || lp[2] + lp[4] > gh) refuse(p ".layout", l, "outside the " gw "x" gh " grid")
        }
      }
    }
  }
  for (key in count) {
    if (count[key] > 1 && (key in bare)) {
      split(key, ka, SUBSEP)
      refuse(second[key] ".app", ka[2], "also at " human(first[key]) "; the same app twice on one display needs a window pattern on every entry")
    }
  }
}
'

# THE validator: every verb that reads a desk calls this before anything else
# (design.md, "The config"). Prints every refusal, each naming the desk, its
# file, the path and the value, and returns 2; returns 0 for a valid desk.
validate_desk() {
  local desk="$1" file reason
  file="$(desk_file "$desk")"

  if reason="$(desk_name_refusal "$desk")"; then
    error "arngz: desk '$desk' ($file): $reason"
    return 2
  fi
  if [[ ! -f "$file" ]]; then
    error "arngz: desk '$desk' does not exist: no $file (arngz list names the desks there are)"
    return 2
  fi
  validate_desk_file "$desk" "$file"
}

# The schema half of the validator, for a desk file anywhere: discover checks
# what it is about to save before the file reaches the catalogue.
validate_desk_file() {
  local desk="$1" file="$2" facts refusals path value why
  if ! facts="$(desk_facts "$file" 2>&1)"; then
    error "arngz: desk '$desk' ($file) is not YAML yq can read: $facts"
    return 2
  fi
  refusals="$(printf '%s\n' "$facts" | awk "$DESK_RULES")"
  if [[ -z "$refusals" ]]; then
    return 0
  fi
  while IFS=$'\037' read -r path value why; do
    if [[ -n "$value" ]]; then
      error "arngz: desk '$desk' ($file): $path = '$value': $why"
    else
      error "arngz: desk '$desk' ($file): $path: $why"
    fi
  done <<<"$refusals"
  return 2
}

# "N display(s)  M app(s)" for a desk already validated.
desk_counts() {
  local facts displays apps
  facts="$(desk_facts "$1")"
  displays=$(printf '%s\n' "$facts" | awk -F'\t' '$1 == "T" && $2 ~ /^displays\.[0-9]+$/ { c++ } END { print c + 0 }')
  apps=$(printf '%s\n' "$facts" | awk -F'\t' '$1 == "T" && $2 ~ /^displays\.[0-9]+\.spaces\.[0-9]+\.apps\.[0-9]+$/ { c++ } END { print c + 0 }')
  printf '%d display%s  %d app%s\n' "$displays" "$([[ $displays -eq 1 ]] || echo s)" "$apps" "$([[ $apps -eq 1 ]] || echo s)"
}

# ============================================================================
# THE ENGINE CONTRACT (design.md "The engine", D17)
# ============================================================================

# The Lua module Hammerspoon loads, beside this script.
engine_module() {
  printf '%s/opt/arngz/lib/arngz.lua\n' "$UTILZ_HOME"
}

# How long one engine call may take, in seconds. ARNGZ_HS_TIMEOUT overrides it,
# which is how the suite makes a call that never answers fail in one second
# rather than sixty.
engine_timeout() {
  local t="${ARNGZ_HS_TIMEOUT:-60}"
  if [[ ! "$t" =~ ^[1-9][0-9]*$ ]]; then
    refuse "ARNGZ_HS_TIMEOUT = '$t': a whole number of seconds"
  fi
  printf '%s\n' "$t"
}

# Ask the engine one thing. Writes {verb, desk, options} to a request file in
# a fresh temp dir, runs `hs -c 'return dofile(<module>).run(<request>)'`, and
# leaves the response's path in ENGINE_RESPONSE. Everything the CLI then shows
# comes out of that file; nothing is recomputed here.
#
# THE RESPONSE FILE IS THE ANSWER, NOT hs's EXIT. Measured 16 Oct 2026 on this
# machine: hs -c sometimes never returned after the module had finished and
# written its response, -t notwithstanding. The cause was stdin (below); the
# file is still the answer, because the next hang will have another cause. So
# the wait ends at whichever comes first -- the response appearing (the module
# renames it into place whole), hs exiting, or the deadline -- and an hs still
# running once the response is there is stopped.
#
# It NEVER EXITS, so doctor can say what failed and go on; engine_call is the
# form that refuses. It returns
#   0  the engine answered ok, and its response is ENGINE_RESPONSE
#   1  nothing answered: hs could not reach Hammerspoon, exited without a
#      response, or did not answer in time
#   2  nothing was asked: there is no hs, or the request could not be made
#   3  the engine answered with an error: an error response, a response that
#      is not JSON, or a Lua error raised inside it (hs exit 65)
# with why in ENGINE_ERROR for each but 0. ENGINE_DIR is the request's temp
# dir whenever one was made, for the caller to keep or remove. A bad
# ARNGZ_HS_TIMEOUT is still refused outright, because that is the caller's
# mistake, not the engine's.
#
# Usage: engine_ask <verb> [<desk file>] [<options JSON file>]
ENGINE_RESPONSE=""
ENGINE_ERROR=""
ENGINE_DIR=""
engine_ask() {
  local verb="$1" desk_file="${2:-}" options_file="${3:-}" hs module timeout request response out rc deadline
  ENGINE_RESPONSE=""
  ENGINE_ERROR=""
  ENGINE_DIR=""
  if ! hs="$(command -v hs)"; then
    ENGINE_ERROR="the hs tool is not on PATH: arngz reaches Hammerspoon through it (arngz doctor reports it; arngz init --yes installs it)"
    return 2
  fi
  module="$(engine_module)"
  timeout="$(engine_timeout)" || exit 2
  if ! ENGINE_DIR="$(mktemp -d "${TMPDIR:-/tmp}/arngz.XXXXXX")"; then
    ENGINE_DIR=""
    ENGINE_ERROR="could not make a temp dir under ${TMPDIR:-/tmp} for the request"
    return 2
  fi
  request="$ENGINE_DIR/request.json"
  response="$ENGINE_DIR/response.json"
  out="$ENGINE_DIR/hs.out"
  # The paths go into a Lua string literal, so a quote or backslash in one
  # would end the literal early. Refuse rather than escape.
  case "$module$request" in
    *'"'* | *\\*)
      ENGINE_ERROR="a path holds a quote or backslash, which cannot go into the hs call: $module, $request"
      return 2
      ;;
  esac

  if [[ -z "$options_file" ]]; then
    options_file="$ENGINE_DIR/options.json"
    if ! printf '{}\n' >"$options_file"; then
      ENGINE_ERROR="could not write the request's options to $options_file"
      return 2
    fi
  fi
  rc=0
  if [[ -n "$desk_file" ]]; then
    V="$verb" D="$desk_file" O="$options_file" yq -n -o json \
      '.verb = strenv(V) | .desk = load(strenv(D)) | .options = load(strenv(O))' >"$request" || rc=$?
  else
    V="$verb" O="$options_file" yq -n -o json '.verb = strenv(V) | .desk = null | .options = load(strenv(O))' >"$request" || rc=$?
  fi
  if [[ $rc -ne 0 ]]; then
    ENGINE_ERROR="could not write the request for $verb (yq exited $rc): $request"
    return 2
  fi

  # STDIN FROM /dev/null, ALWAYS: hs reads Lua from stdin when stdin is not a
  # terminal, so under any caller whose stdin stays open it waits for input
  # that never comes. Measured 16 Oct 2026: 3 of 3 hung with stdin an open
  # pipe, 3 of 3 returned at once from /dev/null (the cause vc and dc found).
  # The response-file wait below stays as the defence against the next hang.
  "$hs" -a -t "$timeout" -c "return dofile(\"$module\").run(\"$request\")" </dev/null >"$out" 2>&1 &
  local pid=$!
  deadline=$((SECONDS + timeout))
  while [[ ! -f "$response" ]] && kill -0 "$pid" 2>/dev/null && [[ $SECONDS -lt $deadline ]]; do
    sleep 0.1
  done

  if [[ -f "$response" ]]; then
    if kill -0 "$pid" 2>/dev/null; then
      kill "$pid" 2>/dev/null || true
    fi
    wait "$pid" 2>/dev/null || true
  elif kill -0 "$pid" 2>/dev/null; then
    kill "$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
    ENGINE_ERROR="hs did not answer within ${timeout}s and wrote no response"
    return 1
  else
    rc=0
    wait "$pid" || rc=$?
    case "$rc" in
      # The module ran and failed, so Hammerspoon did answer.
      65)
        ENGINE_ERROR="the engine raised a Lua error (hs exit 65): $(tr '\n' ' ' <"$out")"
        return 3
        ;;
      69) ENGINE_ERROR="hs could not reach Hammerspoon (exit 69): it is not running, or its config does not load hs.ipc (arngz init --yes adds it)" ;;
      75) ENGINE_ERROR="Hammerspoon is not running (hs exit 75)" ;;
      *) ENGINE_ERROR="hs exited $rc and wrote no response: $(tr '\n' ' ' <"$out")" ;;
    esac
    return 1
  fi

  ENGINE_RESPONSE="$response"
  local status
  if ! status="$(yq -r '.status' "$response" 2>"$ENGINE_DIR/yq.err")"; then
    ENGINE_ERROR="the engine's response is not JSON: $(tr '\n' ' ' <"$ENGINE_DIR/yq.err")"
    return 3
  fi
  if [[ "$status" != "ok" ]]; then
    ENGINE_ERROR="the engine refused $verb: $(yq -r '.error' "$response")"
    return 3
  fi
}

# engine_ask, refused by name, exit 2, unless the engine answered ok, with the
# request kept for a look. The form every verb that needs the engine's answer
# calls.
engine_call() {
  local rc=0
  engine_ask "$@" || rc=$?
  if [[ $rc -ne 0 ]]; then
    refuse "$ENGINE_ERROR${ENGINE_DIR:+ (request kept at $ENGINE_DIR/request.json)}"
  fi
}

# The engine's report, line for line, as the engine wrote it.
render_report() {
  yq -r '.report[]' "$1"
}

# The engine's desk as YAML, in the desk's own key order. The order is set
# here, by naming every key, because the engine's JSON comes from Lua tables,
# which have none: the same world must print the same bytes (AC-04.1). Keys a
# desk does not carry are left out rather than printed as null. No -P: it
# would override the flow style `match` takes, as in the design's example.
render_desk() {
  yq -o yaml '.desk | {
    "desk": .desk,
    "grid": .grid,
    "displays": [(.displays // [])[] | {
      "name": .name,
      "match": ({"uuid": .match.uuid, "name": .match.name, "size": .match.size, "position": .match.position}
        | with_entries(select(.value != null))),
      "spaces": [(.spaces // [])[] | {
        "apps": [(.apps // [])[] | ({"app": .app, "window": .window, "layout": .layout, "misfit": .misfit}
          | with_entries(select(.value != null)))]
      }]
    }]
  } | .displays[].match style="flow"' "$1"
}

# ============================================================================
# THE MACHINE: what doctor reads and init provides (D16, D18)
# ============================================================================

# Hammerspoon's bundle id, as arngz.yaml declares it for utilz doctor, its
# process name, as pgrep finds it, and how it is installed.
HAMMERSPOON_BUNDLE="org.hammerspoon.Hammerspoon"
HAMMERSPOON_PROCESS="Hammerspoon"
HAMMERSPOON_INSTALL="brew install --cask hammerspoon"

# The one line init appends to Hammerspoon's config, marked as arngz's.
IPC_LINE='require("hs.ipc") -- arngz (Utilz ST0026): IPC for the hs command-line tool'

# Where init links the hs tool: /opt/homebrew (D16), because /usr/local, the
# default of Hammerspoon's own hs.ipc.cliInstall, is root-owned on hv's
# machine. ARNGZ_HS_PREFIX overrides it, which is how the suite links into a
# fixture and never into the machine.
hs_prefix() {
  printf '%s\n' "${ARNGZ_HS_PREFIX:-/opt/homebrew}"
}

# Hammerspoon's config file: ~/.hammerspoon/init.lua, or the file its
# MJConfigFile preference names. Hammerspoon honours that preference, so init
# must too, or its line would go where Hammerspoon never reads it. Read like
# every other preference (read_pref), so a preference that could not be read
# is said, and fails, rather than guessed to be unset. With no defaults tool
# there are no Hammerspoon preferences, and the default stands.
hammerspoon_config() {
  local custom rc=0
  if command -v defaults >/dev/null 2>&1; then
    custom="$(read_pref "$HAMMERSPOON_BUNDLE" MJConfigFile)" || rc=$?
    if [[ $rc -eq 0 && -n "$custom" ]]; then
      expand_tilde "$custom"
      return 0
    fi
    if [[ $rc -ne 0 && $rc -ne 3 ]]; then
      printf "Hammerspoon's MJConfigFile preference, which says where its config is, could not be read: %s\n" "$custom"
      return 1
    fi
  fi
  printf '%s/.hammerspoon/init.lua\n' "$HOME"
}

# The hs tool, as doctor reports it and init acts on it, so the two cannot
# tell it differently. Prints "state|detail|fix", the state one of
#   ok        on PATH, where arngz looks; the detail is its path
#   unlisted  PREFIX/bin/hs runs, but PREFIX/bin is not on PATH
#   broken    PREFIX/bin/hs is there and does not run
#   absent    nowhere; init --yes links it
hs_tool_state() {
  local prefix="$1" hs
  if hs="$(command -v hs)"; then
    printf 'ok|%s|\n' "$hs"
  elif [[ -x "$prefix/bin/hs" ]]; then
    printf 'unlisted|%s/bin/hs is there, but %s/bin is not on PATH, where arngz looks for it|add %s/bin to PATH\n' "$prefix" "$prefix" "$prefix"
  elif [[ -e "$prefix/bin/hs" || -L "$prefix/bin/hs" ]]; then
    printf 'broken|%s/bin/hs is there and does not run (a link to a Hammerspoon that moved?)|remove it, and arngz init --yes links it again\n' "$prefix"
  else
    printf 'absent|not on PATH|arngz init --yes links it under %s\n' "$prefix"
  fi
}

# Whether a file can be made in DIR: DIR is a writable directory, or mkdir -p
# can make it, because its nearest existing ancestor is one. A link on the way
# that leads nowhere, as a dotfiles link does once its repository moves, makes
# mkdir -p fail too. Prints why not, and fails, when it cannot.
writable_dir() {
  local p="$1"
  while [[ ! -e "$p" ]]; do
    if [[ -L "$p" ]]; then
      printf '%s is a link that leads nowhere\n' "$p"
      return 1
    fi
    p="$(dirname "$p")"
  done
  if [[ ! -d "$p" ]]; then
    printf '%s is not a directory\n' "$p"
    return 1
  fi
  if [[ ! -w "$p" ]]; then
    printf '%s is not writable\n' "$p"
    return 1
  fi
}

# What init does about the hs tool, as one line, "kind|...":
#   have|PATH                  on PATH already
#   unlisted|DETAIL|FIX        under the prefix but not on PATH: for a person
#   block|WHY                  init --yes cannot provide it
#   link|TOOL|MAN|MAN_NOTE     init --yes links TOOL, and MAN when there is one
# It reads the machine and decides, and changes nothing. APP and APP_RC are
# what app_path said of Hammerspoon.
init_hs_plan() {
  local prefix="$1" app="$2" app_rc="$3" state detail fix why man="" man_note=""
  IFS='|' read -r state detail fix <<<"$(hs_tool_state "$prefix")"
  case "$state" in
    ok)
      printf 'have|%s\n' "$detail"
      return 0
      ;;
    unlisted)
      printf 'unlisted|%s|%s\n' "$detail" "$fix"
      return 0
      ;;
    broken)
      printf 'block|%s: %s\n' "$detail" "$fix"
      return 0
      ;;
  esac
  if [[ $app_rc -eq 1 ]]; then
    printf 'block|the hs tool comes with Hammerspoon, which is not installed: %s\n' "$HAMMERSPOON_INSTALL"
  elif [[ $app_rc -ne 0 ]]; then
    printf 'block|the hs tool comes with Hammerspoon, and where it is installed is unknown: %s\n' "$app"
  elif [[ ! -x "$app/Contents/Frameworks/hs/hs" ]]; then
    printf 'block|Hammerspoon at %s carries no hs tool at %s/Contents/Frameworks/hs/hs\n' "$app" "$app"
  elif ! why="$(writable_dir "$prefix/bin")"; then
    printf 'block|%s/bin/hs cannot be made: %s\n' "$prefix" "$why"
  else
    if [[ -f "$app/Contents/Resources/man/hs.man" && ! -e "$prefix/share/man/man1/hs.1" && ! -L "$prefix/share/man/man1/hs.1" ]]; then
      if why="$(writable_dir "$prefix/share/man/man1")"; then
        man="$app/Contents/Resources/man/hs.man"
      else
        man_note="; not its man page, because $why"
      fi
    fi
    printf 'link|%s|%s|%s\n' "$app/Contents/Frameworks/hs/hs" "$man" "$man_note"
  fi
}

# What init does about Hammerspoon's config, as one line, "kind|CONFIG|...":
#   have|CONFIG|LINE     it loads hs.ipc already, at LINE
#   append|CONFIG        init --yes appends the one line
#   block|CONFIG|WHY     init --yes cannot
# It reads the machine and decides, and changes nothing.
init_config_plan() {
  local config line why
  if ! config="$(hammerspoon_config)"; then
    printf "block|Hammerspoon's config|%s\n" "$config"
  elif [[ -L "$config" && ! -e "$config" ]]; then
    printf 'block|%s|%s is a link that leads nowhere\n' "$config" "$config"
  elif [[ -e "$config" && ! -f "$config" ]]; then
    printf 'block|%s|%s is not a file\n' "$config" "$config"
  elif [[ -e "$config" && ! -r "$config" ]]; then
    printf 'block|%s|%s cannot be read\n' "$config" "$config"
  elif [[ -f "$config" ]] && line="$(ipc_require_line "$config")" && [[ -n "$line" ]]; then
    printf 'have|%s|%s\n' "$config" "$line"
  elif [[ -e "$config" && ! -w "$config" ]]; then
    printf 'block|%s|%s is not writable\n' "$config" "$config"
  elif [[ ! -e "$config" ]] && ! why="$(writable_dir "$(dirname "$config")")"; then
    printf 'block|%s|%s cannot be made, because %s\n' "$config" "$config" "$why"
  else
    printf 'append|%s\n' "$config"
  fi
}

# The number of the first line of a Lua file that loads hs.ipc, or nothing. A
# require of "hs.ipc" in any of Lua's spellings counts, marked or not, because
# a person may have added it by hand (hv's own init.lua carries one, with a
# guarded cliInstall beside it); one after a -- on its line does not. A
# require inside a --[[ ]] block comment reads as loading it, and doctor's IPC
# check is what then says otherwise.
ipc_require_line() {
  awk -v re="require[ \t]*[(]?[ \t]*[\"']hs[.]ipc[\"']" \
    '{ code = $0; sub(/--.*/, "", code) } code ~ re { print NR; exit }' "$1"
}

# Link the hs tool, and its man page when there is one to link, under PREFIX,
# as hs.ipc.cliInstall links them (Hammerspoon 1.1.1, extensions/hs/ipc.lua):
# PREFIX/bin/hs to the app's Contents/Frameworks/hs/hs, and
# PREFIX/share/man/man1/hs.1 to its Contents/Resources/man/hs.man. Done here,
# because cliInstall runs inside Hammerspoon and so needs the very IPC this
# sets up.
link_hs_tool() {
  local prefix="$1" tool="$2" man="$3"
  mkdir -p "$prefix/bin" || refuse "could not make $prefix/bin"
  ln -s "$tool" "$prefix/bin/hs" || refuse "could not link $prefix/bin/hs to $tool"
  if [[ -n "$man" ]]; then
    mkdir -p "$prefix/share/man/man1" || refuse "could not make $prefix/share/man/man1"
    ln -s "$man" "$prefix/share/man/man1/hs.1" || refuse "could not link $prefix/share/man/man1/hs.1 to $man"
  fi
}

# Append IPC_LINE to Hammerspoon's config, in place, so a config that is a link
# into a dotfiles repository stays one. A last line with no newline is ended
# first, or the require would join it.
append_ipc_line() {
  local config="$1" parent
  parent="$(dirname "$config")"
  mkdir -p "$parent" || refuse "could not make $parent"
  if [[ -s "$config" && -n "$(tail -c 1 "$config")" ]]; then
    printf '\n' >>"$config" || refuse "could not append to $config"
  fi
  printf '%s\n' "$IPC_LINE" >>"$config" || refuse "could not append to $config"
}

# One macOS preference. Prints the value and returns 0; returns 3, printing
# nothing, when it is unset (no such key, or no such domain); prints why and
# returns 1 when it could not be read. defaults says an unset key's pair "does
# not exist" up to macOS 26; on 27 it says "Could not find key '<key>' in
# domain '<domain>'", or "Domain '<domain>' not found" for a domain with no
# preferences at all (all three measured 16 Oct 2026). Only those wordings,
# naming this key and domain, are unset; any other failure is said.
read_pref() {
  local domain="$1" key="$2" out rc=0
  if ! command -v defaults >/dev/null 2>&1; then
    printf 'there is no defaults tool to read it with (macOS only)\n'
    return 1
  fi
  out="$(defaults read "$domain" "$key" 2>&1 </dev/null)" || rc=$?
  if [[ $rc -eq 0 ]]; then
    printf '%s\n' "$out"
    return 0
  fi
  case "$out" in
    *"($domain, $key) does not exist"* | *"Could not find key '$key' in domain '$domain'"* | *"Domain '$domain' not found"*) return 3 ;;
  esac
  printf 'defaults read %s %s failed (exit %s): %s\n' "$domain" "$key" "$rc" "$(printf '%s' "$out" | tr '\n' ' ')"
  return 1
}

# The three settings doctor reads from macOS's preferences, one per line:
#   precondition|domain|key|value when unset|value arngz needs|state at 0|state at 1|fix
# spans-displays is 0 when each display has its own spaces, macOS's default.
DOCTOR_PREFS="separate spaces|com.apple.spaces|spans-displays|0|0|on|off|System Settings > Desktop & Dock > Mission Control: turn on Displays have separate Spaces, then log out and in
auto-rearrange|com.apple.dock|mru-spaces|1|0|off|on|System Settings > Desktop & Dock > Mission Control: turn off Automatically rearrange Spaces based on most recent use
Stage Manager|com.apple.WindowManager|GloballyEnabled|0|0|off|on|System Settings > Desktop & Dock: turn off Stage Manager"

# PURE: one preference's verdict, from what read_pref returned and printed,
# as "status|state|fix". An unset key takes macOS's default, and says so.
pref_verdict() {
  local rc="$1" value="$2" unset_value="$3" want="$4" at0="$5" at1="$6" fix="$7" note="" state
  case "$rc" in
    0) ;;
    3)
      value="$unset_value"
      note=" (unset: macOS's default)"
      ;;
    *)
      printf 'FAIL|unknown: %s|%s\n' "$value" "$fix"
      return 0
      ;;
  esac
  case "$value" in
    1 | true | YES) value=1 ;;
    0 | false | NO) value=0 ;;
    *)
      printf "FAIL|unknown: the value is '%s', not a boolean|%s\n" "$value" "$fix"
      return 0
      ;;
  esac
  if [[ "$value" == "1" ]]; then state="$at1"; else state="$at0"; fi
  if [[ "$value" == "$want" ]]; then
    printf 'ok|%s%s|\n' "$state" "$note"
  else
    printf 'FAIL|%s%s|%s\n' "$state" "$note" "$fix"
  fi
}

# One line of doctor's report: ok, FAIL or skip, the precondition, its state,
# and for one that does not hold what fixes it. Counts the lines and the ones
# that do not hold, a skipped check among them.
DOCTOR_LINES=0
DOCTOR_FAILED=0
doctor_line() {
  local status="$1" what="$2" state="$3" fix="${4:-}"
  DOCTOR_LINES=$((DOCTOR_LINES + 1))
  if [[ "$status" != "ok" ]]; then
    DOCTOR_FAILED=$((DOCTOR_FAILED + 1))
  fi
  if [[ -n "$fix" ]]; then
    printf '%-4s  %-15s  %s; fix: %s\n' "$status" "$what" "$state" "$fix"
  else
    printf '%-4s  %-15s  %s\n' "$status" "$what" "$state"
  fi
}

# ============================================================================
# VERBS
# ============================================================================

# One desk argument and no options, for the verbs that take exactly that.
one_desk() {
  local verb="$1"
  shift
  if [[ $# -ne 1 || "$1" == -* ]]; then
    refuse "$verb takes one desk name: arngz $verb <desk>"
  fi
  printf '%s\n' "$1"
}

cmd_list() {
  if [[ $# -gt 0 ]]; then
    refuse "list takes no arguments: '$1'"
  fi
  local dir name file width=0 status=0
  dir="$(catalogue_dir)"
  if [[ ! -d "$dir" ]]; then
    info "no catalogue at $dir (arngz init creates it)"
    return 0
  fi
  local names=()
  for file in "$dir"/*.yaml; do
    if [[ -f "$file" ]]; then
      name="$(basename "$file" .yaml)"
      names+=("$name")
      if [[ ${#name} -gt $width ]]; then width=${#name}; fi
    fi
  done
  if [[ ${#names[@]} -eq 0 ]]; then
    info "no desks in $dir (arngz discover --save <desk> records one)"
    return 0
  fi
  for name in "${names[@]}"; do
    if validate_desk "$name" 2>/dev/null; then
      printf "%-${width}s  %s\n" "$name" "$(desk_counts "$(desk_file "$name")")"
    else
      printf "%-${width}s  invalid: arngz show %s names why\n" "$name" "$name"
      status=1
    fi
  done
  return "$status"
}

cmd_show() {
  local desk
  desk="$(one_desk show "$@")"
  validate_desk "$desk" || exit 2
  cat "$(desk_file "$desk")"
}

# Delete judges the NAME and that the file exists, and deliberately not its
# content: a desk that no longer validates is exactly the one you want to be
# able to remove.
cmd_delete() {
  local desk file reason
  desk="$(one_desk delete "$@")"
  file="$(desk_file "$desk")"
  if reason="$(desk_name_refusal "$desk")"; then
    refuse "desk '$desk' ($file): $reason"
  fi
  if [[ ! -f "$file" ]]; then
    refuse "desk '$desk' does not exist: no $file"
  fi
  rm -- "$file"
  printf 'deleted %s\n' "$file"
}

# init: the catalogue, and what Hammerspoon needs for arngz (D16). Without
# --yes it creates the catalogue, says what --yes would do, and changes nothing
# else. With --yes it links the hs tool under the prefix, as Hammerspoon's own
# hs.ipc.cliInstall would, and appends the one marked line that loads hs.ipc
# to Hammerspoon's config. A step already done is said and skipped, so a
# second run changes nothing. Everything --yes would change is checked first,
# and what it cannot do is refused, exit 2, before anything changes; what only
# a person can do, it says.
cmd_init() {
  local yes=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --yes)
        yes=1
        shift
        ;;
      *) refuse "unknown option for init: '$1'" ;;
    esac
  done

  local dir prefix app app_rc=0 hs_kind hs_a hs_b hs_c config_kind config config_c blocked="" for_you=""
  dir="$(catalogue_dir)"
  prefix="$(hs_prefix)"
  app="$(app_path "$HAMMERSPOON_BUNDLE")" || app_rc=$?
  IFS='|' read -r hs_kind hs_a hs_b hs_c <<<"$(init_hs_plan "$prefix" "$app" "$app_rc")"
  IFS='|' read -r config_kind config config_c <<<"$(init_config_plan)"

  if [[ "$hs_kind" == block ]]; then
    blocked="$hs_a"
  fi
  if [[ "$config_kind" == block ]]; then
    blocked="${blocked:+$blocked; }$config_c"
  fi
  if [[ "$hs_kind" == unlisted ]]; then
    for_you="$hs_b"
  fi
  if [[ ("$hs_kind" == have || "$hs_kind" == unlisted) && $app_rc -eq 1 ]]; then
    for_you="${for_you:+$for_you; }install Hammerspoon itself: $HAMMERSPOON_INSTALL"
  fi
  if [[ $yes -eq 1 && -n "$blocked" ]]; then
    refuse "init --yes changed nothing: $blocked"
  fi

  if [[ -d "$dir" ]]; then
    printf 'catalogue: %s (exists)\n' "$dir"
  else
    mkdir -p "$dir"
    printf 'catalogue: %s (created)\n' "$dir"
  fi
  case "$app_rc" in
    0) printf 'Hammerspoon: installed at %s\n' "$app" ;;
    1) printf 'Hammerspoon: not installed: %s\n' "$HAMMERSPOON_INSTALL" ;;
    *) printf 'Hammerspoon: unknown: %s\n' "$app" ;;
  esac

  case "$hs_kind" in
    block) printf 'hs tool: cannot be linked: %s\n' "$hs_a" ;;
    link)
      if [[ $yes -eq 1 ]]; then
        link_hs_tool "$prefix" "$hs_a" "$hs_b"
        printf 'hs tool: linked %s/bin/hs to %s%s%s\n' "$prefix" "$hs_a" "${hs_b:+, and its man page}" "$hs_c"
      else
        printf 'hs tool: would link %s/bin/hs to %s%s%s\n' "$prefix" "$hs_a" "${hs_b:+, and its man page}" "$hs_c"
      fi
      ;;
    *) printf 'hs tool: %s\n' "$hs_a" ;;
  esac

  case "$config_kind" in
    have) printf 'init.lua: %s loads hs.ipc (line %s)\n' "$config" "$config_c" ;;
    block) printf 'init.lua: cannot be changed: %s\n' "$config_c" ;;
    append)
      if [[ $yes -eq 1 ]]; then
        append_ipc_line "$config"
        printf 'init.lua: appended to %s: %s\n' "$config" "$IPC_LINE"
      else
        printf 'init.lua: would append to %s: %s\n' "$config" "$IPC_LINE"
      fi
      ;;
  esac

  if [[ -n "$blocked" ]]; then
    printf 'init --yes cannot finish until this is fixed: %s\n' "$blocked"
  elif [[ "$hs_kind" == link || "$config_kind" == append ]]; then
    if [[ $yes -eq 0 ]]; then
      printf 'nothing else changed: arngz init --yes does what is marked would\n'
    elif [[ "$config_kind" == append ]]; then
      printf "reload Hammerspoon's config (its menu bar icon: Reload Config) so it loads hs.ipc, then run arngz doctor\n"
    else
      printf 'run arngz doctor to check every precondition\n'
    fi
  fi
  if [[ -n "$for_you" ]]; then
    printf 'still for you to do: %s\n' "$for_you"
  fi
  if [[ -z "$blocked" && -z "$for_you" && "$hs_kind" == have && "$config_kind" == have ]]; then
    printf 'Hammerspoon setup: nothing to do\n'
  fi
}

cmd_apply() {
  local desk=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run | --no-launch | --no-create | --bind) shift ;;
      --map)
        if [[ $# -lt 2 ]]; then refuse "--map takes <name>=<uuid>"; fi
        shift 2
        ;;
      --map=*) shift ;;
      -*) refuse "unknown option for apply: '$1'" ;;
      *)
        if [[ -n "$desk" ]]; then refuse "apply takes one desk, not '$desk' and '$1'"; fi
        desk="$1"
        shift
        ;;
    esac
  done
  if [[ -z "$desk" ]]; then refuse "apply takes a desk: arngz apply <desk>"; fi
  validate_desk "$desk" || exit 2
  refuse "apply: not yet: WP-05"
}

# diff: what apply would do, one line per op with its reason, and nothing done.
# The engine plans and never executes on this path. Exit 1 when apply would
# change anything, 0 when it would not.
cmd_diff() {
  local desk ops
  desk="$(one_desk diff "$@")"
  validate_desk "$desk" || exit 2
  engine_call plan "$(desk_file "$desk")"
  render_report "$ENGINE_RESPONSE"
  ops="$(yq '.ops | length' "$ENGINE_RESPONSE")"
  rm -rf "$(dirname "$ENGINE_RESPONSE")"
  if [[ "$ops" -gt 0 ]]; then
    exit 1
  fi
}

# discover: the arrangement on screen now, as a desk (WP-04). The engine
# observes and builds the desk; this prints it as YAML, or saves it after the
# validator has accepted it. Everything the engine did not record is said on
# stderr, so stdout is the desk alone.
cmd_discover() {
  local save="" force=0 grid="8x4" dir options yaml target reason
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force) force=1; shift ;;
      --save)
        if [[ $# -lt 2 ]]; then refuse "--save takes a desk name"; fi
        save="$2"
        shift 2
        ;;
      --save=*) save="${1#--save=}"; shift ;;
      --grid)
        if [[ $# -lt 2 ]]; then refuse "--grid takes WxH, eg 8x4"; fi
        grid="$2"
        shift 2
        ;;
      --grid=*) grid="${1#--grid=}"; shift ;;
      *) refuse "unknown option for discover: '$1'" ;;
    esac
  done
  if [[ ! "$grid" =~ ^[1-9][0-9]*x[1-9][0-9]*$ ]]; then
    refuse "--grid = '$grid': a grid is WxH, eg 8x4"
  fi
  if [[ $force -eq 1 && -z "$save" ]]; then
    refuse "--force only means something with --save <desk>"
  fi
  if [[ -n "$save" ]]; then
    target="$(desk_file "$save")"
    if reason="$(desk_name_refusal "$save")"; then
      refuse "desk '$save' ($target): $reason"
    fi
    if [[ -e "$target" && $force -eq 0 ]]; then
      refuse "desk '$save' exists: $target (--force overwrites it)"
    fi
  fi

  dir="$(mktemp -d "${TMPDIR:-/tmp}/arngz-discover.XXXXXX")"
  options="$dir/options.json"
  G="$grid" N="${save:-discovered}" yq -n -o json '.grid = strenv(G) | .name = strenv(N)' >"$options"
  engine_call discover "" "$options"
  yaml="$dir/desk.yaml"
  render_desk "$ENGINE_RESPONSE" >"$yaml"
  render_report "$ENGINE_RESPONSE" >&2
  # What discover writes, the validator must accept: a refusal here is a bug in
  # discover, and it is said rather than saved.
  validate_desk_file "${save:-discovered}" "$yaml" || refuse "discover built a desk the validator refuses (kept at $yaml)"
  rm -rf "$(dirname "$ENGINE_RESPONSE")"

  if [[ -z "$save" ]]; then
    cat "$yaml"
  else
    mkdir -p "$(catalogue_dir)"
    mv -- "$yaml" "$target"
    info "saved $target"
  fi
  rm -rf "$dir"
}

# doctor: every precondition the engine's verbs need, each named with its
# state and, where it does not hold, what fixes it; exit 1 when any does not.
# It reads the machine itself, and asks Hammerspoon only what only Hammerspoon
# can say (that IPC answers, and its Accessibility grant), so it completes with
# no Hammerspoon at all and names it as missing. A check that cannot run
# because an earlier one failed is said as not checked, and does not hold.
cmd_doctor() {
  if [[ $# -gt 0 ]]; then
    refuse "doctor takes no arguments: '$1'"
  fi
  local prefix app app_rc=0 ps ps_rc=0 running where="" state detail fix hs="" rc unasked="" failed="" granted=""
  prefix="$(hs_prefix)"

  # Hammerspoon. pgrep exits 1 when no such process runs; anything else is
  # pgrep failing, which is said, never read as not running.
  app="$(app_path "$HAMMERSPOON_BUNDLE")" || app_rc=$?
  ps="$(pgrep -x "$HAMMERSPOON_PROCESS" 2>&1)" || ps_rc=$?
  case "$ps_rc" in
    0) running=yes ;;
    1) running=no ;;
    *) running=unknown ;;
  esac
  if [[ $app_rc -eq 0 ]]; then
    where=" ($app)"
  fi
  case "$running:$app_rc" in
    yes:*) doctor_line ok Hammerspoon "running$where" ;;
    no:0) doctor_line FAIL Hammerspoon "installed at $app, not running" "open -b $HAMMERSPOON_BUNDLE" ;;
    no:1) doctor_line FAIL Hammerspoon "missing: not installed" "$HAMMERSPOON_INSTALL" ;;
    no:*) doctor_line FAIL Hammerspoon "not running, and where it is installed is unknown: $app" "open -b $HAMMERSPOON_BUNDLE, or $HAMMERSPOON_INSTALL" ;;
    *) doctor_line FAIL Hammerspoon "unknown: pgrep exited $ps_rc: $(printf '%s' "$ps" | tr '\n' ' ')" "run pgrep -x $HAMMERSPOON_PROCESS to see why" ;;
  esac

  IFS='|' read -r state detail fix <<<"$(hs_tool_state "$prefix")"
  if [[ "$state" == ok ]]; then
    hs="$detail"
    doctor_line ok "hs tool" "$hs"
  else
    doctor_line FAIL "hs tool" "missing: $detail" "$fix"
  fi

  # Asked of the engine, through the one engine call, as observe: its world
  # carries Hammerspoon's own Accessibility state. Never asked when nothing
  # could answer, so a missing Hammerspoon or hs is said, never waited on.
  if [[ -z "$hs" ]]; then
    unasked="there is no hs tool to ask it with"
    doctor_line skip IPC "not checked: $unasked"
  elif [[ "$running" == no ]]; then
    unasked="Hammerspoon is not running"
    doctor_line skip IPC "not checked: $unasked"
  else
    rc=0
    engine_ask observe || rc=$?
    case "$rc" in
      0)
        doctor_line ok IPC "Hammerspoon answered through $hs"
        granted="$(yq -r '.world.accessibility' "$ENGINE_RESPONSE")"
        ;;
      3)
        doctor_line ok IPC "Hammerspoon answered through $hs"
        failed="$ENGINE_ERROR (its request and answer are kept at $ENGINE_DIR)"
        ;;
      2)
        unasked="Hammerspoon was not asked"
        doctor_line FAIL IPC "not asked: $ENGINE_ERROR" "fix what that names, then run arngz doctor again"
        ;;
      *)
        unasked="Hammerspoon did not answer"
        doctor_line FAIL IPC "$ENGINE_ERROR" "arngz init --yes makes Hammerspoon's config load hs.ipc; then reload that config"
        ;;
    esac
    # Kept only when the engine answered with an error, which may be worth a
    # look; the line above says where.
    if [[ -n "$ENGINE_DIR" && $rc -ne 3 ]]; then
      rm -rf -- "$ENGINE_DIR"
    fi
  fi

  if [[ -n "$unasked" ]]; then
    doctor_line skip Accessibility "not checked: only Hammerspoon can say, and $unasked"
  elif [[ -n "$failed" ]]; then
    doctor_line FAIL Accessibility "unknown: the engine could not say: $failed" "that is arngz's engine failing ($(engine_module)), not Hammerspoon's setup"
  elif [[ "$granted" == "true" ]]; then
    doctor_line ok Accessibility "granted to Hammerspoon"
  elif [[ "$granted" == "false" ]]; then
    doctor_line FAIL Accessibility "not granted to Hammerspoon" "System Settings > Privacy & Security > Accessibility: turn on Hammerspoon"
  else
    doctor_line FAIL Accessibility "unknown: the engine's observe gave accessibility = '$granted'" "that is arngz's engine failing ($(engine_module)), not Hammerspoon's setup"
  fi

  local what domain key unset_value want at0 at1 value status
  while IFS='|' read -r what domain key unset_value want at0 at1 fix; do
    rc=0
    value="$(read_pref "$domain" "$key")" || rc=$?
    IFS='|' read -r status state fix <<<"$(pref_verdict "$rc" "$value" "$unset_value" "$want" "$at0" "$at1" "$fix")"
    doctor_line "$status" "$what" "$state" "$fix"
  done <<<"$DOCTOR_PREFS"

  if [[ $DOCTOR_FAILED -gt 0 ]]; then
    printf 'arngz doctor: %d of %d preconditions do not hold\n' "$DOCTOR_FAILED" "$DOCTOR_LINES"
    exit 1
  fi
  printf 'arngz doctor: all %d preconditions hold\n' "$DOCTOR_LINES"
}

# ============================================================================
# MAIN
# ============================================================================

main() {
  if [[ $# -eq 0 ]]; then
    usage >&2
    exit 2
  fi
  local verb="$1"
  shift
  case "$verb" in
    -h | --help)
      usage
      ;;
    list) cmd_list "$@" ;;
    show) cmd_show "$@" ;;
    delete) cmd_delete "$@" ;;
    init) cmd_init "$@" ;;
    apply) cmd_apply "$@" ;;
    diff) cmd_diff "$@" ;;
    discover) cmd_discover "$@" ;;
    doctor) cmd_doctor "$@" ;;
    -*) refuse "unknown option: '$verb' (arngz --help names the verbs)" ;;
    *) cmd_apply "$verb" "$@" ;;
  esac
}

require_yq || exit 2
main "$@"

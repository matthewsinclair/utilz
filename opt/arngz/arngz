#!/usr/bin/env bash
#
# arngz - Named window arrangements (desks) across displays and spaces
#
# ST0026. This file is the CLI half: it parses, reads and validates desks,
# asks the engine through the hs tool, and renders. The engine half is a Lua
# module Hammerspoon loads (lib/arngz.lua). doctor and init also read the
# machine itself, so they work with no Hammerspoon at all. A verb not built yet
# exists anyway and says which work package builds it, so the CLI's surface is
# complete and a caller learns what is missing by name.
#

set -euo pipefail

# Source common functions if not already loaded (from dispatcher)
if [[ "$(type -t info 2>/dev/null)" != "function" ]]; then
  SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  UTILZ_HOME="${UTILZ_HOME:-$(cd "$SCRIPT_DIR/../.." && pwd)}"

  if [[ -f "$UTILZ_HOME/opt/utilz/lib/common.sh" ]]; then
    source "$UTILZ_HOME/opt/utilz/lib/common.sh"
  else
    echo "ERROR: Cannot find common.sh library" >&2
    exit 1
  fi
fi

# Every verb. A desk may not take one of these names (design.md, the
# validator's seventh condition; AC-05.7), because `arngz <desk>` is apply and
# a desk called `list` could never be applied that way.
ARNGZ_VERBS="apply discover diff list show delete init doctor"

# ============================================================================
# USAGE
# ============================================================================

usage() {
  cat <<EOF
Usage: arngz <desk>
       arngz <verb> [ARGS]

Named window arrangements (desks) across displays and spaces.

VERBS:
  <desk>                     the same as apply <desk>
  apply <desk> [--dry-run] [--no-launch] [--no-create] [--map <name>=<uuid>]
                             arrange this machine's windows as the desk says
  discover [--grid WxH] [--save <desk>] [--force]
                             print the arrangement on screen now as a desk
  diff <desk>                print what apply would do, and change nothing
  list                       the desks in the catalogue, with display and app counts
  show <desk>                the desk, validated, as stored
  delete <desk>              remove a desk from the catalogue
  init [--yes]               create the catalogue, and report what Hammerspoon needs
  doctor                     every precondition, each with its state

The catalogue is \${XDG_CONFIG_HOME:-\$HOME/.config}/arngz/desks/<desk>.yaml.

For detailed help, run: utilz help arngz
EOF
}

# ============================================================================
# THE CATALOGUE
# ============================================================================

catalogue_dir() {
  printf '%s/arngz/desks\n' "${XDG_CONFIG_HOME:-$HOME/.config}"
}

desk_file() {
  printf '%s/%s.yaml\n' "$(catalogue_dir)" "$1"
}

# A refusal, in the one shape every one of them takes: what refused, and exit 2
# because nothing has changed.
refuse() {
  error "arngz: $*"
  exit 2
}

# The one place a desk NAME is judged. A verb name is the design's seventh
# condition. A name that is not a plain file name is refused too, because it
# is joined onto the catalogue path and `show ../x` must not read outside it.
desk_name_refusal() {
  local name="$1" verb
  for verb in $ARNGZ_VERBS; do
    if [[ "$name" == "$verb" ]]; then
      printf "desk name = '%s': a desk may not be named like a verb (%s)" "$name" "${ARNGZ_VERBS// /, }"
      return 0
    fi
  done
  if [[ ! "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
    printf "desk name = '%s': a desk name is letters, digits, '.', '_' and '-', starting with a letter or digit" "$name"
    return 0
  fi
  return 1
}

# ============================================================================
# THE VALIDATOR
# ============================================================================

# Flatten a desk into one line per fact, from ONE yq pass:
#   K <tab> map-path <tab> key     every key of every mapping
#   V <tab> path <tab> value       every scalar, newlines escaped
#   T <tab> path <tab> tag         every mapping and sequence
# Paths are yq's, dot-joined with numeric indexes ("displays.0.name"). The
# validator and the counts both read this, so there is one parse of a desk.
desk_facts() {
  # shellcheck disable=SC2016 # a yq program: its $p is yq's variable, not the shell's
  yq -r '
    (.. | select(tag == "!!map") | path as $p | keys[] | "K\t" + ($p | map(tostring) | join(".")) + "\t" + .),
    (.. | select(tag != "!!map" and tag != "!!seq") | "V\t" + (path | map(tostring) | join(".")) + "\t" + (. | tostring | sub("\n"; "\\n"))),
    (.. | select(tag == "!!map" or tag == "!!seq") | "T\t" + (path | map(tostring) | join(".")) + "\t" + tag)
  ' "$1"
}

# The desk schema's rules, over desk_facts. PURE: it reads facts on stdin and
# prints one refusal per line, "path US value US reason" (US is the ASCII unit
# separator, 0x1f, which `read` never merges the way it merges empty tab
# fields), in the order
# found; no output means the desk is valid. Every condition in design.md's
# "The config" is here, plus the shape checks they rest on (a list where a list
# belongs, an app entry that names its app, a layout that is present).
# shellcheck disable=SC2016 # an awk program: its $1, $2 and $3 are awk's fields
DESK_RULES='
function human(p,   out) {
  out = p
  while (match(out, /\.[0-9]+/)) {
    out = substr(out, 1, RSTART - 1) "[" substr(out, RSTART + 1, RLENGTH - 1) "]" substr(out, RSTART + RLENGTH)
  }
  return out
}
function shape(p) { gsub(/\.[0-9]+/, "[]", p); return p }
function refuse(p, v, why) { printf "%s\037%s\037%s\n", (p == "" ? "(top)" : human(p)), v, why }
BEGIN {
  FS = "\t"
  allowed["|desk"] = allowed["|grid"] = allowed["|displays"] = 1
  allowed["displays[]|name"] = allowed["displays[]|match"] = allowed["displays[]|spaces"] = 1
  allowed["displays[].match|uuid"] = allowed["displays[].match|name"] = 1
  allowed["displays[].match|size"] = allowed["displays[].match|position"] = 1
  allowed["displays[].spaces[]|name"] = allowed["displays[].spaces[]|apps"] = 1
  allowed["displays[].spaces[].apps[]|app"] = allowed["displays[].spaces[].apps[]|window"] = 1
  allowed["displays[].spaces[].apps[]|layout"] = 1
  # How far discover found a window from its cells (ST0026 WP-04); the
  # planner ignores it.
  allowed["displays[].spaces[].apps[]|misfit"] = 1
  want[""] = "!!map"; want["displays"] = "!!seq"; want["displays[]"] = "!!map"
  want["displays[].match"] = "!!map"; want["displays[].spaces"] = "!!seq"
  want["displays[].spaces[]"] = "!!map"; want["displays[].spaces[].apps"] = "!!seq"
  want["displays[].spaces[].apps[]"] = "!!map"
}
$1 == "K" {
  if (!((shape($2) "|" $3) in allowed)) unknown[++nu] = ($2 == "" ? $3 : $2 "." $3)
  next
}
$1 == "T" {
  tags[$2] = $3; norder[++n] = $2
  next
}
$1 == "V" {
  val[$2] = $3
  if (shape($2) in want) refuse($2, $3, "expected " (want[shape($2)] == "!!seq" ? "a list" : "a mapping"))
  next
}
END {
  if (!("" in tags)) { refuse("", "", "a desk is a mapping with desk, grid and displays"); exit }
  for (i = 1; i <= nu; i++) {
    u = unknown[i]
    refuse(u, (u in val ? val[u] : (u in tags ? tags[u] : "")), "unknown key")
  }
  for (i = 1; i <= n; i++) {
    p = norder[i]
    if ((shape(p) in want) && tags[p] != want[shape(p)])
      refuse(p, tags[p], "expected " (want[shape(p)] == "!!seq" ? "a list" : "a mapping"))
  }

  gw = 0; gh = 0
  if (!("grid" in val)) refuse("grid", "(absent)", "a desk declares its grid as WxH, eg 12x8")
  else if (val["grid"] !~ /^[1-9][0-9]*x[1-9][0-9]*$/) refuse("grid", val["grid"], "a grid is WxH, eg 12x8")
  else { split(val["grid"], g, "x"); gw = g[1] + 0; gh = g[2] + 0 }

  for (i = 1; i <= n; i++) {
    p = norder[i]
    if (shape(p) == "displays[]" && tags[p] == "!!map") {
      if ((p ".name") in val) {
        nm = val[p ".name"]
        if (nm in display_named) refuse(p ".name", nm, "two displays named " nm ": " human(display_named[nm]) " already has that name")
        else display_named[nm] = p
      }
      m = p ".match"
      if (!((m ".uuid") in val) && !((m ".name") in val)) {
        keys = ""
        for (k in val) if (index(k, m ".") == 1) keys = keys (keys == "" ? "" : ", ") substr(k, length(m) + 2)
        refuse(m, (keys == "" ? "(absent)" : keys), "a display must match by uuid or name")
      }
    }
    if (shape(p) == "displays[].spaces[].apps[]" && tags[p] == "!!map" && ((p ".misfit") in val) && val[p ".misfit"] !~ /^[0-9]+px$/)
      refuse(p ".misfit", val[p ".misfit"], "a misfit is a whole number of points, eg 3px")
    if (shape(p) == "displays[].spaces[].apps[]" && tags[p] == "!!map") {
      split(p, parts, ".")
      disp = parts[1] "." parts[2]
      if (!((p ".app") in val)) refuse(p ".app", "(absent)", "an app entry names its bundle id")
      else {
        a = val[p ".app"]
        key = disp SUBSEP a
        count[key]++
        if (count[key] == 1) first[key] = p
        if (!((p ".window") in val)) bare[key] = 1
        if (count[key] == 2) second[key] = p
      }
      if (!((p ".layout") in val)) refuse(p ".layout", "(absent)", "a layout is x,y wxh in the grid, or fullscreen")
      else {
        l = val[p ".layout"]
        if (l == "fullscreen") { }
        else if (l !~ /^[0-9]+,[0-9]+ [1-9][0-9]*x[1-9][0-9]*$/) refuse(p ".layout", l, "a layout is x,y wxh in the grid, or fullscreen")
        else if (gw > 0) {
          split(l, lp, /[, x]/)
          if (lp[1] + lp[3] > gw || lp[2] + lp[4] > gh) refuse(p ".layout", l, "outside the " gw "x" gh " grid")
        }
      }
    }
  }
  for (key in count) {
    if (count[key] > 1 && (key in bare)) {
      split(key, ka, SUBSEP)
      refuse(second[key] ".app", ka[2], "also at " human(first[key]) "; the same app twice on one display needs a window pattern on every entry")
    }
  }
}
'

# THE validator: every verb that reads a desk calls this before anything else
# (design.md, "The config"). Prints every refusal, each naming the desk, its
# file, the path and the value, and returns 2; returns 0 for a valid desk.
validate_desk() {
  local desk="$1" file reason
  file="$(desk_file "$desk")"

  if reason="$(desk_name_refusal "$desk")"; then
    error "arngz: desk '$desk' ($file): $reason"
    return 2
  fi
  if [[ ! -f "$file" ]]; then
    error "arngz: desk '$desk' does not exist: no $file (arngz list names the desks there are)"
    return 2
  fi
  validate_desk_file "$desk" "$file"
}

# The schema half of the validator, for a desk file anywhere: discover checks
# what it is about to save before the file reaches the catalogue.
validate_desk_file() {
  local desk="$1" file="$2" facts refusals path value why
  if ! facts="$(desk_facts "$file" 2>&1)"; then
    error "arngz: desk '$desk' ($file) is not YAML yq can read: $facts"
    return 2
  fi
  refusals="$(printf '%s\n' "$facts" | awk "$DESK_RULES")"
  if [[ -z "$refusals" ]]; then
    return 0
  fi
  while IFS=$'\037' read -r path value why; do
    if [[ -n "$value" ]]; then
      error "arngz: desk '$desk' ($file): $path = '$value': $why"
    else
      error "arngz: desk '$desk' ($file): $path: $why"
    fi
  done <<<"$refusals"
  return 2
}

# "N display(s)  M app(s)" for a desk already validated.
desk_counts() {
  local facts displays apps
  facts="$(desk_facts "$1")"
  displays=$(printf '%s\n' "$facts" | awk -F'\t' '$1 == "T" && $2 ~ /^displays\.[0-9]+$/ { c++ } END { print c + 0 }')
  apps=$(printf '%s\n' "$facts" | awk -F'\t' '$1 == "T" && $2 ~ /^displays\.[0-9]+\.spaces\.[0-9]+\.apps\.[0-9]+$/ { c++ } END { print c + 0 }')
  printf '%d display%s  %d app%s\n' "$displays" "$([[ $displays -eq 1 ]] || echo s)" "$apps" "$([[ $apps -eq 1 ]] || echo s)"
}

# ============================================================================
# THE ENGINE CONTRACT (design.md "The engine", D17)
# ============================================================================

# The Lua module Hammerspoon loads, beside this script.
engine_module() {
  printf '%s/opt/arngz/lib/arngz.lua\n' "$UTILZ_HOME"
}

# A number of seconds from the environment variable NAME, DEFAULT when it is
# unset; anything but a whole number of seconds is refused.
seconds_setting() {
  local name="$1" default="$2" t
  t="${!name:-$default}"
  if [[ ! "$t" =~ ^[1-9][0-9]*$ ]]; then
    refuse "$name = '$t': a whole number of seconds"
  fi
  printf '%s\n' "$t"
}

# How long one engine call may take, in seconds. ARNGZ_HS_TIMEOUT overrides it,
# which is how the suite makes a call that never answers fail in one second
# rather than sixty.
engine_timeout() {
  seconds_setting ARNGZ_HS_TIMEOUT 60
}

# How long the CLI waits for a scheduled verb's answer, apply's, in seconds
# (design.md "apply, in order", step 4). ARNGZ_APPLY_TIMEOUT overrides it.
engine_scheduled_timeout() {
  seconds_setting ARNGZ_APPLY_TIMEOUT 600
}

# Whether hs, exiting RC with OUT as what it printed, gave up waiting for
# Hammerspoon's answer after delivering the request: exit 69 with "receive
# timeout" (measured, design.md "Measured 16 Oct 2026"). hs exits 69 too when
# it cannot reach Hammerspoon at all, and says so differently, so this is the
# one place the two are told apart.
hs_gave_up_waiting() {
  local rc="$1" out="$2"
  [[ $rc -eq 69 ]] && grep -qF "receive timeout" "$out"
}

# Ask the engine one thing. Writes {verb, desk, options} to a request file in
# a fresh temp dir, runs `hs -c 'return dofile(<module>).run(<request>)'`, and
# leaves the response's path in ENGINE_RESPONSE. Everything the CLI then shows
# comes out of that file; nothing is recomputed here.
#
# THE RESPONSE FILE IS THE ANSWER, NOT hs's EXIT. Measured 16 Oct 2026 on this
# machine: hs -c sometimes never returned after the module had finished and
# written its response, -t notwithstanding. The cause was stdin (below); the
# file is still the answer, because the next hang will have another cause. So
# the wait ends at whichever comes first -- the response appearing (the module
# renames it into place whole), hs exiting, or the deadline -- and an hs still
# running once the response is there is stopped.
#
# It NEVER EXITS, so doctor can say what failed and go on; engine_call is the
# form that refuses. It returns
#   0  the engine answered ok, and its response is ENGINE_RESPONSE
#   1  nothing answered: hs could not reach Hammerspoon, failed some other
#      way, or did not answer in time; or a scheduled verb was taken and not
#      answered by its deadline, when ENGINE_PENDING is 1, because the engine
#      may still be running it
#   2  nothing was asked: the hs tool is not there or would not run, or the
#      request could not be made
#   3  the engine answered with an error: an error response, a response that
#      is not JSON, a Lua error raised inside it (hs exit 65), or no response
#      from a run hs says finished (exit 0), which is how the engine says it
#      could not write one (lib/arngz.lua)
# with why in ENGINE_ERROR and what fixes it in ENGINE_FIX for each but 0.
# Whenever the engine wrote a response, ENGINE_KIND says what it was: ok,
# refused (nothing changed), lua_error, or failed when it named no kind (both
# its own error, which for apply may come after windows moved), or
# unreadable; it is empty when there was none.
# ENGINE_DIR is the request's temp dir whenever a request was written, for the
# caller to keep or remove; when nothing was asked, the dir is already gone.
# A bad ARNGZ_HS_TIMEOUT, or for a scheduled verb a bad ARNGZ_APPLY_TIMEOUT,
# is refused outright before anything is sent, because that is the caller's
# mistake, not the engine's.
#
# Usage: engine_ask <verb> [<desk file>] [<options JSON file>]
ENGINE_RESPONSE=""
ENGINE_ERROR=""
ENGINE_FIX=""
ENGINE_DIR=""
ENGINE_PENDING=0
ENGINE_KIND=""

# The verbs the engine runs on a timer and answers later (D20 as amended).
# THE SAME LIST AS `SCHEDULED` in lib/arngz.lua, which arngz.bats holds the
# two to: the CLI needs its own copy to check the deadline before it sends.
SCHEDULED_VERBS="apply"
engine_ask() {
  local verb="$1" desk_file="${2:-}" options_file="${3:-}" tool state hs fix module timeout dir request response out why rc deadline hung=0
  local tmp_fix="make ${TMPDIR:-/tmp} a writable directory, or set TMPDIR to one"
  ENGINE_RESPONSE=""
  ENGINE_ERROR=""
  ENGINE_FIX=""
  ENGINE_DIR=""
  ENGINE_PENDING=0
  ENGINE_KIND=""
  # The hs tool as doctor and init tell it, so the three cannot disagree.
  tool="$(hs_tool_state "$(hs_prefix)")"
  IFS=$'\037' read -r state hs fix <<<"$tool"
  if [[ "$state" != ok ]]; then
    engine_unasked "the hs tool, which arngz reaches Hammerspoon through, is missing: $hs" "$fix"
    return 2
  fi
  module="$(engine_module)"
  timeout="$(engine_timeout)" || exit 2
  local waited=""
  case " $SCHEDULED_VERBS " in
    *" $verb "*) waited="$(engine_scheduled_timeout)" || exit 2 ;;
  esac
  if ! dir="$(mktemp -d "${TMPDIR:-/tmp}/arngz.XXXXXX" 2>&1)"; then
    engine_unasked "could not make a temp dir under ${TMPDIR:-/tmp} for the request: $dir" "$tmp_fix"
    return 2
  fi
  ENGINE_DIR="$dir"
  request="$ENGINE_DIR/request.json"
  response="$ENGINE_DIR/response.json"
  out="$ENGINE_DIR/hs.out"
  # The paths go into a Lua string literal, so a quote or backslash in one
  # would end the literal early. Refuse rather than escape.
  case "$module$request" in
    *'"'* | *\\*)
      engine_unasked "a path holds a quote or backslash, which cannot go into the hs call: $module, $request" \
        "keep arngz and TMPDIR on paths with no quote or backslash"
      return 2
      ;;
  esac

  if [[ -z "$options_file" ]]; then
    options_file="$ENGINE_DIR/options.json"
    if ! why="$({ printf '{}\n' >"$options_file"; } 2>&1)"; then
      engine_unasked "could not write the request's options to $options_file: $why" "$tmp_fix"
      return 2
    fi
  fi
  rc=0
  if [[ -n "$desk_file" ]]; then
    why="$(V="$verb" D="$desk_file" O="$options_file" yq -n -o json \
      '.verb = strenv(V) | .desk = load(strenv(D)) | .options = load(strenv(O))' 2>&1 >"$request")" || rc=$?
  else
    why="$(V="$verb" O="$options_file" yq -n -o json \
      '.verb = strenv(V) | .desk = null | .options = load(strenv(O))' 2>&1 >"$request")" || rc=$?
  fi
  if [[ $rc -ne 0 ]]; then
    engine_unasked "could not write the request for $verb to $request (yq exited $rc): $why" "fix what yq names, then run arngz again"
    return 2
  fi

  # STDIN FROM /dev/null, ALWAYS: hs reads Lua from stdin when stdin is not a
  # terminal, so under any caller whose stdin stays open it waits for input
  # that never comes. Measured 16 Oct 2026: 3 of 3 hung with stdin an open
  # pipe, 3 of 3 returned at once from /dev/null (the cause vc and dc found).
  # The response-file wait below stays as the defence against the next hang.
  "$hs" -a -t "$timeout" -c "return dofile(\"$module\").run(\"$request\")" </dev/null >"$out" 2>&1 &
  local pid=$!
  deadline=$((SECONDS + timeout))
  while [[ ! -f "$response" ]] && kill -0 "$pid" 2>/dev/null && [[ $SECONDS -lt $deadline ]]; do
    sleep 0.1
  done

  if [[ -f "$response" ]]; then
    if kill -0 "$pid" 2>/dev/null; then
      kill "$pid" 2>/dev/null || true
    fi
    wait "$pid" 2>/dev/null || true
  elif kill -0 "$pid" 2>/dev/null; then
    kill "$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
    if [[ -z "$waited" ]]; then
      ENGINE_ERROR="hs did not answer within ${timeout}s and wrote no response"
      ENGINE_FIX="Hammerspoon is busy or hung: see its console (its menu bar icon: Console), or quit and reopen it"
      return 1
    fi
    # A scheduled verb may have been taken by an hs that then hung (D20): it
    # is waited for below, never read as nothing having happened.
    rc=0
    hung=1
  else
    rc=0
    wait "$pid" || rc=$?
  fi
  # A SCHEDULED VERB (D20 as amended): the hs client gives up 4 s after
  # sending, so apply's work runs on a timer inside Hammerspoon, the IPC call
  # returns at once saying so, and the response file is the only answer,
  # waited for on the CLI's own deadline.
  # Taken when run() said it scheduled the verb, when hs hung after sending,
  # or when hs gave up with "receive timeout": the message was delivered and
  # its reply came late (measured, design.md "Measured 16 Oct 2026"), so
  # Hammerspoon may still take it. Every other outcome is read as it is for
  # any verb, below.
  local taken=0
  if [[ ! -f "$response" && -n "$waited" ]]; then
    if [[ $hung -eq 1 ]] || { [[ $rc -eq 0 ]] && grep -qxF "arngz: scheduled $verb" "$out"; } ||
      hs_gave_up_waiting "$rc" "$out"; then
      taken=1
    fi
  fi
  if [[ $taken -eq 1 ]]; then
    deadline=$((SECONDS + waited))
    while [[ ! -f "$response" && $SECONDS -lt $deadline ]]; do
      sleep 0.2
    done
    if [[ ! -f "$response" ]]; then
      ENGINE_PENDING=1
      ENGINE_ERROR="the engine was sent $verb and has not answered within ${waited}s; it may still be running"
      ENGINE_FIX="see Hammerspoon's console (its menu bar icon: Console); a slower $verb takes ARNGZ_APPLY_TIMEOUT=<seconds>"
      return 1
    fi
  elif [[ ! -f "$response" ]]; then
    case "$rc" in
      # The module ran and returned, having written nothing: the engine's own
      # way of saying it could not write its response, on hs's stdout.
      0)
        ENGINE_ERROR="hs exited 0 and wrote no response, so the engine ran and could not write its answer: $(tr '\n' ' ' <"$out")"
        ENGINE_FIX="$(engine_failing)"
        return 3
        ;;
      # The module ran and failed, so Hammerspoon did answer.
      65)
        ENGINE_ERROR="the engine raised a Lua error (hs exit 65): $(tr '\n' ' ' <"$out")"
        ENGINE_FIX="$(engine_failing)"
        return 3
        ;;
      # The shell's own codes for a tool it could not run, so nothing was
      # asked.
      126 | 127)
        engine_unasked "the hs tool at $hs could not be run (exit $rc): $(tr '\n' ' ' <"$out")" \
          "replace it with Hammerspoon's own: remove it, then arngz init --yes links it"
        return 2
        ;;
      69)
        if hs_gave_up_waiting "$rc" "$out"; then
          # The request reached Hammerspoon's port and no answer came within
          # -t, so Hammerspoon is running and loads hs.ipc, and is busy or
          # hung: busy, eg, while an apply holds its main thread (D20). A
          # scheduled verb that hs gave up on is waited for above instead.
          ENGINE_ERROR="hs gave up on $verb after ${timeout}s with receive timeout: the request reached Hammerspoon, which is running, and no answer came in time"
          ENGINE_FIX="Hammerspoon is busy or hung: let an arngz apply that is running finish, or see its console (its menu bar icon: Console), or quit and reopen it"
        else
          ENGINE_ERROR="hs could not reach Hammerspoon (exit 69): it is not running, or its config does not load hs.ipc"
          ENGINE_FIX="arngz init --yes makes Hammerspoon's config load hs.ipc; then reload that config"
        fi
        ;;
      75)
        ENGINE_ERROR="Hammerspoon is not running (hs exit 75)"
        ENGINE_FIX="open -b $HAMMERSPOON_BUNDLE"
        ;;
      *)
        ENGINE_ERROR="hs exited $rc and wrote no response: $(tr '\n' ' ' <"$out")"
        ENGINE_FIX="run hs -c 'return 1' </dev/null by hand, which says why"
        ;;
    esac
    return 1
  fi

  ENGINE_RESPONSE="$response"
  ENGINE_KIND=unreadable
  local status
  if ! status="$(yq -r '.status' "$response" 2>"$ENGINE_DIR/yq.err")"; then
    ENGINE_ERROR="the engine's response is not JSON: $(tr '\n' ' ' <"$ENGINE_DIR/yq.err")"
    ENGINE_FIX="$(engine_failing)"
    return 3
  fi
  if [[ "$status" != "ok" ]]; then
    # The engine says which: a refusal before anything changed, with its
    # reason, or its own Lua error (D25).
    ENGINE_KIND="$(yq -r '.kind // "failed"' "$response")"
    if [[ "$ENGINE_KIND" == refused ]]; then
      ENGINE_ERROR="the engine refused $verb: $(yq -r '.error' "$response" | tr '\n' ' ')"
      ENGINE_FIX="fix what the engine names, then run arngz again"
    else
      ENGINE_ERROR="the engine failed on $verb: $(yq -r '.error' "$response" | tr '\n' ' ')"
      ENGINE_FIX="$(engine_failing)"
    fi
    return 3
  fi
  ENGINE_KIND=ok
}

# Nothing was asked: say why and what fixes it, and remove the request's temp
# dir, which holds nothing worth a look.
engine_unasked() {
  ENGINE_ERROR="$1"
  ENGINE_FIX="$2"
  if [[ -n "$ENGINE_DIR" ]]; then
    if ! rm -rf -- "$ENGINE_DIR"; then
      ENGINE_ERROR="$ENGINE_ERROR (and its temp dir $ENGINE_DIR could not be removed)"
    fi
    ENGINE_DIR=""
  fi
}

# What fixes the engine answering with an error: nothing on this machine.
engine_failing() {
  printf "that is arngz's engine failing (%s), not Hammerspoon's setup\n" "$(engine_module)"
}

# engine_ask, refused by name, exit 2, unless the engine answered ok. The form
# every verb that needs the engine's answer calls.
engine_call() {
  local rc=0
  engine_ask "$@" || rc=$?
  if [[ $rc -ne 0 ]]; then
    engine_refuse
  fi
}

# The refusal for an engine call that did not answer ok: why, the request kept
# for a look whenever one was written, and what fixes it. For a verb with temp
# files of its own to remove first.
engine_refuse() {
  local kept=""
  if [[ -n "$ENGINE_DIR" && -f "$ENGINE_DIR/request.json" ]]; then
    kept=" (request kept at $ENGINE_DIR/request.json)"
  fi
  refuse "$ENGINE_ERROR$kept; fix: $ENGINE_FIX"
}

# The engine's report, line for line, as the engine wrote it.
render_report() {
  yq -r '.report[]' "$1"
}

# The engine's desk as YAML, in the desk's own key order. The order is set
# here, by naming every key, because the engine's JSON comes from Lua tables,
# which have none: the same world must print the same bytes (AC-04.1). Keys a
# desk does not carry are left out rather than printed as null. No -P: it
# would override the flow style `match` takes, as in the design's example.
render_desk() {
  yq -o yaml '.desk | {
    "desk": .desk,
    "grid": .grid,
    "displays": [(.displays // [])[] | {
      "name": .name,
      "match": ({"uuid": .match.uuid, "name": .match.name, "size": .match.size, "position": .match.position}
        | with_entries(select(.value != null))),
      "spaces": [(.spaces // [])[] | {
        "apps": [(.apps // [])[] | ({"app": .app, "window": .window, "layout": .layout, "misfit": .misfit}
          | with_entries(select(.value != null)))]
      }]
    }]
  } | .displays[].match style="flow"' "$1"
}

# ============================================================================
# THE MACHINE: what doctor reads and init provides (D16, D18)
# ============================================================================

# Hammerspoon's bundle id and install line, as arngz.yaml declares them for
# utilz doctor: the one place they are written, read once by main. Its process
# name, as pgrep finds it, is not declared there.
HAMMERSPOON_BUNDLE=""
HAMMERSPOON_INSTALL=""
HAMMERSPOON_PROCESS="Hammerspoon"
load_hammerspoon() {
  local yaml="$UTILZ_HOME/opt/arngz/arngz.yaml" entry
  if ! entry="$(yq -r '.dependencies[] | select(.name == "Hammerspoon") | (.app // "") + "|" + (.install // "")' "$yaml" 2>&1)"; then
    refuse "could not read Hammerspoon's entry in $yaml: $entry"
  fi
  HAMMERSPOON_BUNDLE="${entry%%|*}"
  HAMMERSPOON_INSTALL="${entry#*|}"
  if [[ "$entry" == *$'\n'* || -z "$HAMMERSPOON_BUNDLE" || -z "$HAMMERSPOON_INSTALL" ]]; then
    refuse "$yaml declares no one Hammerspoon entry with an app and an install line: '$(printf '%s' "$entry" | tr '\n' ' ')'"
  fi
}

# One record of fields, joined by the ASCII unit separator (0x1f), and read
# back with IFS=$'\037': every plan and verdict below prints one. Not '|',
# because a path, a message or an engine's error can carry a '|', and a
# newline inside a field is flattened, because the reader reads one line.
record() {
  local IFS=$'\037' line
  line="$*"
  printf '%s\n' "${line//$'\n'/ }"
}

# The one line init appends to Hammerspoon's config, marked as arngz's.
IPC_LINE='require("hs.ipc") -- arngz (Utilz ST0026): IPC for the hs command-line tool'

# Where init links the hs tool: /opt/homebrew (D16), because /usr/local, the
# default of Hammerspoon's own hs.ipc.cliInstall, is root-owned on hv's
# machine. ARNGZ_HS_PREFIX overrides it, which is how the suite links into a
# fixture and never into the machine.
hs_prefix() {
  printf '%s\n' "${ARNGZ_HS_PREFIX:-/opt/homebrew}"
}

# Hammerspoon's config file: ~/.hammerspoon/init.lua, or the file its
# MJConfigFile preference names. Hammerspoon honours that preference, so init
# must too, or its line would go where Hammerspoon never reads it. Read like
# every other preference (read_pref), so a preference that could not be read
# is said, and fails, rather than guessed to be unset. Only a full path or one
# under ~/ is followed: Hammerspoon reads any other against its own working
# directory, which arngz cannot know. One that is set and empty is not unset,
# and is refused by name. With no defaults tool there are no Hammerspoon
# preferences, and the default stands.
hammerspoon_config() {
  local custom rc=0
  if command -v defaults >/dev/null 2>&1; then
    custom="$(read_pref "$HAMMERSPOON_BUNDLE" MJConfigFile)" || rc=$?
    if [[ $rc -eq 0 ]]; then
      # Set and empty. Hammerspoon 1.1.1 takes any string the preference holds
      # (MJAppDelegate.m: `if (userMJConfigFile) MJConfigFile =
      # userMJConfigFile`, and stringForKey: gives "", not nil), and its config
      # path is that string standardized (MJConfigUtils.m,
      # MJConfigFileFullPath), so an empty one is an empty path and no config
      # loads, ~/.hammerspoon/init.lua included. Read in Hammerspoon's source,
      # not measured. defaults prints an empty value as one newline, which
      # read_pref gives back as nothing (measured on macOS 27.0.1).
      if [[ -z "$custom" ]]; then
        printf "Hammerspoon's MJConfigFile preference is set and empty, which Hammerspoon 1.1.1 takes as its config path rather than falling back to ~/.hammerspoon/init.lua, so it loads no config; set it to a full path, or remove it: defaults delete %s MJConfigFile\n" \
          "$HAMMERSPOON_BUNDLE"
        return 1
      fi
      # shellcheck disable=SC2088 # a literal ~/ at the start, as the preference holds it
      if [[ "$custom" == *$'\n'* || ("$custom" != /* && "$custom" != "~/"*) ]]; then
        printf "Hammerspoon's MJConfigFile preference is '%s', not a full path or one under ~/, so which file Hammerspoon reads is unknown\n" \
          "$(printf '%s' "$custom" | tr '\n' ' ')"
        return 1
      fi
      expand_tilde "$custom"
      return 0
    fi
    if [[ $rc -ne 3 ]]; then
      printf "Hammerspoon's MJConfigFile preference, which says where its config is, could not be read: %s\n" "$custom"
      return 1
    fi
  fi
  printf '%s/.hammerspoon/init.lua\n' "$HOME"
}

# The hs tool, as doctor reports it, init acts on it and the engine call
# looks for it, so none can tell it differently. Prints a record of state,
# detail and fix, the state one of
#   ok        on PATH, where arngz looks, and runs; the detail is its path
#   unlisted  PREFIX/bin/hs runs, but PREFIX/bin is not on PATH
#   broken    the hs on PATH, or PREFIX/bin/hs, is there and does not run
#   absent    nowhere; init --yes links it
# `command -v` names a file on PATH that cannot run, when no other can
# (measured 16 Oct 2026 under bash 3.2.57 and 5.3.20), so it is checked too.
hs_tool_state() {
  local prefix="$1" hs
  if hs="$(command -v hs)" && [[ -x "$hs" ]]; then
    record ok "$hs" ""
  elif [[ -n "$hs" ]]; then
    record broken "$hs is on PATH and is not executable" "remove it, or make it executable"
  elif [[ -x "$prefix/bin/hs" ]]; then
    record unlisted "$prefix/bin/hs is there, but $prefix/bin is not on PATH, where arngz looks for it" "add $prefix/bin to PATH"
  elif [[ -e "$prefix/bin/hs" || -L "$prefix/bin/hs" ]]; then
    record broken "$prefix/bin/hs is there and does not run (a link to a Hammerspoon that moved?)" "remove it, and arngz init --yes links it again"
  else
    record absent "not on PATH" "arngz init --yes links it under $prefix"
  fi
}

# Whether a file can be made in DIR: DIR is a writable directory, or mkdir -p
# can make it, because its nearest existing ancestor is one. A link on the way
# that leads nowhere, as a dotfiles link does once its repository moves, makes
# mkdir -p fail too. Prints why not, and fails, when it cannot.
writable_dir() {
  local p="$1"
  while [[ ! -e "$p" ]]; do
    if [[ -L "$p" ]]; then
      printf '%s is a link that leads nowhere\n' "$p"
      return 1
    fi
    p="$(dirname "$p")"
  done
  if [[ ! -d "$p" ]]; then
    printf '%s is not a directory\n' "$p"
    return 1
  fi
  if [[ ! -w "$p" ]]; then
    printf '%s is not writable\n' "$p"
    return 1
  fi
}

# What init does about the hs tool, as a record of a kind and its fields:
#   have PATH                 on PATH already
#   unlisted DETAIL FIX       under the prefix but not on PATH: for a person
#   block WHY                 init --yes cannot provide it
#   link TOOL MAN MAN_NOTE    init --yes links TOOL, and MAN when there is one
# It reads the machine and decides, and changes nothing. APP and APP_RC are
# what app_path said of Hammerspoon.
init_hs_plan() {
  local prefix="$1" app="$2" app_rc="$3" tool state detail fix why man="" man_note=""
  tool="$(hs_tool_state "$prefix")"
  IFS=$'\037' read -r state detail fix <<<"$tool"
  case "$state" in
    ok)
      record have "$detail"
      return 0
      ;;
    unlisted)
      record unlisted "$detail" "$fix"
      return 0
      ;;
    broken)
      record block "$detail: $fix"
      return 0
      ;;
  esac
  if [[ $app_rc -eq 1 ]]; then
    record block "the hs tool comes with Hammerspoon, which is not installed: $HAMMERSPOON_INSTALL"
  elif [[ $app_rc -ne 0 ]]; then
    record block "the hs tool comes with Hammerspoon, and where it is installed is unknown: $app"
  elif [[ ! -x "$app/Contents/Frameworks/hs/hs" ]]; then
    record block "Hammerspoon at $app carries no hs tool at $app/Contents/Frameworks/hs/hs"
  elif ! why="$(writable_dir "$prefix/bin")"; then
    record block "$prefix/bin/hs cannot be made: $why"
  else
    if [[ -f "$app/Contents/Resources/man/hs.man" && ! -e "$prefix/share/man/man1/hs.1" && ! -L "$prefix/share/man/man1/hs.1" ]]; then
      if why="$(writable_dir "$prefix/share/man/man1")"; then
        man="$app/Contents/Resources/man/hs.man"
      else
        man_note="; not its man page, because $why"
      fi
    fi
    record link "$app/Contents/Frameworks/hs/hs" "$man" "$man_note"
  fi
}

# What init does about Hammerspoon's config, as a record of a kind, the
# config and a field:
#   have CONFIG LINE     it loads hs.ipc already, at LINE
#   append CONFIG        init --yes appends the one line
#   block CONFIG WHY     init --yes cannot
# It reads the machine and decides, and changes nothing. A config that cannot
# be searched for its require is said, never read as one without it, which
# would append a second.
init_config_plan() {
  local config line why
  if ! config="$(hammerspoon_config)"; then
    record block "Hammerspoon's config" "$config"
  elif [[ -L "$config" && ! -e "$config" ]]; then
    record block "$config" "$config is a link that leads nowhere"
  elif [[ -e "$config" && ! -f "$config" ]]; then
    record block "$config" "$config is not a file"
  elif [[ -e "$config" && ! -r "$config" ]]; then
    record block "$config" "$config cannot be read"
  elif [[ -f "$config" ]] && ! line="$(ipc_require_line "$config" 2>&1)"; then
    record block "$config" "$config could not be searched for a require of hs.ipc: $line"
  elif [[ -n "${line:-}" ]]; then
    record have "$config" "$line"
  elif [[ -e "$config" && ! -w "$config" ]]; then
    record block "$config" "$config is not writable"
  elif [[ ! -e "$config" ]] && ! why="$(writable_dir "$(dirname "$config")")"; then
    record block "$config" "$config cannot be made, because $why"
  else
    record append "$config"
  fi
}

# The number of the first line of a Lua file that loads hs.ipc, or nothing. A
# require of "hs.ipc" in any of Lua's spellings counts, marked or not, because
# a person may have added it by hand (hv's own init.lua carries one, with a
# guarded cliInstall beside it); one after a -- on its line does not. A
# require inside a --[[ ]] block comment reads as loading it, and doctor's IPC
# check is what then says otherwise.
ipc_require_line() {
  awk -v re="require[ \t]*[(]?[ \t]*[\"']hs[.]ipc[\"']" \
    '{ code = $0; sub(/--.*/, "", code) } code ~ re { print NR; exit }' "$1"
}

# Every change init makes is one step: WHAT, said as a step ("link P to T"),
# and the command that makes it. Each was checked before the first was made
# (D23), so a step that fails is the machine changing under init. Before any
# step has been made that is a refusal, exit 2, because nothing has changed;
# after one, init stops with exit 1 and names the steps it had made, because
# then something has.
INIT_MADE=""
init_step() {
  local what="$1" why
  shift
  if ! why="$("$@" 2>&1)"; then
    if [[ -z "$INIT_MADE" ]]; then
      refuse "init changed nothing: could not $what: $why"
    fi
    error "arngz: init --yes stopped at '$what': $why. Made before it: $INIT_MADE"
    exit 1
  fi
  INIT_MADE="${INIT_MADE:+$INIT_MADE; }$what"
}

# Append LINE, and a newline, to FILE: one step of init.
append_line() {
  printf '%s\n' "$2" >>"$1"
}

# Link the hs tool, and its man page when there is one to link, under PREFIX,
# as hs.ipc.cliInstall links them (Hammerspoon 1.1.1, extensions/hs/ipc.lua):
# PREFIX/bin/hs to the app's Contents/Frameworks/hs/hs, and
# PREFIX/share/man/man1/hs.1 to its Contents/Resources/man/hs.man. Done here,
# because cliInstall runs inside Hammerspoon and so needs the very IPC this
# sets up.
link_hs_tool() {
  local prefix="$1" tool="$2" man="$3"
  if [[ ! -d "$prefix/bin" ]]; then
    init_step "make $prefix/bin" mkdir -p "$prefix/bin"
  fi
  init_step "link $prefix/bin/hs to $tool" ln -s "$tool" "$prefix/bin/hs"
  if [[ -n "$man" ]]; then
    if [[ ! -d "$prefix/share/man/man1" ]]; then
      init_step "make $prefix/share/man/man1" mkdir -p "$prefix/share/man/man1"
    fi
    init_step "link $prefix/share/man/man1/hs.1 to $man" ln -s "$man" "$prefix/share/man/man1/hs.1"
  fi
}

# Append IPC_LINE to Hammerspoon's config, in place, so a config that is a link
# into a dotfiles repository stays one. A last line with no newline is ended
# first, or the require would join it.
append_ipc_line() {
  local config="$1" parent
  parent="$(dirname "$config")"
  if [[ ! -d "$parent" ]]; then
    init_step "make $parent" mkdir -p "$parent"
  fi
  if [[ -s "$config" && -n "$(tail -c 1 "$config")" ]]; then
    init_step "end the last line of $config" append_line "$config" ""
  fi
  init_step "append the hs.ipc line to $config" append_line "$config" "$IPC_LINE"
}

# One macOS preference. Prints the value and returns 0; returns 3, printing
# nothing, when it is unset (no such key, or no such domain); prints why and
# returns 1 when it could not be read. defaults says an unset key's pair "does
# not exist" up to macOS 26; on 27 it says "Could not find key '<key>' in
# domain '<domain>'", or "Domain '<domain>' not found" for a domain with no
# preferences at all (all three measured 16 Oct 2026). Only those wordings,
# naming this key and domain, are unset; any other failure is said. The value
# is defaults' stdout alone: a warning it prints beside a value it read is not
# part of the value, so its stderr goes to a file of its own.
read_pref() {
  local domain="$1" key="$2" errfile out err rc=0
  if ! command -v defaults >/dev/null 2>&1; then
    printf 'there is no defaults tool to read it with (macOS only)\n'
    return 1
  fi
  if ! errfile="$(mktemp "${TMPDIR:-/tmp}/arngz-defaults.XXXXXX" 2>&1)"; then
    printf 'could not make a temp file under %s to read %s %s with: %s\n' "${TMPDIR:-/tmp}" "$domain" "$key" "$errfile"
    return 1
  fi
  out="$(defaults read "$domain" "$key" 2>"$errfile" </dev/null)" || rc=$?
  err="$(cat "$errfile")"
  rm -f -- "$errfile" || warn "arngz: could not remove $errfile"
  if [[ $rc -eq 0 ]]; then
    printf '%s\n' "$out"
    return 0
  fi
  case "$err" in
    *"($domain, $key) does not exist"* | *"Could not find key '$key' in domain '$domain'"* | *"Domain '$domain' not found"*) return 3 ;;
  esac
  printf 'defaults read %s %s failed (exit %s): %s\n' "$domain" "$key" "$rc" "$(printf '%s' "$err${out:+ $out}" | tr '\n' ' ')"
  return 1
}

# The three settings doctor reads from macOS's preferences, one per line:
#   precondition|domain|key|value when unset|value arngz needs|state at 0|state at 1|fix
# spans-displays is 0 when each display has its own spaces, macOS's default.
MACOS_PREFS="separate spaces|com.apple.spaces|spans-displays|0|0|on|off|System Settings > Desktop & Dock > Mission Control: turn on Displays have separate Spaces, then log out and in
auto-rearrange|com.apple.dock|mru-spaces|1|0|off|on|System Settings > Desktop & Dock > Mission Control: turn off Automatically rearrange Spaces based on most recent use
Stage Manager|com.apple.WindowManager|GloballyEnabled|0|0|off|on|System Settings > Desktop & Dock: turn off Stage Manager"

# PURE: one preference's verdict, from what read_pref returned and printed, as
# a record of status, state and fix. An unset key takes macOS's default, and
# says so. The one owner of this verdict: apply asks it too, before it asks
# the engine (D26).
pref_verdict() {
  local rc="$1" value="$2" unset_value="$3" want="$4" at0="$5" at1="$6" fix="$7" note="" state
  case "$rc" in
    0) ;;
    3)
      value="$unset_value"
      note=" (unset: macOS's default)"
      ;;
    *)
      record FAIL "unknown: $value" "$fix"
      return 0
      ;;
  esac
  case "$value" in
    1 | true | YES) value=1 ;;
    0 | false | NO) value=0 ;;
    *)
      record FAIL "unknown: the value is '$value', not a boolean" "$fix"
      return 0
      ;;
  esac
  if [[ "$value" == "1" ]]; then state="$at1"; else state="$at0"; fi
  if [[ "$value" == "$want" ]]; then
    record ok "$state$note" ""
  else
    record FAIL "$state$note" "$fix"
  fi
}

# PURE: Hammerspoon's verdict, from what app_path said of it (APP, APP_RC) and
# what pgrep said of this user's processes (PS_RC, PS) when asked with
# PGREP. pgrep exits 1 when no such process runs; anything else is pgrep
# failing, which is said, never read as not running.
hammerspoon_verdict() {
  local app="$1" app_rc="$2" ps_rc="$3" ps="$4" pgrep="$5" where=""
  if [[ $app_rc -eq 0 ]]; then
    where=" ($app)"
  fi
  case "$ps_rc:$app_rc" in
    0:*) record ok "running$where" "" ;;
    1:0) record FAIL "installed at $app, not running" "open -b $HAMMERSPOON_BUNDLE" ;;
    1:1) record FAIL "missing: not installed" "$HAMMERSPOON_INSTALL" ;;
    1:*) record FAIL "not running, and where it is installed is unknown: $app" "open -b $HAMMERSPOON_BUNDLE, or $HAMMERSPOON_INSTALL" ;;
    *) record FAIL "unknown: pgrep exited $ps_rc: $ps" "run $pgrep to see why" ;;
  esac
}

# PURE: the hs tool's verdict, from hs_tool_state's state, detail and fix.
hs_tool_verdict() {
  if [[ "$1" == ok ]]; then
    record ok "$2" ""
  else
    record FAIL "missing: $2" "$3"
  fi
}

# PURE: the IPC verdict, from OUTCOME -- nohs (no hs tool to ask with),
# stopped (Hammerspoon not running), or what engine_ask returned -- with HS
# the tool it asked through, and ERROR and FIX as engine_ask gave them.
ipc_verdict() {
  local outcome="$1" hs="$2" error="$3" fix="$4"
  case "$outcome" in
    nohs) record skip "not checked: there is no hs tool to ask it with" "" ;;
    stopped) record skip "not checked: Hammerspoon is not running" "" ;;
    # An error from the engine is still Hammerspoon answering.
    0 | 3) record ok "Hammerspoon answered through $hs" "" ;;
    2) record FAIL "not asked: $error" "$fix" ;;
    *) record FAIL "$error" "$fix" ;;
  esac
}

# PURE: the Accessibility verdict, from the same OUTCOME, what the engine's
# observe gave for accessibility (GRANTED), ERROR and FIX, and KEPT, where the
# request and answer of an engine error were kept. Only Hammerspoon can say,
# so it is skipped whenever Hammerspoon was not heard from.
accessibility_verdict() {
  local outcome="$1" granted="$2" error="$3" fix="$4" kept="$5" unheard="not checked: only Hammerspoon can say, and"
  case "$outcome" in
    nohs) record skip "$unheard there is no hs tool to ask it with" "" ;;
    stopped) record skip "$unheard Hammerspoon is not running" "" ;;
    2) record skip "$unheard Hammerspoon was not asked" "" ;;
    1) record skip "$unheard Hammerspoon did not answer" "" ;;
    3) record FAIL "unknown: the engine could not say: $error (its request and answer are kept at $kept)" "$fix" ;;
    *)
      case "$granted" in
        true) record ok "granted to Hammerspoon" "" ;;
        false) record FAIL "not granted to Hammerspoon" "System Settings > Privacy & Security > Accessibility: turn on Hammerspoon" ;;
        *) record FAIL "unknown: the engine's observe gave accessibility = '$granted'" "$(engine_failing)" ;;
      esac
      ;;
  esac
}

# One line of doctor's report, from the verdict VERDICT ARGS... gives for the
# precondition WHAT: ok, FAIL or skip, the precondition, its state, and for one
# that does not hold what fixes it. The verdict is taken whole before it is
# split, so a verdict that fails stops doctor rather than printing an empty
# line. Counts the lines, and the ones that do not hold, a skip among them.
DOCTOR_LINES=0
DOCTOR_FAILED=0
doctor_check() {
  local what="$1" verdict status state fix
  shift
  verdict="$("$@")"
  IFS=$'\037' read -r status state fix <<<"$verdict"
  DOCTOR_LINES=$((DOCTOR_LINES + 1))
  if [[ "$status" != "ok" ]]; then
    DOCTOR_FAILED=$((DOCTOR_FAILED + 1))
  fi
  if [[ -n "$fix" ]]; then
    printf '%-4s  %-15s  %s; fix: %s\n' "$status" "$what" "$state" "$fix"
  else
    printf '%-4s  %-15s  %s\n' "$status" "$what" "$state"
  fi
}

# ============================================================================
# VERBS
# ============================================================================

# One desk argument and no options, for the verbs that take exactly that.
one_desk() {
  local verb="$1"
  shift
  if [[ $# -ne 1 || "$1" == -* ]]; then
    refuse "$verb takes one desk name: arngz $verb <desk>"
  fi
  printf '%s\n' "$1"
}

cmd_list() {
  if [[ $# -gt 0 ]]; then
    refuse "list takes no arguments: '$1'"
  fi
  local dir name file width=0 status=0
  dir="$(catalogue_dir)"
  if [[ ! -d "$dir" ]]; then
    info "no catalogue at $dir (arngz init creates it)"
    return 0
  fi
  local names=()
  for file in "$dir"/*.yaml; do
    if [[ -f "$file" ]]; then
      name="$(basename "$file" .yaml)"
      names+=("$name")
      if [[ ${#name} -gt $width ]]; then width=${#name}; fi
    fi
  done
  if [[ ${#names[@]} -eq 0 ]]; then
    info "no desks in $dir (arngz discover --save <desk> records one)"
    return 0
  fi
  for name in "${names[@]}"; do
    if validate_desk "$name" 2>/dev/null; then
      printf "%-${width}s  %s\n" "$name" "$(desk_counts "$(desk_file "$name")")"
    else
      printf "%-${width}s  invalid: arngz show %s names why\n" "$name" "$name"
      status=1
    fi
  done
  return "$status"
}

cmd_show() {
  local desk
  desk="$(one_desk show "$@")"
  validate_desk "$desk" || exit 2
  cat "$(desk_file "$desk")"
}

# Delete judges the NAME and that the file exists, and deliberately not its
# content: a desk that no longer validates is exactly the one you want to be
# able to remove.
cmd_delete() {
  local desk file reason
  desk="$(one_desk delete "$@")"
  file="$(desk_file "$desk")"
  if reason="$(desk_name_refusal "$desk")"; then
    refuse "desk '$desk' ($file): $reason"
  fi
  if [[ ! -f "$file" ]]; then
    refuse "desk '$desk' does not exist: no $file"
  fi
  rm -- "$file"
  printf 'deleted %s\n' "$file"
}

# PURE: what stops init --yes, and what only a person can do, from the two
# plans' kinds and fields and what app_path returned for Hammerspoon, as a
# record of the two.
init_gate() {
  local hs_kind="$1" hs_a="$2" hs_b="$3" config_kind="$4" config_c="$5" app_rc="$6" blocked="" for_you=""
  if [[ "$hs_kind" == block ]]; then
    blocked="$hs_a"
  fi
  if [[ "$config_kind" == block ]]; then
    blocked="${blocked:+$blocked; }$config_c"
  fi
  if [[ "$hs_kind" == unlisted ]]; then
    for_you="$hs_b"
  fi
  if [[ ("$hs_kind" == have || "$hs_kind" == unlisted) && $app_rc -eq 1 ]]; then
    for_you="${for_you:+$for_you; }install Hammerspoon itself: $HAMMERSPOON_INSTALL"
  fi
  record "$blocked" "$for_you"
}

# PURE: init's closing lines, from whether --yes was given, the two plans'
# kinds, and init_gate's two answers.
init_closing() {
  local yes="$1" hs_kind="$2" config_kind="$3" blocked="$4" for_you="$5"
  if [[ -n "$blocked" ]]; then
    printf 'init --yes cannot finish until this is fixed: %s\n' "$blocked"
  elif [[ "$hs_kind" == link || "$config_kind" == append ]]; then
    if [[ $yes -eq 0 ]]; then
      printf 'nothing else changed: arngz init --yes does what is marked would\n'
    elif [[ "$config_kind" == append ]]; then
      printf "reload Hammerspoon's config (its menu bar icon: Reload Config) so it loads hs.ipc, then run arngz doctor\n"
    else
      printf 'run arngz doctor to check every precondition\n'
    fi
  fi
  if [[ -n "$for_you" ]]; then
    printf 'still for you to do: %s\n' "$for_you"
  fi
  if [[ -z "$blocked" && -z "$for_you" && "$hs_kind" == have && "$config_kind" == have ]]; then
    printf 'Hammerspoon setup: nothing to do\n'
  fi
}

# init: the catalogue, and what Hammerspoon needs for arngz (D16). Without
# --yes it creates the catalogue, says what --yes would do, and changes nothing
# else. With --yes it links the hs tool under the prefix, as Hammerspoon's own
# hs.ipc.cliInstall would, and appends the one marked line that loads hs.ipc
# to Hammerspoon's config. A step already done is said and skipped, so a
# second run changes nothing. Everything --yes would change is checked first,
# and what it cannot do is refused, exit 2, before anything changes; what only
# a person can do, it says. A step that fails anyway stops it (init_step).
cmd_init() {
  local yes=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --yes)
        yes=1
        shift
        ;;
      *) refuse "unknown option for init: '$1'" ;;
    esac
  done

  local dir prefix app app_rc=0 hs_plan config_plan gate hs_kind hs_a hs_b hs_c config_kind config config_c blocked for_you
  dir="$(catalogue_dir)"
  prefix="$(hs_prefix)"
  app="$(app_path "$HAMMERSPOON_BUNDLE")" || app_rc=$?
  # Each plan is taken whole before it is split, so a plan that fails is said
  # rather than read as one with nothing in it.
  hs_plan="$(init_hs_plan "$prefix" "$app" "$app_rc")" || refuse "init could not plan the hs tool: $hs_plan"
  config_plan="$(init_config_plan)" || refuse "init could not plan Hammerspoon's config: $config_plan"
  IFS=$'\037' read -r hs_kind hs_a hs_b hs_c <<<"$hs_plan"
  IFS=$'\037' read -r config_kind config config_c <<<"$config_plan"
  if [[ ! "$hs_kind" =~ ^(have|unlisted|block|link)$ || ! "$config_kind" =~ ^(have|append|block)$ ]]; then
    refuse "init could not plan: the hs tool's plan is '$hs_plan', the config's '$config_plan'"
  fi
  gate="$(init_gate "$hs_kind" "$hs_a" "$hs_b" "$config_kind" "$config_c" "$app_rc")"
  IFS=$'\037' read -r blocked for_you <<<"$gate"
  if [[ $yes -eq 1 && -n "$blocked" ]]; then
    refuse "init --yes changed nothing: $blocked"
  fi

  INIT_MADE=""
  if [[ -d "$dir" ]]; then
    printf 'catalogue: %s (exists)\n' "$dir"
  else
    init_step "make the catalogue $dir" mkdir -p "$dir"
    printf 'catalogue: %s (created)\n' "$dir"
  fi
  case "$app_rc" in
    0) printf 'Hammerspoon: installed at %s\n' "$app" ;;
    1) printf 'Hammerspoon: not installed: %s\n' "$HAMMERSPOON_INSTALL" ;;
    *) printf 'Hammerspoon: unknown: %s\n' "$app" ;;
  esac

  case "$hs_kind" in
    block) printf 'hs tool: cannot be linked: %s\n' "$hs_a" ;;
    link)
      if [[ $yes -eq 1 ]]; then
        link_hs_tool "$prefix" "$hs_a" "$hs_b"
        printf 'hs tool: linked %s/bin/hs to %s%s%s\n' "$prefix" "$hs_a" "${hs_b:+, and its man page}" "$hs_c"
      else
        printf 'hs tool: would link %s/bin/hs to %s%s%s\n' "$prefix" "$hs_a" "${hs_b:+, and its man page}" "$hs_c"
      fi
      ;;
    *) printf 'hs tool: %s\n' "$hs_a" ;;
  esac

  case "$config_kind" in
    have) printf 'init.lua: %s loads hs.ipc (line %s)\n' "$config" "$config_c" ;;
    block) printf 'init.lua: cannot be changed: %s\n' "$config_c" ;;
    *)
      if [[ $yes -eq 1 ]]; then
        append_ipc_line "$config"
        printf 'init.lua: appended to %s: %s\n' "$config" "$IPC_LINE"
      else
        printf 'init.lua: would append to %s: %s\n' "$config" "$IPC_LINE"
      fi
      ;;
  esac

  init_closing "$yes" "$hs_kind" "$config_kind" "$blocked" "$for_you"
}

# Every preference in MACOS_PREFS with pref_verdict's record for it, one per
# line: what, then the verdict's status, state and fix, joined by the unit
# separator. The one reading of the rows doctor and apply both take.
each_pref_verdict() {
  local what domain key unset_value want at0 at1 fix value rc verdict
  while IFS='|' read -r what domain key unset_value want at0 at1 fix; do
    rc=0
    value="$(read_pref "$domain" "$key")" || rc=$?
    # bash 3.2 runs a command substitution without -e, so a verdict that
    # fails is stopped here, by name, never printed as an empty record.
    verdict="$(pref_verdict "$rc" "$value" "$unset_value" "$want" "$at0" "$at1" "$fix")" || return 1
    printf '%s\037%s\n' "$what" "$verdict"
  done <<<"$MACOS_PREFS"
}

# apply's preferences, judged by the one owner of that verdict (D26) before
# the engine is asked: the first that does not hold refuses, exit 2.
apply_prefs() {
  local verdicts what status state fix
  verdicts="$(each_pref_verdict)" || refuse "apply: the macOS preferences could not be judged"
  while IFS=$'\037' read -r what status state fix; do
    if [[ "$status" != ok ]]; then
      refuse "apply: $what is $state; fix: $fix (arngz doctor checks every precondition)"
    fi
  done <<<"$verdicts"
}

# apply's options as the engine reads them, in a fresh temp dir whose path
# it prints: no_launch and no_create from 1 or 0, and map from MAPS, one
# name=uuid per line. Refuses by name when the dir or the file cannot be made.
apply_options() {
  local no_launch="$1" no_create="$2" maps="$3" dir options why map
  if ! dir="$(mktemp -d "${TMPDIR:-/tmp}/arngz-apply.XXXXXX" 2>&1)"; then
    refuse "apply: could not make a temp dir under ${TMPDIR:-/tmp} for its options: $dir"
  fi
  options="$dir/options.json"
  if ! why="$(NL="$no_launch" NC="$no_create" yq -n -o json \
    '.no_launch = (env(NL) == 1) | .no_create = (env(NC) == 1) | .map = {}' 2>&1 >"$options")"; then
    rm -rf -- "$dir"
    refuse "apply: could not write its options to $options: $why"
  fi
  while IFS= read -r map; do
    if [[ -n "$map" ]]; then
      if ! why="$(K="${map%%=*}" V="${map#*=}" yq -i -o json '.map[strenv(K)] = strenv(V)' "$options" 2>&1)"; then
        rm -rf -- "$dir"
        refuse "apply: could not write --map $map to $options: $why"
      fi
    fi
  done <<<"$maps"
  printf '%s\n' "$dir"
}

# apply (design.md "apply, in order"): validate, then either the engine's
# plan printed (--dry-run, no apply request sent) or the preferences judged
# and one apply request, whose report is printed and whose exit code is the
# engine's: 0 every entry placed, 1 any skipped, unseen or failed. A refusal
# before anything changed is 2. There is no --bind (D10, AC-05.6): it is
# refused as the unknown option it is.
cmd_apply() {
  local desk="" dry=0 no_launch=0 no_create=0 map name maps="" dir options rc code
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run) dry=1; shift ;;
      --no-launch) no_launch=1; shift ;;
      --no-create) no_create=1; shift ;;
      --map | --map=*)
        if [[ "$1" == --map ]]; then
          if [[ $# -lt 2 ]]; then refuse "--map takes <name>=<uuid>"; fi
          map="$2"
          shift 2
        else
          map="${1#--map=}"
          shift
        fi
        if [[ "$map" == *$'\n'* || ! "$map" =~ ^[^=]+=.+$ ]]; then refuse "--map = '$map': it takes <name>=<uuid>"; fi
        name="${map%%=*}"
        case $'\n'"$maps" in
          *$'\n'"$name="*) refuse "--map $name is given twice" ;;
        esac
        maps="$maps$map"$'\n'
        ;;
      -*) refuse "unknown option for apply: '$1'" ;;
      *)
        if [[ -n "$desk" ]]; then refuse "apply takes one desk, not '$desk' and '$1'"; fi
        desk="$1"
        shift
        ;;
    esac
  done
  if [[ -z "$desk" ]]; then refuse "apply takes a desk: arngz apply <desk>"; fi
  validate_desk "$desk" || exit 2
  if [[ $dry -eq 0 ]]; then
    apply_prefs
  fi

  dir="$(apply_options "$no_launch" "$no_create" "$maps")" || exit 2
  options="$dir/options.json"

  rc=0
  if [[ $dry -eq 1 ]]; then
    engine_ask plan "$(desk_file "$desk")" "$options" || rc=$?
  else
    engine_ask apply "$(desk_file "$desk")" "$options" || rc=$?
  fi
  rm -rf -- "$dir"
  if [[ $rc -ne 0 && $ENGINE_PENDING -eq 1 ]]; then
    # Taken and not answered: windows may be moving, so this is not "nothing
    # changed" (design.md "apply, in order", step 4).
    error "arngz: $ENGINE_ERROR (request kept at $ENGINE_DIR/request.json); fix: $ENGINE_FIX"
    exit 1
  fi
  if [[ $rc -eq 3 && $dry -eq 0 && "$ENGINE_KIND" != refused && -n "$ENGINE_RESPONSE" ]]; then
    # The engine answered, and not with a refusal: its own failure may come
    # after windows moved, so this is never "nothing changed".
    error "arngz: $ENGINE_ERROR; its response is kept at $ENGINE_RESPONSE; fix: $ENGINE_FIX"
    exit 1
  fi
  if [[ $rc -ne 0 ]]; then
    engine_refuse
  fi
  if [[ $dry -eq 1 ]]; then
    if ! render_report "$ENGINE_RESPONSE"; then
      refuse "the engine's plan could not be printed (kept at $ENGINE_RESPONSE)"
    fi
    rm -rf -- "$ENGINE_DIR"
    return 0
  fi
  # From here apply has run: a failure to say how it went is exit 1, with the
  # response kept, never "nothing changed".
  if ! render_report "$ENGINE_RESPONSE"; then
    error "arngz: apply ran, and its report could not be printed; its response is kept at $ENGINE_RESPONSE"
    exit 1
  fi
  if ! code="$(yq -r '.exit' "$ENGINE_RESPONSE" 2>&1)" || [[ "$code" != 0 && "$code" != 1 ]]; then
    error "arngz: apply ran, and its exit code reads '$code', not 0 or 1; its response is kept at $ENGINE_RESPONSE"
    exit 1
  fi
  rm -rf -- "$ENGINE_DIR"
  exit "$code"
}

# diff: what apply would do, one line per op with its reason, and nothing done.
# The engine plans and never executes on this path. Exit 1 when apply would
# change anything, 0 when it would not.
cmd_diff() {
  local desk ops
  desk="$(one_desk diff "$@")"
  validate_desk "$desk" || exit 2
  engine_call plan "$(desk_file "$desk")"
  render_report "$ENGINE_RESPONSE"
  ops="$(yq '.ops | length' "$ENGINE_RESPONSE")"
  rm -rf -- "$ENGINE_DIR"
  if [[ "$ops" -gt 0 ]]; then
    exit 1
  fi
}

# discover: the arrangement on screen now, as a desk (WP-04). The engine
# observes and builds the desk; this prints it as YAML, or saves it after the
# validator has accepted it. Everything the engine did not record is said on
# stderr, so stdout is the desk alone.
cmd_discover() {
  local save="" force=0 grid="8x4" dir options yaml target reason rc
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force) force=1; shift ;;
      --save)
        if [[ $# -lt 2 ]]; then refuse "--save takes a desk name"; fi
        save="$2"
        shift 2
        ;;
      --save=*) save="${1#--save=}"; shift ;;
      --grid)
        if [[ $# -lt 2 ]]; then refuse "--grid takes WxH, eg 8x4"; fi
        grid="$2"
        shift 2
        ;;
      --grid=*) grid="${1#--grid=}"; shift ;;
      *) refuse "unknown option for discover: '$1'" ;;
    esac
  done
  if [[ ! "$grid" =~ ^[1-9][0-9]*x[1-9][0-9]*$ ]]; then
    refuse "--grid = '$grid': a grid is WxH, eg 8x4"
  fi
  if [[ $force -eq 1 && -z "$save" ]]; then
    refuse "--force only means something with --save <desk>"
  fi
  if [[ -n "$save" ]]; then
    target="$(desk_file "$save")"
    if reason="$(desk_name_refusal "$save")"; then
      refuse "desk '$save' ($target): $reason"
    fi
    if [[ -e "$target" && $force -eq 0 ]]; then
      refuse "desk '$save' exists: $target (--force overwrites it)"
    fi
  fi

  dir="$(mktemp -d "${TMPDIR:-/tmp}/arngz-discover.XXXXXX")"
  options="$dir/options.json"
  G="$grid" N="${save:-discovered}" yq -n -o json '.grid = strenv(G) | .name = strenv(N)' >"$options"
  # Refused as engine_call refuses, once this verb's own temp dir is gone: the
  # request the engine kept carries the options in it.
  rc=0
  engine_ask discover "" "$options" || rc=$?
  if [[ $rc -ne 0 ]]; then
    rm -rf -- "$dir"
    engine_refuse
  fi
  yaml="$dir/desk.yaml"
  render_desk "$ENGINE_RESPONSE" >"$yaml"
  render_report "$ENGINE_RESPONSE" >&2
  # What discover writes, the validator must accept: a refusal here is a bug in
  # discover, and it is said rather than saved.
  validate_desk_file "${save:-discovered}" "$yaml" || refuse "discover built a desk the validator refuses (kept at $yaml)"
  rm -rf -- "$ENGINE_DIR"

  if [[ -z "$save" ]]; then
    cat "$yaml"
  else
    mkdir -p "$(catalogue_dir)"
    mv -- "$yaml" "$target"
    info "saved $target"
  fi
  rm -rf "$dir"
}

# doctor: every precondition the engine's verbs need, each named with its
# state and, where it does not hold, what fixes it; exit 1 when any does not.
# It reads the machine itself, and asks Hammerspoon only what only Hammerspoon
# can say (that IPC answers, and its Accessibility grant), so it completes with
# no Hammerspoon at all and names it as missing. A check that cannot run
# because an earlier one failed is said as not checked, and does not hold.
cmd_doctor() {
  if [[ $# -gt 0 ]]; then
    refuse "doctor takes no arguments: '$1'"
  fi
  local app app_rc=0 uid ps ps_rc=0 tool state detail fix hs="" outcome granted="" kept=""

  # Hammerspoon: this user's, because with fast user switching another
  # session's Hammerspoon runs too, and this user's hs cannot reach it.
  app="$(app_path "$HAMMERSPOON_BUNDLE")" || app_rc=$?
  uid="$(id -u)"
  ps="$(pgrep -x -U "$uid" "$HAMMERSPOON_PROCESS" 2>&1)" || ps_rc=$?
  doctor_check Hammerspoon hammerspoon_verdict "$app" "$app_rc" "$ps_rc" "$ps" "pgrep -x -U $uid $HAMMERSPOON_PROCESS"

  tool="$(hs_tool_state "$(hs_prefix)")"
  IFS=$'\037' read -r state detail fix <<<"$tool"
  doctor_check "hs tool" hs_tool_verdict "$state" "$detail" "$fix"
  if [[ "$state" == ok ]]; then
    hs="$detail"
  fi

  # Asked of the engine, through the one engine call, as observe: its world
  # carries Hammerspoon's own Accessibility state. Never asked when nothing
  # could answer, so a missing Hammerspoon or hs is said, never waited on. Its
  # request is kept only when the engine answered with an error, which may be
  # worth a look; the Accessibility line says where.
  if [[ -z "$hs" ]]; then
    outcome=nohs
  elif [[ $ps_rc -eq 1 ]]; then
    outcome=stopped
  else
    outcome=0
    engine_ask observe || outcome=$?
    if [[ $outcome -eq 0 ]]; then
      granted="$(yq -r '.world.accessibility' "$ENGINE_RESPONSE" 2>&1)" || granted="(unreadable: $granted)"
    fi
    if [[ $outcome -eq 3 ]]; then
      kept="$ENGINE_DIR"
    elif [[ -n "$ENGINE_DIR" ]]; then
      rm -rf -- "$ENGINE_DIR"
    fi
  fi
  doctor_check IPC ipc_verdict "$outcome" "$hs" "$ENGINE_ERROR" "$ENGINE_FIX"
  doctor_check Accessibility accessibility_verdict "$outcome" "$granted" "$ENGINE_ERROR" "$ENGINE_FIX" "$kept"

  local verdicts what status
  # Taken whole first, so a reading that fails stops doctor rather than
  # printing nothing for it.
  verdicts="$(each_pref_verdict)" || refuse "doctor: the macOS preferences could not be judged"
  while IFS=$'\037' read -r what status state fix; do
    doctor_check "$what" record "$status" "$state" "$fix"
  done <<<"$verdicts"

  if [[ $DOCTOR_FAILED -gt 0 ]]; then
    printf 'arngz doctor: %d of %d preconditions do not hold\n' "$DOCTOR_FAILED" "$DOCTOR_LINES"
    exit 1
  fi
  printf 'arngz doctor: all %d preconditions hold\n' "$DOCTOR_LINES"
}

# ============================================================================
# MAIN
# ============================================================================

main() {
  if [[ $# -eq 0 ]]; then
    usage >&2
    exit 2
  fi
  local verb="$1"
  shift
  if [[ "$verb" != -h && "$verb" != --help ]]; then
    load_hammerspoon
  fi
  case "$verb" in
    -h | --help)
      usage
      ;;
    list) cmd_list "$@" ;;
    show) cmd_show "$@" ;;
    delete) cmd_delete "$@" ;;
    init) cmd_init "$@" ;;
    apply) cmd_apply "$@" ;;
    diff) cmd_diff "$@" ;;
    discover) cmd_discover "$@" ;;
    doctor) cmd_doctor "$@" ;;
    -*) refuse "unknown option: '$verb' (arngz --help names the verbs)" ;;
    *) cmd_apply "$verb" "$@" ;;
  esac
}

require_yq || exit 2
main "$@"

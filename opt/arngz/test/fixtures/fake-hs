#!/usr/bin/env bash
#
# A stand-in for Hammerspoon's hs tool, for arngz.bats (ST0026 AT-03.1). It
# behaves as FAKE_HS_MODE says, and records what it was asked in
# FAKE_HS_LOG/argv and FAKE_HS_LOG/request.json, so a test reads exactly what
# the CLI sent.
#
#   ok                 write FAKE_HS_RESPONSE beside the request, print a line
#   none               exit 0 having written nothing
#   hang               write nothing and never return
#   hang-after-reply   write the response, then never return (measured on a
#                      real hs, 16 Oct 2026)
#   exit-69            exit 69, as hs does when Hammerspoon is unreachable
#   receive-timeout    exit 69 with "receive timeout", as hs does when the
#                      message was delivered and the reply came too late
#   exit-75            exit 75, which the CLI reads as Hammerspoon not running
#   lua-error          exit 65 with an error, as hs does for a Lua error
#   scheduled          say the verb was scheduled and exit 0, then write the
#                      response FAKE_HS_DELAY seconds later (default 1), as
#                      the engine does for apply (D20 as amended)
#   scheduled-never    say the verb was scheduled, exit 0, and never answer

set -euo pipefail
printf '%s\n' "$@" >"$FAKE_HS_LOG/argv"
# Whether the caller gave hs /dev/null as stdin, which the real hs needs.
if [[ /dev/fd/0 -ef /dev/null ]]; then
  echo devnull >"$FAKE_HS_LOG/stdin"
else
  echo other >"$FAKE_HS_LOG/stdin"
fi
code=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -c) code="$2"; shift 2 ;;
    *) shift ;;
  esac
done
request="$(printf '%s\n' "$code" | sed -n 's/.*\.run("\(.*\)").*/\1/p')"
[[ -n "$request" ]] || { echo "fake-hs: no run(\"...\") in: $code" >&2; exit 64; }
cp "$request" "$FAKE_HS_LOG/request.json"
response="$(dirname "$request")/response.json"

case "${FAKE_HS_MODE:-ok}" in
  ok) cp "$FAKE_HS_RESPONSE" "$response"; echo "arngz: ok observe" ;;
  none) exit 0 ;;
  hang) exec sleep 300 ;;
  hang-after-reply) cp "$FAKE_HS_RESPONSE" "$response"; exec sleep 300 ;;
  exit-69) echo "error: can't access Hammerspoon message port" >&2; exit 69 ;;
  receive-timeout) echo "error: receive timeout" >&2; exit 69 ;;
  exit-75) echo "error: Hammerspoon is not running" >&2; exit 75 ;;
  lua-error) echo "attempt to index a nil value" >&2; exit 65 ;;
  scheduled | scheduled-never)
    if [[ "$FAKE_HS_MODE" == scheduled ]]; then
      # Written aside and renamed, as the engine does, by a child that holds
      # none of the caller's pipes open.
      # Its errors go to the log, so a test that waits in vain can show why,
      # and it holds no descriptor of the caller's, bats' fd 3 included.
      (sleep "${FAKE_HS_DELAY:-1}" && cp "$FAKE_HS_RESPONSE" "$response.partial" && mv "$response.partial" "$response") \
        </dev/null >/dev/null 2>"$FAKE_HS_LOG/scheduled.err" 3>&- &
    fi
    verb="$(yq -r '.verb' "$request")"
    echo "arngz: scheduled $verb"
    ;;
  *) echo "fake-hs: unknown FAKE_HS_MODE '$FAKE_HS_MODE'" >&2; exit 64 ;;
esac

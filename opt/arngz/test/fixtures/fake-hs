#!/usr/bin/env bash
#
# A stand-in for Hammerspoon's hs tool, for arngz.bats (ST0026 AT-03.1). It
# behaves as FAKE_HS_MODE says, and records what it was asked in
# FAKE_HS_LOG/argv and FAKE_HS_LOG/request.json, so a test reads exactly what
# the CLI sent.
#
#   ok                 write FAKE_HS_RESPONSE beside the request, print a line
#   none               exit 0 having written nothing
#   hang               write nothing and never return
#   hang-after-reply   write the response, then never return (measured on a
#                      real hs, 16 Oct 2026)
#   reply-then-exit    write the response, then exit 0 FAKE_HS_EXIT_AFTER
#                      seconds later, as an hs still finishing its IPC does
#   exit-69            exit 69, as hs does when Hammerspoon is unreachable
#   receive-timeout    exit 69 with "receive timeout", as hs does when the
#                      message was delivered and the reply came too late
#   exit-75            exit 75, which the CLI reads as Hammerspoon not running
#   lua-error          exit 65 with an error, as hs does for a Lua error
#   scheduled          say the verb was scheduled and exit 0, then write the
#                      response FAKE_HS_DELAY seconds later (default 1), as
#                      the engine does for apply (D20 as amended)
#   scheduled-never    say the verb was scheduled, exit 0, and never answer
#   unsettled-once     answer the test's first ask as the engine's quiet gate does
#                      while the displays settle (WP 93ea7f8a): unsettled,
#                      with FAKE_HS_WAIT and FAKE_HS_BEGAN; every later ask
#                      as ok does
#   unsettled-moved    as unsettled-once, but the second ask is unsettled
#                      too, its wait begun again at FAKE_HS_BEGAN_AGAIN, as a
#                      faulty engine's would be; every later ask as ok does
#   sequence           answer the n-th ask as FAKE_HS_SEQUENCE says, for a
#                      command that asks several verbs, as a reload and its
#                      retry do (ST6d8eed9 WP a45b3aeb): FAKE_HS_SEQUENCE/<n>.json
#                      is that ask's response, written as ok writes it, and
#                      FAKE_HS_SEQUENCE/<n>.mode names another mode for it (eg
#                      exit-69, as while Hammerspoon reloads). An ask with
#                      neither is answered by rest.json or rest.mode.
#
# Every ask is also kept as FAKE_HS_LOG/request.<n>.json, counting from 1, for
# a verb that asks more than once.
#
# A MARK CALL IS NOT AN ASK (hv decision 53). The CLI's short call
# `.mark("<kind>", "<words>", <seconds>)` is one line in FAKE_HS_LOG/calls,
# "mark <kind> <seconds> <words>", and touches nothing an ask's arms read
# (argv, stdin, asks, request.json). Each ask is a line there too, "run
# <verb>", so an arm reads the marks and the asks in the order they came.
# FAKE_HS_MARK_EXIT makes a mark call exit so after its line, eg 69, as hs
# does when Hammerspoon cannot be reached; FAKE_HS_MODE is for the asks alone.
# A still call prints FAKE_HS_STILL_ANSWER, the engine's answer that the CLI
# reads (M1, hv decision 53), and prints nothing when it is empty or unset.

set -euo pipefail
code="" prev=""
for arg in "$@"; do
  if [[ "$prev" == -c ]]; then code="$arg"; fi
  prev="$arg"
done
mark="$(printf '%s\n' "$code" | sed -n 's/^return dofile("[^"]*")\.mark("\([^"]*\)", "\([^"]*\)", \([0-9]*\))$/\1 \3 \2/p')"
if [[ -n "$mark" ]]; then
  printf 'mark %s\n' "$mark" >>"$FAKE_HS_LOG/calls"
  if [[ "$mark" == "still "* && -n "${FAKE_HS_STILL_ANSWER:-}" ]]; then
    printf '%s\n' "$FAKE_HS_STILL_ANSWER"
  fi
  exit "${FAKE_HS_MARK_EXIT:-0}"
fi
printf '%s\n' "$@" >"$FAKE_HS_LOG/argv"
# Whether the caller gave hs /dev/null as stdin, which the real hs needs.
if [[ /dev/fd/0 -ef /dev/null ]]; then
  echo devnull >"$FAKE_HS_LOG/stdin"
else
  echo other >"$FAKE_HS_LOG/stdin"
fi
request="$(printf '%s\n' "$code" | sed -n 's/.*\.run("\(.*\)").*/\1/p')"
[[ -n "$request" ]] || { echo "fake-hs: no run(\"...\") or mark(...) in: $code" >&2; exit 64; }
cp "$request" "$FAKE_HS_LOG/request.json"
printf 'run %s\n' "$(yq -r '.verb' "$request")" >>"$FAKE_HS_LOG/calls"
asks=0
if [[ -f "$FAKE_HS_LOG/asks" ]]; then asks="$(cat "$FAKE_HS_LOG/asks")"; fi
asks=$((asks + 1))
echo "$asks" >"$FAKE_HS_LOG/asks"
cp "$request" "$FAKE_HS_LOG/request.$asks.json"
response="$(dirname "$request")/response.json"

# The engine's quiet gate's answer while the displays settle (WP 93ea7f8a):
# unsettled, with FAKE_HS_WAIT and the start given, written aside and
# renamed, as the engine writes its answers.
answer_unsettled() {
  local verb
  verb="$(yq -r '.verb' "$request")"
  V="$verb" W="${FAKE_HS_WAIT:?}" B="$1" yq -n -o json \
    '{"status": "ok", "verb": strenv(V), "unsettled": {"wait": strenv(W), "began": strenv(B)}}' >"$response.partial"
  mv "$response.partial" "$response"
}

# A sequence names each ask's own answer: the mode it is given, and for ok
# its response.
if [[ "${FAKE_HS_MODE:-ok}" == sequence ]]; then
  FAKE_HS_MODE=""
  for answer in "${FAKE_HS_SEQUENCE:?}/$asks" "$FAKE_HS_SEQUENCE/rest"; do
    if [[ -f "$answer.mode" ]]; then
      FAKE_HS_MODE="$(cat "$answer.mode")"
      break
    fi
    if [[ -f "$answer.json" ]]; then
      FAKE_HS_MODE=ok
      FAKE_HS_RESPONSE="$answer.json"
      break
    fi
  done
  [[ -n "$FAKE_HS_MODE" ]] || { echo "fake-hs: no answer for ask $asks in $FAKE_HS_SEQUENCE" >&2; exit 64; }
fi

# A hang keeps this fake's path as its name (exec -a), so arngz.bats's
# teardown finds and stops a hung ask that outlives its arm.
case "${FAKE_HS_MODE:-ok}" in
  ok) cp "$FAKE_HS_RESPONSE" "$response"; echo "arngz: ok observe" ;;
  none) exit 0 ;;
  hang) exec -a "$0" sleep 300 ;;
  hang-after-reply) cp "$FAKE_HS_RESPONSE" "$response"; exec -a "$0" sleep 300 ;;
  reply-then-exit) cp "$FAKE_HS_RESPONSE" "$response"; sleep "${FAKE_HS_EXIT_AFTER:?}"; echo "arngz: ok" ;;
  exit-69) echo "error: can't access Hammerspoon message port" >&2; exit 69 ;;
  receive-timeout) echo "error: receive timeout" >&2; exit 69 ;;
  exit-75) echo "error: Hammerspoon is not running" >&2; exit 75 ;;
  lua-error) echo "attempt to index a nil value" >&2; exit 65 ;;
  scheduled | scheduled-never)
    if [[ "$FAKE_HS_MODE" == scheduled ]]; then
      # Written aside and renamed, as the engine does, by a child that holds
      # none of the caller's pipes open.
      # Its errors go to the log, so a test that waits in vain can show why,
      # and it holds no descriptor of the caller's, bats' fd 3 included.
      (sleep "${FAKE_HS_DELAY:-1}" && cp "$FAKE_HS_RESPONSE" "$response.partial" && mv "$response.partial" "$response") \
        </dev/null >/dev/null 2>"$FAKE_HS_LOG/scheduled.err" 3>&- &
    fi
    verb="$(yq -r '.verb' "$request")"
    echo "arngz: scheduled $verb"
    ;;
  unsettled-once)
    if [[ "$asks" == 1 ]]; then
      answer_unsettled "${FAKE_HS_BEGAN:?}"
    else
      cp "$FAKE_HS_RESPONSE" "$response"
    fi
    echo "arngz: ok"
    ;;
  unsettled-moved)
    case "$asks" in
      1) answer_unsettled "${FAKE_HS_BEGAN:?}" ;;
      2) answer_unsettled "${FAKE_HS_BEGAN_AGAIN:?}" ;;
      *) cp "$FAKE_HS_RESPONSE" "$response" ;;
    esac
    echo "arngz: ok"
    ;;
  *) echo "fake-hs: unknown FAKE_HS_MODE '$FAKE_HS_MODE'" >&2; exit 64 ;;
esac

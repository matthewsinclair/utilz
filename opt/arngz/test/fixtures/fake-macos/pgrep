#!/usr/bin/env bash
#
# A stand-in for pgrep, for arngz.bats (ST0026 AT-06). `pgrep -x <name>`
# finds <name> when it is one of the words in FAKE_RUNNING; a word
# `<name>@other` is another user's process of that name. `pgrep -x -U <uid>
# <name>` finds only this user's, so `<name>@other` never matches it. Nothing
# else is faked. FAKE_PGREP_EXIT makes it fail as pgrep itself can (2 or 3),
# with that exit and a message on stderr.

set -euo pipefail
if [[ $# -eq 2 && "$1" == "-x" ]]; then
  uid=""
  name="$2"
elif [[ $# -eq 4 && "$1" == "-x" && "$2" == "-U" ]]; then
  uid="$3"
  name="$4"
else
  echo "fake pgrep: only 'pgrep -x [-U <uid>] <name>' is faked, not: $*" >&2
  exit 64
fi
if [[ -n "${FAKE_PGREP_EXIT:-}" ]]; then
  echo "pgrep: cannot read the process table" >&2
  exit "$FAKE_PGREP_EXIT"
fi
# shellcheck disable=SC2086 # FAKE_RUNNING is a list of words, split on purpose
for word in ${FAKE_RUNNING:-}; do
  if [[ "$word" == "$name" && ( -z "$uid" || "$uid" == "$(id -u)" ) ]]; then
    echo 4242
    exit 0
  fi
  if [[ "$word" == "$name@other" && -z "$uid" ]]; then
    echo 4343
    exit 0
  fi
done
exit 1

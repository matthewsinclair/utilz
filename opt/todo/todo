#!/usr/bin/env bash
#
# todo - Simple DOING/TODO/DONE manager for a plain-text todo.md
#
# A standalone fork of Intent's `intent todo`, factored out of Intent. Unlike
# Intent (where todo.md is a read-only projection of steel-thread status), here
# the todo.md file IS the source of truth: items are freeform one-line strings,
# each named by an id that stays with it (issue 0033), in three buckets --
# DOING / TODO / DONE.
#
# The file format stays mutually compatible with Intent (same bucket headings,
# `[ ]`/`[-]`/`[x]` glyphs, `## DONE:<watermark>`), with two additions: YAML
# frontmatter (title + history pointer) and per-item numbers.
#
# Design: intent/st/ST0008/design.md

set -euo pipefail

# Source common functions if not already loaded (from dispatcher)
if [[ "$(type -t info 2>/dev/null)" != "function" ]]; then
  SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  UTILZ_HOME="${UTILZ_HOME:-$(cd "$SCRIPT_DIR/../.." && pwd)}"

  if [[ -f "$UTILZ_HOME/opt/utilz/lib/common.sh" ]]; then
    source "$UTILZ_HOME/opt/utilz/lib/common.sh"
  else
    echo "ERROR: Cannot find common.sh library" >&2
    exit 1
  fi
fi

# ============================================================================
# STATE (populated by parse_file; consumed by write_file / renderers)
# ============================================================================

TODO_FILE=""
TITLE="# TODO"
HISTORY="_history/YYYYMMDD-done.md"
WATERMARK=""

# Ownership marker stamped into frontmatter. Highlander with `intent todo`: each
# tool writes `generator: <tool> todo` and refuses to overwrite a file owned by
# the other. See guard_foreign_todo. (ST0008/WP-08.)
TODO_GENERATOR="utilz todo"

# One indexed array per bucket holding item TEXT (glyph is derived from the
# bucket), and beside it one holding each item's ID at the same index: the id
# is the item's name, not its position, and it moves with the item (issue
# 0033). Orphan arrays hold unrecognized non-blank lines, preserved verbatim at
# the tail of their bucket (No Silent Errors: warned, never dropped).
DOING_ITEMS=(); TODO_ITEMS=(); DONE_ITEMS=()
DOING_IDS=(); TODO_IDS=(); DONE_IDS=()
DOING_ORPHANS=(); TODO_ORPHANS=(); DONE_ORPHANS=()

# THE NEXT ID NEVER USED IN THIS FILE, persisted as the frontmatter's next-id
# (issue 0033). "Free" means never used, not currently unused: an id freed by
# prune or flush and handed to a new item would re-point every old citation of
# it at the new one. Parse takes the larger of the recorded mark and one past
# the highest id present, so a hand-added item with a bigger id cannot collide.
# The key is load-bearing: it is the only record of ids above the highest one
# still present.
NEXT_ID=1

# Set by _counts / _resolve_n / move_item
A=0; B=0; C=0; WIDTH=1
SRC_BUCKET=""; SRC_IDX=-1; SPLICED=""; SPLICED_ID=""

# ============================================================================
# TIME HELPERS
# ============================================================================

_now_iso() { date -u +%Y-%m-%dT%H:%M:%SZ; }
_now_day() { date -u +%Y-%m-%dT00:00:00Z; }

# ============================================================================
# PARSE (the single tolerant reader -- Highlander)
# ============================================================================

# Strip a `key: ` frontmatter prefix, returning the value.
_fm_val() { printf '%s' "${1#*: }"; }

# Normalize the title so the body H1 always carries a leading `# `.
_normalize_title() {
  case "$TITLE" in
  \#*) : ;;
  *) TITLE="# $TITLE" ;;
  esac
}

# Read TODO_FILE into the bucket arrays. Missing file -> empty structure with
# defaults (so the first write materializes a template). Glyph is authoritative:
# an item is routed to a bucket by its checkbox, not by the section it sits under.
#
# IDS ARE KEPT (issue 0033): each item line's id is read and stored beside its
# text. An item with no id, or with an id an earlier line already carries,
# takes the next id never used in this file, in file order, once every line
# has been read; a duplicate is warned about, naming both ids.
parse_file() {
  DOING_ITEMS=(); TODO_ITEMS=(); DONE_ITEMS=()
  DOING_IDS=(); TODO_IDS=(); DONE_IDS=()
  DOING_ORPHANS=(); TODO_ORPHANS=(); DONE_ORPHANS=()
  TITLE="# TODO"
  HISTORY="_history/YYYYMMDD-done.md"
  WATERMARK=""
  NEXT_ID=1

  # A create-time title override applies only to a fresh file; an existing
  # file's `title:` wins (preserved) because it is read after this.
  if [[ -n "${TITLE_OPT:-}" ]]; then TITLE="$TITLE_OPT"; fi

  if [[ ! -f "$TODO_FILE" ]]; then
    WATERMARK="$(_now_day)"
    _normalize_title
    return 0
  fi

  local item_re='^[[:space:]]*(- )?([0-9]+:)?\[([ xX-])\] ?(.*)$'
  local in_fm=0 seen_fm=0 section="" line g txt id bucket idx entry
  local recorded_next="" max_id=0
  local -a seen=() pending=() dups=()

  while IFS= read -r line || [[ -n "$line" ]]; do
    # Frontmatter block (only the first `---`-delimited block at the top)
    if [[ $seen_fm -eq 0 && "$line" == "---" ]]; then
      in_fm=1; seen_fm=1; continue
    fi
    if [[ $in_fm -eq 1 ]]; then
      if [[ "$line" == "---" ]]; then in_fm=0; continue; fi
      case "$line" in
      title:*)
        TITLE="$(_fm_val "$line")"
        TITLE="${TITLE%\"}"; TITLE="${TITLE#\"}"
        ;;
      history:*) HISTORY="$(_fm_val "$line")" ;;
      next-id:*) recorded_next="$(_fm_val "$line")" ;;
      esac
      continue
    fi

    # Bucket headings + inert lines
    case "$line" in
    "## DOING") section="DOING"; continue ;;
    "## TODO") section="TODO"; continue ;;
    "## DONE:"*) section="DONE"; WATERMARK="${line#\#\# DONE:}"; continue ;;
    "#"*) continue ;;
    "") continue ;;
    "_(none)_") continue ;;
    esac

    # Item line? (tolerant: optional GFM dash, optional number, loose spacing)
    if [[ "$line" =~ $item_re ]]; then
      g="${BASH_REMATCH[3]}"
      txt="${BASH_REMATCH[4]}"
      # The id sits before the checkbox in the pre-2026-09 form (`01:[ ] text`)
      # and after it, in a code span, in the current one (`- [ ] \`01\` text`).
      # Either is the item's id, and it is KEPT (issue 0033); the current form
      # wins if a line somehow carries both.
      id="${BASH_REMATCH[2]%:}"
      if [[ "$txt" =~ ^\`([0-9]+)\`[[:space:]]+(.*)$ ]]; then
        id="${BASH_REMATCH[1]}"
        txt="${BASH_REMATCH[2]}"
      fi
      case "$g" in
      "-") bucket="DOING" ;;
      " ") bucket="TODO" ;;
      *) bucket="DONE" ;;
      esac
      eval "idx=\${#${bucket}_ITEMS[@]}"
      eval "${bucket}_ITEMS+=(\"\$txt\")"
      if [[ -n "$id" ]]; then id=$((10#$id)); fi
      if [[ -n "$id" && -z "${seen[id]:-}" ]]; then
        seen[id]=1
        eval "${bucket}_IDS+=(\"\$id\")"
        if ((id > max_id)); then max_id=$id; fi
      else
        # No id, or one an earlier line already carries: an id is assigned
        # below, once the highest in the file is known.
        if [[ -n "$id" ]]; then dups+=("$id:$bucket:$idx"); fi
        eval "${bucket}_IDS+=(\"\")"
        pending+=("$bucket:$idx")
      fi
      continue
    fi

    # Unrecognized non-blank line: warn + preserve under its bucket.
    warn "todo: unrecognized line under ${section:-<preamble>}: $line"
    case "$section" in
    DOING) DOING_ORPHANS+=("$line") ;;
    DONE) DONE_ORPHANS+=("$line") ;;
    *) TODO_ORPHANS+=("$line") ;;
    esac
  done < "$TODO_FILE"

  if [[ -z "$WATERMARK" ]]; then WATERMARK="$(_now_day)"; fi
  _normalize_title

  # The next id: past the highest present, and past the recorded mark.
  NEXT_ID=$((max_id + 1))
  if [[ -n "$recorded_next" ]]; then
    if [[ "$recorded_next" =~ ^[0-9]+$ ]]; then
      if ((10#$recorded_next > NEXT_ID)); then NEXT_ID=$((10#$recorded_next)); fi
    else
      warn "todo: next-id '$recorded_next' is not a number, so it was ignored"
    fi
  fi
  for entry in "${pending[@]+"${pending[@]}"}"; do
    eval "${entry%%:*}_IDS[${entry#*:}]=$NEXT_ID"
    NEXT_ID=$((NEXT_ID + 1))
  done

  # A duplicate is never silent: name the id both lines carried and the one
  # the later line now takes.
  _counts
  local dup_old dup_at dup_new dup_text
  for entry in "${dups[@]+"${dups[@]}"}"; do
    dup_old="${entry%%:*}"
    dup_at="${entry#*:}"
    eval "dup_new=\${${dup_at%%:*}_IDS[${dup_at#*:}]}; dup_text=\${${dup_at%%:*}_ITEMS[${dup_at#*:}]}"
    warn "$(printf 'todo: two items carry id %0*d; the later one, "%s", takes %0*d' "$WIDTH" "$dup_old" "$dup_text" "$WIDTH" "$dup_new")"
  done
}

# ============================================================================
# OWNERSHIP GUARD (mutual non-clobber with intent todo -- ST0008/WP-08)
# ============================================================================

# Is Intent installed? Overridable via UTILZ_TODO_INTENT_PRESENT (1=yes, 0=no;
# unset = auto-detect) for deterministic tests and as a manual override.
_intent_present() {
  case "${UTILZ_TODO_INTENT_PRESENT:-}" in
  1) return 0 ;;
  0) return 1 ;;
  *) command -v intent >/dev/null 2>&1 ;;
  esac
}

# Does TODO_FILE sit inside an Intent project? Walk upward from the file's own
# directory for the v2.0 marker intent/.config/config.json. Mirrors Intent's
# find_project_root but anchored on the file we are about to overwrite (not on
# cwd), so pointing --file at another project's todo.md is still caught.
_in_intent_project() {
  local dir
  dir=$(cd "$(dirname "$TODO_FILE")" 2>/dev/null && pwd) || return 1
  while [[ "$dir" != "/" ]]; do
    if [[ -f "$dir/intent/.config/config.json" ]]; then return 0; fi
    dir=$(dirname "$dir")
  done
  return 1
}

# Refuse to overwrite a todo.md owned by a different generator. Mirrors Intent's
# guard_foreign_todo: read the leading --- block's generator:. Proceed when the
# file is absent, frontmatter-less, carries no generator (utilz's own pre-marker
# title:/history: file), or is our own. A foreign marker (eg intent todo) is
# refused ONLY when Intent is present AND the file sits in an Intent project --
# utilz stays silent and never fails where Intent is not in play.
guard_foreign_todo() {
  if [[ ! -f "$TODO_FILE" ]]; then
    # Fresh file. Refuse to CREATE a default ./todo.md inside an Intent project
    # (Intent owns todos there); explicit --file/-g and non-project dirs proceed.
    if [[ "${DEFAULT_PATH:-0}" -eq 1 ]] && _intent_present && _in_intent_project; then
      error "todo: refusing to create '$TODO_FILE' inside an Intent project -- use 'intent todo' here, or pass --file/-g for a standalone list."
      exit 1
    fi
    return 0
  fi
  head -1 "$TODO_FILE" | grep -q '^---[[:space:]]*$' || return 0
  local fm gen
  fm=$(sed -n '2,/^---[[:space:]]*$/p' "$TODO_FILE")
  gen=$(printf '%s\n' "$fm" | sed -n 's/^generator:[[:space:]]*//p' | head -1)
  [[ -z "$gen" ]] && return 0
  [[ "$gen" == "$TODO_GENERATOR" ]] && return 0
  _intent_present || return 0
  _in_intent_project || return 0
  error "todo: refusing to overwrite '$TODO_FILE' -- managed by '$gen', not '$TODO_GENERATOR' (an Intent project owns it). Let '$gen' manage this file, or use --file elsewhere."
  exit 1
}

# ============================================================================
# RENDER + WRITE (the single writer -- Highlander, atomic)
# ============================================================================

_counts() {
  A=${#DOING_ITEMS[@]}
  B=${#TODO_ITEMS[@]}
  C=${#DONE_ITEMS[@]}
  # Ids pad to three, so the column keeps its shape as ids cross ten and a
  # hundred. The width follows the highest id this file has ever used, the
  # one before NEXT_ID, so it never narrows when a high id is pruned; past 999
  # it grows rather than truncating.
  local highest=$((NEXT_ID - 1))
  WIDTH=${#highest}
  if ((WIDTH < 3)); then WIDTH=3; fi
}

# Emit one bucket's item lines, each with its own id: <glyphchar> <BUCKET>
#
# GFM task-list shape: `- [ ] \`01\` text`. The leading dash makes each item a
# real list item, which is what stops a run of them collapsing into one
# paragraph anywhere markdown is actually rendered - the estate's CMS, Obsidian,
# a GitHub blob. `[ ]` and `[x]` then render as checkboxes for free.
#
# The id moved to AFTER the checkbox and into a code span, because a task list
# marker only counts when it directly follows the bullet: `- 01:[ ] text` is a
# plain list item with literal text, `- [ ] \`01\` text` is a checkbox. The id
# still has to be visible - it is the handle every command takes.
#
# `[-]` for DOING is not a GFM marker and renders as literal text. That is
# deliberate: the glyph is what `toggle` and `sync` reconcile against, it is
# what the legend documents, and a DOING item reading `[-]` under its own
# heading is clear enough. Correctness of the round trip beats a checkbox.
_emit_bucket() {
  local g="$1" b="$2" n i t id
  eval "n=\${#${b}_ITEMS[@]}"
  for ((i = 0; i < n; i++)); do
    eval "t=\${${b}_ITEMS[$i]}; id=\${${b}_IDS[$i]}"
    # shellcheck disable=SC2016
    # The backticks are LITERAL -- markdown code fencing around the item
    # number, in a printf FORMAT string. Single quotes are the correct quoting
    # here and double quotes would be the bug: the format holds %s and %0*d,
    # which printf expands, and the shell must not. SC2016 reads the backticks
    # as an attempted command substitution and cannot tell the difference.
    printf -- '- [%s] `%0*d` %s\n' "$g" "$WIDTH" "$id" "$t"
  done
}

write_file() {
  guard_foreign_todo
  _counts
  local tmp
  tmp=$(mktemp)
  {
    printf -- '---\n'
    printf 'generator: %s\n' "$TODO_GENERATOR"
    printf 'title: "%s"\n' "$TITLE"
    printf 'history: %s\n' "$HISTORY"
    printf 'next-id: %s\n' "$NEXT_ID"
    printf -- '---\n\n'
    printf '%s\n\n' "$TITLE"

    printf '## DOING\n\n'
    if [[ $A -gt 0 ]]; then _emit_bucket '-' DOING; fi
    if [[ ${#DOING_ORPHANS[@]} -gt 0 ]]; then printf '%s\n' "${DOING_ORPHANS[@]}"; fi
    if [[ $A -eq 0 && ${#DOING_ORPHANS[@]} -eq 0 ]]; then printf '_(none)_\n'; fi

    printf '\n## TODO\n\n'
    if [[ $B -gt 0 ]]; then _emit_bucket ' ' TODO; fi
    if [[ ${#TODO_ORPHANS[@]} -gt 0 ]]; then printf '%s\n' "${TODO_ORPHANS[@]}"; fi
    if [[ $B -eq 0 && ${#TODO_ORPHANS[@]} -eq 0 ]]; then printf '_(none)_\n'; fi

    printf '\n## DONE:%s\n\n' "$WATERMARK"
    if [[ $C -gt 0 ]]; then _emit_bucket 'x' DONE; fi
    if [[ ${#DONE_ORPHANS[@]} -gt 0 ]]; then printf '%s\n' "${DONE_ORPHANS[@]}"; fi
    if [[ $C -eq 0 && ${#DONE_ORPHANS[@]} -eq 0 ]]; then printf '_(none)_\n'; fi
  } >"$tmp"
  mv "$tmp" "$TODO_FILE"
}

# ============================================================================
# ITEM ADDRESSING + MOVES
# ============================================================================

# Resolve an item id to SRC_BUCKET + SRC_IDX (0-based within its bucket): the
# item that CARRIES the id, wherever it sits (issue 0033).
_resolve_n() {
  local n="$1" b count i id
  [[ "$n" =~ ^[0-9]+$ ]] || return 1
  # Ids are rendered zero-padded ("08"), so force base 10: bash arithmetic
  # would otherwise read a leading zero as octal and reject 08 and 09.
  n=$((10#$n))
  for b in DOING TODO DONE; do
    eval "count=\${#${b}_IDS[@]}"
    for ((i = 0; i < count; i++)); do
      eval "id=\${${b}_IDS[$i]}"
      if [[ "$id" == "$n" ]]; then
        SRC_BUCKET="$b"
        SRC_IDX=$i
        return 0
      fi
    done
  done
  return 1
}

# Remove element <idx0> from the named array, setting SPLICED to its value.
_splice_out() {
  local __name="$1" __idx="$2" __n __i
  eval "__n=\${#${__name}[@]}"
  local -a __new=()
  for ((__i = 0; __i < __n; __i++)); do
    if [[ $__i -eq $__idx ]]; then
      eval "SPLICED=\"\${${__name}[$__i]}\""
    else
      eval "__new+=(\"\${${__name}[$__i]}\")"
    fi
  done
  if [[ ${#__new[@]} -gt 0 ]]; then
    eval "${__name}=(\"\${__new[@]}\")"
  else
    eval "${__name}=()"
  fi
}

# Add an item -- its text and its id -- to a bucket at top or bottom.
_add_to() {
  local b="$1" pos="$2" t="$3" id="$4"
  case "$b:$pos" in
  DOING:top)
    DOING_ITEMS=("$t" "${DOING_ITEMS[@]+"${DOING_ITEMS[@]}"}")
    DOING_IDS=("$id" "${DOING_IDS[@]+"${DOING_IDS[@]}"}")
    ;;
  DOING:bottom)
    DOING_ITEMS=("${DOING_ITEMS[@]+"${DOING_ITEMS[@]}"}" "$t")
    DOING_IDS=("${DOING_IDS[@]+"${DOING_IDS[@]}"}" "$id")
    ;;
  TODO:top)
    TODO_ITEMS=("$t" "${TODO_ITEMS[@]+"${TODO_ITEMS[@]}"}")
    TODO_IDS=("$id" "${TODO_IDS[@]+"${TODO_IDS[@]}"}")
    ;;
  TODO:bottom)
    TODO_ITEMS=("${TODO_ITEMS[@]+"${TODO_ITEMS[@]}"}" "$t")
    TODO_IDS=("${TODO_IDS[@]+"${TODO_IDS[@]}"}" "$id")
    ;;
  DONE:top)
    DONE_ITEMS=("$t" "${DONE_ITEMS[@]+"${DONE_ITEMS[@]}"}")
    DONE_IDS=("$id" "${DONE_IDS[@]+"${DONE_IDS[@]}"}")
    ;;
  DONE:bottom)
    DONE_ITEMS=("${DONE_ITEMS[@]+"${DONE_ITEMS[@]}"}" "$t")
    DONE_IDS=("${DONE_IDS[@]+"${DONE_IDS[@]}"}" "$id")
    ;;
  esac
}

# Move item <n> to <dest> bucket at <pos>. Errors (non-zero exit) on bad number.
move_item() {
  local dest="$1" pos="$2" n="$3"
  if ! _resolve_n "$n"; then
    error "todo: no item numbered '$n'"
    exit 1
  fi
  # The id leaves with the item and arrives with it (issue 0033).
  _splice_out "${SRC_BUCKET}_IDS" "$SRC_IDX"
  SPLICED_ID="$SPLICED"
  _splice_out "${SRC_BUCKET}_ITEMS" "$SRC_IDX"
  _add_to "$dest" "$pos" "$SPLICED" "$SPLICED_ID"
}

# ============================================================================
# FILE RESOLUTION
# ============================================================================

_global_todo_path() {
  printf '%s/utilz/todo/todo.md' "${XDG_CONFIG_HOME:-$HOME/.config}"
}

# ============================================================================
# HISTORY (prune)
# ============================================================================

# Expand the frontmatter `history:` pattern to an absolute path: YYYYMMDD ->
# today (UTC), resolved relative to the todo.md directory when not absolute.
_resolve_history() {
  local pat="$HISTORY" day dir
  day=$(date -u +%Y%m%d)
  pat="${pat//YYYYMMDD/$day}"
  if [[ "$pat" == /* ]]; then
    printf '%s' "$pat"
  else
    dir=$(cd "$(dirname "$TODO_FILE")" && pwd)
    printf '%s/%s' "$dir" "$pat"
  fi
}

# Prepend a block of text to a file (newest batch on top).
_prepend_file() {
  local f="$1" block="$2" tmp
  tmp=$(mktemp)
  printf '%s\n' "$block" >"$tmp"
  if [[ -s "$f" ]]; then
    printf '\n' >>"$tmp"
    cat "$f" >>"$tmp"
  fi
  mv "$tmp" "$f"
}

# ============================================================================
# COMMANDS
# ============================================================================

cmd_list() {
  if [[ "${JSON:-0}" -eq 1 ]]; then
    cmd_json
    return
  fi
  if [[ ! -f "$TODO_FILE" ]]; then
    parse_file
    write_file
  fi
  cat "$TODO_FILE"
}

cmd_add() {
  local pos="bottom"
  if [[ "${1:-}" == "--top" ]]; then pos="top"; shift; fi
  local text="$*"
  if [[ -z "$text" ]]; then
    error "todo add: item text required"
    exit 1
  fi
  parse_file
  # A new item takes the next id never used in this file (issue 0033).
  local id="$NEXT_ID"
  NEXT_ID=$((NEXT_ID + 1))
  _add_to "TODO" "$pos" "$text" "$id"
  write_file
  info "added $(printf '%0*d' "$WIDTH" "$id"): $text"
}

cmd_start() {
  local pos="bottom"
  if [[ "${1:-}" == "--top" ]]; then pos="top"; shift; fi
  local n="${1:-}"
  if [[ -z "$n" ]]; then
    error "todo start: item number required"
    exit 1
  fi
  parse_file
  move_item "DOING" "$pos" "$n"
  write_file
}

cmd_done_n() {
  local n="$1"
  parse_file
  move_item "DONE" "top" "$n"
  write_file
}

cmd_notdone() {
  local n="${1:-}"
  if [[ -z "$n" ]]; then
    error "todo notdone: item number required"
    exit 1
  fi
  parse_file
  move_item "TODO" "bottom" "$n"
  write_file
}

cmd_toggle() {
  local n="${1:-}"
  if [[ -z "$n" ]]; then
    error "todo toggle: item number required"
    exit 1
  fi
  parse_file
  if ! _resolve_n "$n"; then
    error "todo: no item numbered '$n'"
    exit 1
  fi
  if [[ "$SRC_BUCKET" == "DONE" ]]; then
    move_item "TODO" "bottom" "$n"
  else
    move_item "DONE" "top" "$n"
  fi
  write_file
}

# Print the items of one bucket, with their ids.
cmd_print_bucket() {
  local bucket="$1"
  parse_file
  _counts
  case "$bucket" in
  DOING) if [[ $A -gt 0 ]]; then _emit_bucket '-' DOING; fi ;;
  TODO) if [[ $B -gt 0 ]]; then _emit_bucket ' ' TODO; fi ;;
  DONE) if [[ $C -gt 0 ]]; then _emit_bucket 'x' DONE; fi ;;
  esac
}

# Print the next <n> open items (DOING first, then TODO).
cmd_next() {
  local n="${1:-1}"
  # Base 10 before the compare, for the reason _resolve_n does it: a leading
  # zero reads as octal, and "08" is what a caller copying an id would pass.
  # `||` short-circuits, so the arithmetic only runs once the regex has passed.
  if [[ ! "$n" =~ ^[0-9]+$ ]] || ((10#$n < 1)); then
    error "todo next: count must be a positive integer"
    exit 1
  fi
  n=$((10#$n))
  parse_file
  _counts
  local count=0 line
  while IFS= read -r line; do
    printf '%s\n' "$line"
    count=$((count + 1))
    if [[ $count -ge $n ]]; then break; fi
  done < <(
    if [[ $A -gt 0 ]]; then _emit_bucket '-' DOING; fi
    if [[ $B -gt 0 ]]; then _emit_bucket ' ' TODO; fi
  )
}

cmd_count() {
  parse_file
  _counts
  printf 'DOING %d\n' "$A"
  printf 'TODO  %d\n' "$B"
  printf 'DONE  %d\n' "$C"
}

cmd_sync() {
  parse_file
  write_file
  info "synced: $TODO_FILE"
}

cmd_edit() {
  if [[ ! -f "$TODO_FILE" ]]; then
    parse_file
    write_file
  fi
  guard_foreign_todo   # refuse before launching $EDITOR on a foreign file
  local ed="${VISUAL:-${EDITOR:-vi}}"
  local edcmd="${ed%% *}"
  if ! command -v "$edcmd" >/dev/null 2>&1; then
    error "todo edit: no usable editor ('$ed'); set \$VISUAL or \$EDITOR"
    exit 1
  fi
  # shellcheck disable=SC2086  # $ed may carry args; intentional word split
  $ed "$TODO_FILE"
  cmd_sync
}

cmd_prune() {
  parse_file
  guard_foreign_todo   # refuse before the pre-write history archive (No partial mutation)
  _counts
  if [[ $C -eq 0 ]]; then
    info "todo: nothing to prune"
    return 0
  fi
  local hist block i line
  hist=$(_resolve_history)
  mkdir -p "$(dirname "$hist")"
  block=""
  # Each archived item keeps its id, so a citation of it can still be found
  # (issue 0033).
  for ((i = 0; i < C; i++)); do
    # shellcheck disable=SC2016  # literal markdown backticks, as in _emit_bucket
    printf -v line '[x] `%0*d` %s' "$WIDTH" "${DONE_IDS[$i]}" "${DONE_ITEMS[$i]}"
    block+="$line"$'\n'
  done
  # Strip the trailing newline the loop appended (block is passed to printf %s\n)
  block="${block%$'\n'}"
  _prepend_file "$hist" "$block"
  # THE COUNT IS TAKEN BEFORE DONE IS CLEARED (issue 0034): write_file
  # recounts the buckets, so C is 0 by the time it returns, and this report
  # read it there for as long as the command existed.
  local pruned=$C
  DONE_ITEMS=(); DONE_IDS=()
  WATERMARK="$(_now_iso)"
  write_file
  info "todo: pruned $pruned item(s) to $hist"
}

cmd_flush() {
  local force="$1"
  parse_file
  _counts
  if [[ $C -eq 0 ]]; then
    info "todo: nothing to flush"
    return 0
  fi
  if [[ "$force" -ne 1 ]]; then
    printf 'Discard %d done item(s) WITHOUT archiving? [y/N] ' "$C" >&2
    local reply=""
    if ! read -r reply; then reply=""; fi
    case "$reply" in
    y | Y | yes | YES) : ;;
    *)
      info "todo: flush aborted"
      return 0
      ;;
    esac
  fi
  DONE_ITEMS=(); DONE_IDS=()
  WATERMARK="$(_now_iso)"
  write_file
  info "todo: flushed done items (not archived)"
}

# JSON array of {num, text} for a bucket, num being each item's id: <BUCKET>
_bucket_json() {
  local b="$1" out="[]" n i t id
  eval "n=\${#${b}_ITEMS[@]}"
  for ((i = 0; i < n; i++)); do
    eval "t=\${${b}_ITEMS[$i]}; id=\${${b}_IDS[$i]}"
    out=$(printf '%s' "$out" | jq --argjson n "$id" --arg t "$t" '. + [{num: $n, text: $t}]')
  done
  printf '%s' "$out"
}

cmd_json() {
  require_command "jq" "brew install jq" || exit 1
  parse_file
  _counts
  local dj tj cj
  dj=$(_bucket_json DOING)
  tj=$(_bucket_json TODO)
  cj=$(_bucket_json DONE)
  jq -n \
    --arg title "$TITLE" \
    --argjson doing "$dj" \
    --argjson todo "$tj" \
    --argjson 'done' "$cj" \
    --arg wm "$WATERMARK" \
    '{title: $title, doing: $doing, todo: $todo, done: $done, done_watermark: $wm}'
}

# ============================================================================
# USAGE
# ============================================================================

usage() {
  cat <<'EOF'
Usage: todo [OPTIONS] [COMMAND] [ARGS]

Simple DOING/TODO/DONE manager for a plain-text todo.md.

COMMANDS:
  (none), list          Show the todo file (creates it from a template if absent)
  add [--top] <text>    Add an item to TODO (bottom by default, top with --top)
  start [--top] <id>    Move item <id> to DOING
  done <id>             Move item <id> to DONE (newest at the top)
  notdone <id>          Move item <id> back to TODO
  toggle <id>           Flip item <id> between done and not-done
  next [n]              Show the next n open items (DOING first, then TODO); n=1
  doing | todo | done   Show a single bucket
  count                 Show item counts per bucket
  sync (alias update)   Normalize the file: reconcile checkboxes, give an id to
                        any line that has none
  edit                  Open the file in $VISUAL/$EDITOR/vi, then sync
  done --prune          Archive DONE to the history file, then clear it
  done --flush          Clear DONE WITHOUT archiving (use --force to skip prompt)
  help                  Show this help

OPTIONS:
  --file <path>         Operate on <path> instead of ./todo.md
  -g, --global          Operate on ~/.config/utilz/todo/todo.md
  --title <text>        Set the H1 title when creating a new file
  --json                Emit the view as JSON (with list / no command)
  -h, --help            Show this help
  --version             Show version

CHECKBOX LEGEND:  [ ] todo   [-] doing   [x] done
IDS:              an item keeps its id through every write, and a new one takes
                  the next id this file has never used (its next-id key)

For detailed help, run: utilz help todo
EOF
}

# ============================================================================
# MAIN (thin coordinator: parse args -> resolve file -> dispatch)
# ============================================================================

FILE_OPT=""
USE_GLOBAL=0
JSON=0
TITLE_OPT=""
DEFAULT_PATH=0
ARGS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
  --file)
    FILE_OPT="${2:-}"
    if [[ -z "$FILE_OPT" ]]; then error "--file requires a path"; exit 1; fi
    shift 2
    ;;
  --file=*) FILE_OPT="${1#--file=}"; shift ;;
  -g | --global) USE_GLOBAL=1; shift ;;
  --json) JSON=1; shift ;;
  --title)
    TITLE_OPT="${2:-}"
    if [[ -z "$TITLE_OPT" ]]; then error "--title requires text"; exit 1; fi
    shift 2
    ;;
  --title=*) TITLE_OPT="${1#--title=}"; shift ;;
  -h | --help) usage; exit 0 ;;
  *) ARGS+=("$1"); shift ;;
  esac
done

if [[ -n "$FILE_OPT" && $USE_GLOBAL -eq 1 ]]; then
  error "--file and -g/--global are mutually exclusive"
  exit 1
fi

if [[ -n "$FILE_OPT" ]]; then
  TODO_FILE="$FILE_OPT"
elif [[ $USE_GLOBAL -eq 1 ]]; then
  TODO_FILE="$(_global_todo_path)"
  mkdir -p "$(dirname "$TODO_FILE")"
else
  TODO_FILE="./todo.md"
  DEFAULT_PATH=1
fi

COMMAND="${ARGS[0]:-list}"
REST=()
if [[ ${#ARGS[@]} -gt 1 ]]; then REST=("${ARGS[@]:1}"); fi

case "$COMMAND" in
list) cmd_list ;;
add) cmd_add "${REST[@]+"${REST[@]}"}" ;;
start) cmd_start "${REST[@]+"${REST[@]}"}" ;;
notdone) cmd_notdone "${REST[0]:-}" ;;
toggle) cmd_toggle "${REST[0]:-}" ;;
next) cmd_next "${REST[0]:-1}" ;;
doing) cmd_print_bucket "DOING" ;;
todo) cmd_print_bucket "TODO" ;;
count) cmd_count ;;
sync | update) cmd_sync ;;
edit) cmd_edit ;;
done)
  case "${REST[0]:-}" in
  --flush)
    force=0
    if [[ ${#REST[@]} -gt 1 ]]; then
      for a in "${REST[@]:1}"; do
        case "$a" in
        --force | --just-do-it) force=1 ;;
        esac
      done
    fi
    cmd_flush "$force"
    ;;
  --prune) cmd_prune ;;
  "") cmd_print_bucket "DONE" ;;
  --*)
    error "todo done: unknown option '${REST[0]}'"
    exit 1
    ;;
  *) cmd_done_n "${REST[0]}" ;;
  esac
  ;;
help) usage ;;
*)
  error "Unknown command: $COMMAND"
  echo "" >&2
  usage >&2
  exit 1
  ;;
esac

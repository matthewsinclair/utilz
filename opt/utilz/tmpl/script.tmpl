#!/usr/bin/env bash
#
# {{NAME}} - {{DESCRIPTION}}
#

set -euo pipefail

# Source common functions if not already loaded (from dispatcher)
if [[ "$(type -t info 2>/dev/null)" != "function" ]]; then
  SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  UTILZ_HOME="${UTILZ_HOME:-$(cd "$SCRIPT_DIR/../.." && pwd)}"

  if [[ -f "$UTILZ_HOME/opt/utilz/lib/common.sh" ]]; then
    source "$UTILZ_HOME/opt/utilz/lib/common.sh"
  else
    echo "ERROR: Cannot find common.sh library" >&2
    exit 1
  fi
fi

# ============================================================================
# USAGE
# ============================================================================

usage() {
  cat <<EOF
Usage: {{NAME}} [OPTIONS] [ARGS]

{{DESCRIPTION}}

OPTIONS:
  -h, --help               Show this help
  --version                Show version

EXAMPLES:
  {{NAME}} --help
  {{NAME}} --version

For detailed help, run: utilz help {{NAME}}
EOF
}

# ============================================================================
# MAIN
# ============================================================================

# Parse arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    # NO --version ARM HERE, DELIBERATELY. `bin/utilz` answers --version for
    # every utility on both invocation forms (common.sh version_intercept),
    # so an arm here would be unreachable -- and it would reintroduce, one
    # generated utility at a time, exactly the fifteen-home duplication
    # ST0015 removed. If you add one, `utilz <name> --version` and
    # `<name> --version` can drift apart again.
    *)
      error "Unknown option: $1"
      echo ""
      usage
      exit 1
      ;;
  esac
done

# Your implementation here
info "{{NAME}} is working!"
success "Implementation goes here"

#!/usr/bin/env bash
#
# prez - Markdown to a self-contained HTML presentation
#
# THIS FILE IS A SHIM, NOT THE TOOL. The tool is a Rust crate under crate/,
# and this resolves it, builds it when it is missing or stale, and execs it.
#
# Why a shim rather than the binary at opt/prez/prez, which the dispatcher
# would happily exec: one committed binary cannot serve Ubuntu CI and macOS
# both, and a repo that is cloned-and-symlinked has nowhere to ship per-platform
# artifacts. So the binary is BUILT on this machine and this file is the thing
# that is portable. It also keeps opt/prez/prez inside the shellcheck gate and
# inside doctor's existing model, both of which assume a script.
#
# The precedent is ensure_venv() in common.sh: an interpreted-runtime wrapper
# that provisions on first use, loudly. Same shape, different runtime.
#

set -euo pipefail

# Source common functions if not already loaded (from dispatcher)
if [[ "$(type -t info 2>/dev/null)" != "function" ]]; then
  SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  UTILZ_HOME="${UTILZ_HOME:-$(cd "$SCRIPT_DIR/../.." && pwd)}"

  if [[ -f "$UTILZ_HOME/opt/utilz/lib/common.sh" ]]; then
    source "$UTILZ_HOME/opt/utilz/lib/common.sh"
  else
    echo "ERROR: Cannot find common.sh library" >&2
    exit 1
  fi
fi

# ============================================================================
# CONFIGURATION
# ============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CRATE_DIR="$SCRIPT_DIR/crate"
MANIFEST="$CRATE_DIR/Cargo.toml"

# THE INSTALL BRANCH, AND IT IS EXPLICIT ON PURPOSE (AC09, ST0014 design.md D5).
#
# An install SHIPS the built binary and never builds one. The discriminator is
# the manifest at the shim's OWN tree root -- not $UTILZ_HOME, which may have
# been inherited and may name a different tree entirely.
#
# It has to be an explicit branch rather than an emergent one. Without it the
# shim still refuses, and it refuses for the wrong reason: with no crate
# shipped, prez_is_stale's `find` errors on every path, `2>/dev/null || true`
# swallows the error, the empty result reads as "not stale", and the shim execs
# the binary. It works, and it works by a suppressed error standing in for a
# decision -- which passes until someone tidies the suppression away, and then
# a fresh install tries to cargo build a crate that is not there.
PREZ_TREE_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
PREZ_INSTALL_MODE=0

if [[ -f "$PREZ_TREE_ROOT/$UTILZ_MANIFEST_NAME" ]]; then
  PREZ_INSTALL_MODE=1
fi

# CARGO_TARGET_DIR IS HONOURED IN A SOURCE TREE AND IGNORED IN AN INSTALL, and
# neither half is politeness.
#
# Honouring it is the only thing that makes "build this cold, in isolation" a
# lever that works. The first cut hardcoded $CRATE_DIR/target. cargo honours the
# variable and the shim did not, so the two disagreed about where the binary
# lives: a caller who set it got their build directed into their chosen
# directory while the shim went on resolving, freshness-checking and exec'ing
# the WARM one in the crate. Measured -- CARGO_TARGET_DIR pointed at an empty
# temp dir, `prez build` wrote a correct artifact, and that directory stayed
# EMPTY. Nothing failed and nothing said the isolation had been ignored.
#
# That is the shape AC17 exists to catch: _tools lost the same afternoon to it,
# where devbin exported CARGO_TARGET_DIR unconditionally, their "cold" build ran
# against the warm shared cache in 0.05s, and exit 0 laundered a stale binary
# into a verified one. Same defect, opposite cause, identical symptom -- a cold
# build that reports success having built nothing.
#
# test/acceptance.sh already resolved it this way, so the hardcode was also two
# answers to one question with only one of them right.
#
# IGNORING it in an install is the same argument from the other side. An install
# resolves its binary at a path fixed at publish time and has no crate to build,
# so a caller who happens to carry the variable in their shell would send the
# install looking somewhere it never wrote -- and the shim would then report a
# missing binary in a tree that shipped one.
if [[ $PREZ_INSTALL_MODE -eq 1 ]]; then
  TARGET_DIR="$CRATE_DIR/target"
else
  TARGET_DIR="${CARGO_TARGET_DIR:-$CRATE_DIR/target}"
fi
BINARY="$TARGET_DIR/release/prez"

# ============================================================================
# BUILD MANAGEMENT
# ============================================================================

# Is the built binary older than anything it was built from?
#
# **THE POPULATION IS DERIVED FROM THE TREE, NOT TYPED OUT, AND THAT IS THE
# WHOLE OF THE FIX.** This walk listed src/, themes/ and assets/ by hand until
# 2026-09-09, and the comment that stood here explained WHY the last two were
# added: theme.rs and mermaid.rs embed them with include_str! at COMPILE time,
# so editing a theme.css changes the binary and touching nothing else, and a
# check watching only src/ "would report a stale binary as current, which is
# the silent-wrong-answer shape rather than a missing feature."
#
# **THEN crates/ ARRIVED IN THE WORKSPACE AND NOBODY EXTENDED THE WALK.** The
# code committed the defect its own comment describes, one directory on.
# Measured 2026-09-09: touching crates/artifact/src/theme.rs -- the shared crate
# prez LINKS -- left this function returning false and the shim exec'ing the old
# binary at exit 0. A hand list is correct on the day it is written and silently
# wrong afterwards, so the list is gone.
#
# **WALKING WIDE OVER-INCLUDES, DELIBERATELY.** An edit to test/ now triggers a
# rebuild nobody needed. That is the trade and it is the right way round:
# over-inclusion fails LOUDLY and costs one rebuild, under-inclusion fails
# GREENLY and ships an old binary. Ruled by vc 2026-09-09.
#
# target/ must be pruned for CORRECTNESS, not tidiness -- $BINARY lives in it and
# its directories are newer than itself on every build, so an unpruned walk
# reports stale forever. **That exclusion does NOT generalise to the shellcheck
# collector**, which has a working type check behind it; two exclusions that look
# like one rule is the near-agreement that suppresses the check.
#
# NO `-type f`, and `-mindepth 1`, BOTH MEASURED RATHER THAN REASONED. `-type f`
# was the first cut and it MISSES A PURE DELETION -- removing a source bumps its
# directory and creates no new file, so the walk saw nothing. Dropping it then
# made the walk match $CRATE_DIR ITSELF, which the acceptance fixture creates at
# now: `an up-to-date binary is not stale` went red, and the real tree had passed
# only because its crate directory happens to be older than the binary. The
# fixture caught what the real-tree control could not.
#
# `find -newer` rather than comparing mtimes arithmetically: bash 3.2 has no
# portable stat, and BSD and GNU stat disagree on flags.
prez_is_stale() {
  [[ ! -x "$BINARY" ]] && return 0

  local newer
  newer=$(find "$CRATE_DIR" -mindepth 1 \
    -name target -prune -o \
    -newer "$BINARY" -print -quit 2>/dev/null || true)

  [[ -n "$newer" ]]
}

# Build the crate, or refuse by name.
#
# The refusal comes BEFORE any build attempt so a missing toolchain is a named
# finding with a remedy, never a bare `cargo: command not found` from inside a
# subshell three frames down.
prez_ensure_built() {
  # AC09: an install refuses rather than falling back to a build. It ships the
  # binary, has no crate, and reaching for cargo here would be reaching for a
  # toolchain to compile source that was deliberately not published.
  if [[ $PREZ_INSTALL_MODE -eq 1 ]]; then
    if [[ -x "$BINARY" ]]; then
      return 0
    fi
    error "prez: the installed binary is missing"
    echo "" >&2
    echo "  Expected: $BINARY" >&2
    echo "" >&2
    echo "  This tree is an install, which SHIPS the built binary and never" >&2
    echo "  builds one -- it carries no crate to build from. Re-publish from" >&2
    echo "  the Utilz source tree with 'utilz upgrade'." >&2
    return 1
  fi

  if ! prez_is_stale; then
    return 0
  fi

  require_command "cargo" "brew install rust" || return 1

  if [[ -x "$BINARY" ]]; then
    info "prez: sources changed, rebuilding..."
  else
    info "prez: first use, building (this happens once)..."
  fi

  # --workspace, because the default builds only the ROOT package: without it
  # the shim's build-on-first-use can never produce a member crate's binary at
  # all. AC-1.16's sixth site; it stops being latent the moment WP-05 wires the
  # showreel dispatch.
  if ! cargo build --release --workspace --manifest-path "$MANIFEST"; then
    error "prez: build failed"
    return 1
  fi

  success "prez: built"
}

# ============================================================================
# MAIN
# ============================================================================

# Thin Coordinator: resolve, ensure, exec. This shim decides NOTHING about
# presentations -- no argument parsing, no defaults, no pass-through filtering.
# Every flag, every verb and every refusal belongs to the tool, so `prez --help`
# is the tool's help and not a second copy that can drift from it.
#
# There is deliberately no `prez build-self` verb: `prez build <deck>` already
# means "build the deck" in the tool's own grammar, and minting a colliding
# verb to expose something the shim does automatically would be a worse trade
# than provisioning on use.
prez_ensure_built || exit 1

exec "$BINARY" "$@"
